---
import BrandMark from "./BrandMark.astro";
import { site } from "../site";

const cols = [
  {
    h: "Product",
    items: [
      { l: "Quickstart",     href: "/quickstart" },
      { l: "Docs",           href: "/docs" },
      { l: "Pricing",        href: "/pricing" },
    ],
  },
  {
    h: "Source",
    items: [
      { l: "GitHub repo",         href: site.repo, external: true },
      { l: "deploy/",             href: site.deployDocs, external: true },
      { l: "e2e test harness",    href: `${site.repo}/blob/master/e2e/run.sh`, external: true },
      { l: "MIT license",         href: site.license, external: true },
    ],
  },
  {
    h: "Get started",
    items: [
      { l: "Sign up free",        href: site.signupFree, external: true },
      { l: "Talk to us (Pro)",    href: site.proContact, external: false },
      { l: "Open an issue",       href: site.issues, external: true },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <div class="foot-brand">
          <BrandMark />
          <span>{site.productName}</span>
        </div>
        <p class="foot-tag">
          Open-source WireGuard mesh controller. Multi-tenant, kernel-level
          ACLs, self-hosted or hosted by us.
        </p>
      </div>

      {cols.map((col) => (
        <div>
          <h5 class="col-h">{col.h}</h5>
          <ul class="col-list">
            {col.items.map((it) => (
              <li>
                <a
                  href={it.href}
                  target={it.external ? "_blank" : undefined}
                  rel={it.external ? "noopener" : undefined}
                >
                  {it.l}{it.external ? " ↗" : ""}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="foot-bot">
      <div>© {year} {site.productName} contributors · MIT licensed</div>
      <div>WireGuard is a registered trademark of Jason A. Donenfeld.</div>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 64px 0 48px;
    color: var(--text-3);
    font-size: 13px;
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 40px;
  }
  .foot-brand {
    display: flex; align-items: center; gap: 10px;
    font-weight: 500;
    color: var(--text);
    font-size: 15px;
    margin-bottom: 14px;
  }
  .foot-tag {
    max-width: 320px;
    margin: 0;
    color: var(--text-3);
    line-height: 1.55;
    font-size: 13px;
  }

  .col-h {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--text-3);
    font-weight: 500;
    margin: 0 0 14px;
  }
  .col-list {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 10px;
  }
  .col-list a {
    transition: color .12s ease;
  }
  .col-list a:hover { color: var(--text); }

  .foot-bot {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 12px;
    color: var(--text-4);
  }

  @media (max-width: 980px) {
    .foot-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
  }
</style>
