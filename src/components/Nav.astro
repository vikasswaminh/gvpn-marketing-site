---
import BrandMark from "./BrandMark.astro";
import { site } from "../site";
---
<div class="announcement">
  <div class="wrap announcement-inner">
    <span class="announcement-text">
      <span class="badge">NEW</span>
      Self-serve signup is live. Free for 2 machines, forever. ₹349/machine/month after.
    </span>
    <a href="/pricing" class="announcement-link">See pricing &rarr;</a>
  </div>
</div>

<nav class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/">
      <BrandMark />
      <span class="brand-name">{site.productName}</span>
    </a>
    <div class="nav-links">
      <a href="/quickstart">Quickstart</a>
      <a href="/docs">Docs</a>
      <a href="/compatibility">Compatibility</a>
      <a href="/blog">Blog</a>
      <a href="/pricing">Pricing</a>
    </div>
    <div class="nav-spacer"></div>
    <div class="nav-cta">
      <a class="btn btn-ghost" href={site.signIn}>Sign in</a>
      <a class="btn btn-primary" href={site.signupFree}>Sign up free</a>
    </div>
  </div>
</nav>

<style>
  .announcement {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 101;
    background: var(--brand-red);
    color: #ffffff;
    height: 40px;
  }
  .announcement-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13.5px;
    font-weight: 500;
  }
  .announcement-text {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .announcement .badge {
    background: #ffffff;
    color: var(--brand-red);
    font: 700 10.5px/1 var(--font-sans);
    padding: 3px 6px;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .announcement-link {
    color: #ffffff;
    font-weight: 600;
    transition: opacity 0.15s ease;
  }
  .announcement-link:hover {
    opacity: 0.8;
  }
  @media (max-width: 980px) {
    .announcement { display: none; }
  }

  /* Fixed nav. Top-of-page: nearly transparent; on scroll past 60 px the
     IntersectionObserver in Base.astro adds .nav--scrolled and the bar
     becomes frosted white with a subtle hairline border. */
  .nav {
    position: fixed;
    top: 40px; left: 0; right: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.6);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
            backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-bottom-color 0.25s ease, background 0.25s ease;
  }
  @media (max-width: 980px) {
    .nav { top: 0; }
  }
  
  .nav--scrolled {
    background: rgba(255, 255, 255, 0.75);
    border-bottom-color: var(--border);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .nav-inner {
    height: 64px;
    display: flex;
    align-items: center;
    gap: 36px;
  }

  .brand {
    display: flex; align-items: center; gap: 10px;
    font-weight: 500;
    letter-spacing: -0.005em;
    font-size: 15px;
    color: var(--text);
  }
  .brand-name { color: var(--text); }

  .nav-links {
    display: flex;
    gap: 26px;
    font-size: 13px;
    color: var(--text-2);
  }
  .nav-links a {
    position: relative;
    padding: 4px 0;
    transition: color 0.15s ease;
  }
  .nav-links a::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s cubic-bezier(0.6, 0.05, 0.2, 1);
  }
  .nav-links a:hover { color: var(--text); }
  .nav-links a:hover::after { transform: scaleX(1); }

  .nav-spacer { flex: 1; }
  .nav-cta { display: flex; gap: 6px; align-items: center; }

  @media (max-width: 980px) {
    .nav-links { display: none; }
    .nav-inner { gap: 16px; }
    .nav-cta .btn-ghost { display: none; }
  }
</style>
