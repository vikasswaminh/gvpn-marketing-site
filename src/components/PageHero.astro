---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<header class="page-hero">
  <div class="wrap">
    <div class="ph-eyebrow">{eyebrow}</div>
    <h1 class="ph-h">{title}</h1>
    {lede && <p class="ph-lede">{lede}</p>}
  </div>
</header>

<style>
  .page-hero {
    padding: 80px 0 56px;
    border-bottom: 1px solid var(--border);
  }
  .ph-eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .ph-h {
    font-size: 48px;
    line-height: 1.08;
    letter-spacing: -.024em;
    font-weight: 500;
    margin: 0 0 16px;
    max-width: 820px;
    text-wrap: balance;
  }
  .ph-lede {
    color: var(--text-2);
    font-size: 17px;
    max-width: 680px;
    line-height: 1.6;
    margin: 0;
    text-wrap: pretty;
  }

  @media (max-width: 980px) {
    .page-hero { padding: 48px 0 32px; }
    .ph-h { font-size: 32px; }
  }
</style>
