---
// Six families that ship native WireGuard. No commercial partnership
// claim — the test is simply "does this device speak wg-quick".
const vendors = [
  { tag: "TP", name: "TP-Link",   sub: "Archer · Deco · ER",      color: "#4ACBD6" },
  { tag: "MT", name: "MikroTik",  sub: "RouterOS 7+",             color: "#293239" },
  { tag: "OW", name: "OpenWrt",   sub: "19.07+",                  color: "#F08000" },
  { tag: "UI", name: "Ubiquiti",  sub: "UDM · EdgeRouter",        color: "#0559C9" },
  { tag: "OP", name: "OPNsense",  sub: "pfSense too",             color: "#D94F00" },
  { tag: "WG", name: "Linux/Mac/Win", sub: "Official WireGuard apps",  color: "#0a0a0a" },
];
---
<section class="vendor-section">
  <div class="wrap">
    <div class="lbl-row">
      <div class="lbl">If it runs WireGuard, it works with MeshWG</div>
      <a class="see-all" href="/compatibility">View all 57 supported routers →</a>
    </div>
    <div class="vendor-row">
      {vendors.map((v) => (
        <div class="vendor-tile">
          <span class="vlogo" style={`background:${v.color}`}>{v.tag}</span>
          <div>
            <div class="vname">{v.name}</div>
            <div class="vsub">{v.sub}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .vendor-section {
    padding: 56px 0 96px;
  }
  .lbl-row {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }
  .lbl {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--text-3);
  }
  .see-all {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--accent);
    letter-spacing: .02em;
    transition: color .12s ease;
  }
  .see-all:hover { color: var(--accent-strong); }
  .vendor-row {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
    align-items: center;
  }
  .vendor-tile {
    display: flex; align-items: center; gap: 12px;
    padding: 16px 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color .15s ease;
  }
  .vendor-tile:hover { border-color: var(--border-strong); }

  .vlogo {
    width: 30px; height: 30px;
    border-radius: var(--radius-sm);
    display: grid; place-items: center;
    color: #fff;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 10.5px;
    letter-spacing: .04em;
    flex-shrink: 0;
  }
  .vname { font-size: 13.5px; font-weight: 500; color: var(--text); }
  .vsub  {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-3);
    margin-top: 2px;
  }

  @media (max-width: 980px) {
    .vendor-section { padding: 32px 0 56px; }
    .vendor-row { grid-template-columns: repeat(2, 1fr); }
  }
</style>
