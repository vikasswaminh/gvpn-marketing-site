---
import Base       from "../../layouts/Base.astro";
import Nav        from "../../components/Nav.astro";
import PageHero   from "../../components/PageHero.astro";
import ValueStrip from "../../components/ValueStrip.astro";
import Footer     from "../../components/Footer.astro";

const title = "VPN and ZTNA Comparisons: Deep Dives and Architecture Reviews";
const description = "Detailed technical comparisons of WireGuard, Tailscale, ZeroTier, OpenVPN, Cloudflare Tunnel, NetBird, and more.";
const canonical = "https://meshwg.com/compare/";

const comparisons = [
  { title: "Cloudflare Tunnel vs ngrok", url: "/compare/cloudflare-tunnel-vs-ngrok/" },
  { title: "NetBird vs Headscale", url: "/compare/netbird-vs-headscale/" },
  { title: "OpenWrt vs MikroTik WireGuard", url: "/compare/openwrt-vs-mikrotik-wireguard/" },
  { title: "OPNsense vs pfSense WireGuard", url: "/compare/opnsense-vs-pfsense-wireguard/" },
  { title: "Tailscale vs Cloudflare Tunnel", url: "/compare/tailscale-vs-cloudflare-tunnel/" },
  { title: "Tailscale vs Headscale", url: "/compare/tailscale-vs-headscale/" },
  { title: "Tailscale vs NetBird", url: "/compare/tailscale-vs-netbird/" },
  { title: "Tailscale vs Twingate", url: "/compare/tailscale-vs-twingate/" },
  { title: "Tailscale vs WireGuard", url: "/compare/tailscale-vs-wireguard/" },
  { title: "Tailscale vs ZeroTier", url: "/compare/tailscale-vs-zerotier/" },
  { title: "Twingate vs Cloudflare Zero Trust", url: "/compare/twingate-vs-cloudflare/" },
  { title: "Twingate vs NetBird", url: "/compare/twingate-vs-netbird/" },
  { title: "WireGuard vs OpenVPN", url: "/compare/wireguard-vs-openvpn/" },
  { title: "ZeroTier vs WireGuard", url: "/compare/zerotier-vs-wireguard/" }
];

const itemListSchema = { "@context": "https://schema.org", "@type": "ItemList",
  "name": "VPN and ZTNA Comparisons", "numberOfItems": comparisons.length,
  "itemListElement": comparisons.map((g, i) => ({ "@type": "ListItem", "position": i + 1,
    "name": g.title, "url": "https://meshwg.com" + g.url })) };

const breadcrumbSchema = { "@context": "https://schema.org", "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home",    "item": "https://meshwg.com/" },
    { "@type": "ListItem", "position": 2, "name": "Compare", "item": canonical } ] };
---

<Base title={title} description={description} canonical={canonical} ogType="website">
  <Nav />
  <PageHero
    eyebrow="/ compare"
    title="VPN and ZTNA technical comparisons"
    lede="Deep dives into the protocols, performance differences, and operational tradeoffs between the major players."
  />
  <ValueStrip />

  <section class="guide">
    <div class="wrap">
      <article>
        <h2>All Comparisons</h2>
        <ul class="card-list">
          {comparisons.map((g) => (
            <li>
              <a class="card" href={g.url}>
                <div class="card-h">{g.title} →</div>
              </a>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </section>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Base>

<style>
  .guide { padding: 64px 0 128px; }
  article { max-width: 880px; margin: 0 auto; }
  .guide h2 { font-family: var(--font-display); font-size: 28px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.15; margin: 56px 0 16px; color: var(--text); text-wrap: balance; }
  .guide h2:first-child { margin-top: 0; }
  .card-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .card { display: flex; align-items: center; padding: 22px 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-xl); transition: border-color 0.15s ease, box-shadow 0.15s ease; color: inherit; text-decoration: none; }
  .card:hover { border-color: var(--accent); box-shadow: var(--shadow-card); color: inherit; }
  .card-h { font-family: var(--font-display); font-size: 17px; font-weight: 600; color: var(--text); margin: 0; }
  @media (max-width: 820px) { .card-list { grid-template-columns: 1fr; } .guide { padding: 32px 0 64px; } }
</style>
