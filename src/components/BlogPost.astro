---
import BlogLayout from "../layouts/BlogLayout.astro";

export interface Props {
  title: string;
  description?: string;
  category?: string;
  datePublished?: string;
  dateModified?: string;
  readMinutes?: number;
  author?: string;
  authorRole?: string;
  tags?: string[];
}

const {
  title,
  description,
  category,
  datePublished,
  readMinutes,
  author,
  authorRole,
  tags = ["#strategy guide", "#wireguard", "#control plane", "#mesh vpn", "#networking", "#architecture", "#keys", "#cgnat", "#allowedips", "#enterprise"]
} = Astro.props;
---

<BlogLayout isHomepage={false}>
  <header class="post-header">
    <div class="breadcrumbs">
      <a href="/">Home</a> / <a href="/blog">Blog</a> / <span>{title}</span>
    </div>

    <div class="post-meta-top">
      {category && (
        <span class={`mag-pill ${category === 'STRATEGY & ARCHITECTURE' ? 'pill-purple' : 'pill-orange'}`}>
          {category.toUpperCase()}
        </span>
      )}
      {datePublished && (
        <>
          <span class="meta-dot">•</span>
          <span class="meta-date">{datePublished}</span>
        </>
      )}
      {readMinutes && (
        <>
          <span class="meta-dot">•</span>
          <span class="meta-read">{readMinutes} MIN READ</span>
        </>
      )}
    </div>
    <h1 class="post-h1">{title}</h1>
    {description && <p class="post-desc">{description}</p>}
  </header>

  <div class="post-author-row">
    <div class="author-block">
      <div class="author-avatar" style="background: #FFF7ED; color: #F97316;">⚡</div>
      <div class="author-info">
        <div class="author-name">{author || 'MeshWG Network Architecture Team'}</div>
        <div class="author-role">{authorRole || 'Network Architecture'}</div>
      </div>
    </div>
    <div class="post-tags">
      {tags.map(tag => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  </div>

  <article class="post-content">
    <slot />
  </article>
</BlogLayout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://meshwg.com/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://meshwg.com/blog" },
    { "@type": "ListItem", "position": 3, "name": title, "item": Astro.url.href }
  ]
})}></script>

<style is:global>
  /* Local Pilly Buttons */
  .mag-pill {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 99px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 1;
    white-space: nowrap;
    width: max-content;
  }
  .pill-orange { background: #F97316; color: #FFF; }
  .pill-purple { background: #8B5CF6; color: #FFF; }

  /* Header */
  .post-header {
    margin-bottom: 48px;
  }
  .breadcrumbs {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--text-4);
    margin-bottom: 24px;
    font-weight: 500;
  }
  .breadcrumbs a {
    color: var(--text-3);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .breadcrumbs a:hover {
    color: var(--text);
  }
  .post-meta-top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--text-3);
    letter-spacing: 0.1em;
  }
  .meta-dot { opacity: 0.5; }
  .post-h1 {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 42px);
    font-weight: 800;
    color: var(--text);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 24px 0;
    max-width: 100%;
  }
  .post-desc {
    font-family: var(--font-sans);
    font-size: 20px;
    line-height: 1.6;
    color: var(--text-2);
    margin: 0;
    max-width: 100%;
  }

  /* Author Row */
  .post-author-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    align-items: center;
    padding: 32px 0;
    border-bottom: 1px solid var(--border-faint);
    margin-bottom: 48px;
    gap: 32px;
  }
  .author-block {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .author-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
  }
  .author-name {
    font-family: var(--font-sans);
    font-weight: 700;
    color: var(--text);
    font-size: 15px;
    line-height: 1.3;
  }
  .author-role {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--text-3);
  }
  .post-tags {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: flex-start;
  }
  .tag {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--text-3);
    background: white;
    padding: 6px 16px;
    border-radius: 100px;
    border: 1px solid var(--border-faint);
  }

  /* Content Area */
  .post-content {
    max-width: 100%;
    min-width: 0;
    overflow-wrap: anywhere;
    word-break: normal;
  }
  .post-content h2 {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    margin: 48px 0 16px;
    color: var(--text);
  }
  .post-content h3 {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    margin: 32px 0 8px;
    color: var(--text);
  }
  .post-content p, .post-content li {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-2);
    margin-bottom: 24px;
  }
  
  /* Markdown Tables */
  .post-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 40px 0;
    font-size: 16px;
    line-height: 1.6;
  }
  .post-content th, .post-content td {
    padding: 16px 20px;
    border: 1px solid var(--border-faint);
    text-align: left;
    vertical-align: top;
  }
  .post-content th {
    background: var(--bg-2);
    font-weight: 700;
    color: var(--text);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .post-content tr:nth-child(even) td {
    background: rgba(0, 0, 0, 0.02);
  }
  
  .pink-link, .post-content a:not(.btn) {
    color: #1677FF;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    font-weight: 600;
    transition: color 0.2s ease;
  }
  .pink-link:hover, .post-content a:not(.btn):hover {
    color: #0958d9;
  }

  .tldr-box {
    background: #ffffff;
    border-left: 4px solid #1677FF;
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    padding: 32px 40px;
    margin: 0 0 48px 0;
    width: 100%;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }
  
  .tldr-box h3 {
    margin: 0 0 16px; font-size: 18px; font-weight: 700; color: #1677FF;
    font-family: var(--font-sans);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tldr-box h3::before { content: none; }
  .tldr-box p, .tldr-box li { 
    margin: 0 0 16px; 
    font-size: 16px; 
    line-height: 1.65; 
    color: var(--text-2); 
  }
  .tldr-box ul { margin-bottom: 0; }
  .tldr-box p:last-child { margin-bottom: 0; }
  
  .post-content ul, .post-content ol { 
    margin: 0 0 24px; padding-left: 24px; 
  }
  .post-content li { margin-bottom: 12px; }
  .post-content strong { color: var(--text); font-weight: 600; }
  .post-content code {
    font-family: var(--font-mono); font-size: 0.9em; padding: 2px 4px; background: var(--bg-2); border-radius: var(--radius-sm); color: var(--text);
  }
  .post-content pre {
    background: #0F172A;
    color: #F8FAFC;
    padding: 20px 24px;
    border-radius: var(--radius-md);
    overflow-x: auto;
    max-width: 100%;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    margin-bottom: 24px;
  }
  .post-content pre code { background: transparent; padding: 0; border-radius: 0; color: inherit; font-size: 13px; }
</style>
