---
import Base       from "../../layouts/Base.astro";
import Nav        from "../../components/Nav.astro";
import Footer     from "../../components/Footer.astro";

// Blog post index. Hardcoded list.
interface PostMeta {
  slug:        string;
  title:       string;
  description: string;
  datePublished: string;   // ISO date
  readMinutes: number;
  category:    string;
}

const posts: PostMeta[] = [
  {
    slug:          "managed-vs-self-hosted-wireguard-vpn-2026",
    title:         "Managed vs Self-Hosted WireGuard VPN: Enterprise Mesh Network Architecture Guide (2026)",
    description:   "Comprehensive architectural comparison of self-hosted (Headscale, Netmaker, NetBird) versus managed WireGuard platforms (Tailscale, NetBird Cloud). Features kernel performance metrics, production configuration blocks, NAT traversal mechanics, and zero-trust security hardening blueprints.",
    datePublished: "2026-08-24",
    readMinutes:   22,
    category:      "engineering guide",
  },
  {
    slug:          "wireguard-site-to-site-vpn-multiple-locations",
    title:         "WireGuard Site-to-Site VPN: Multi-Location Setup Guide (2026)",
    description:   "Learn how to connect multiple locations using WireGuard site-to-site VPN. Step-by-step setup for Linux, MikroTik, OpenWrt, Ubiquiti, MTU tuning & MeshWG.",
    datePublished: "2026-08-24",
    readMinutes:   20,
    category:      "engineering guide",
  },
  {
    slug:          "wireguard-nat-traversal-cgnat-firewalls-2026",
    title:         "WireGuard NAT Traversal: Connecting Peers Behind CGNAT & Firewalls (2026)",
    description:   "Complete 2026 engineering guide to WireGuard NAT Traversal. Learn UDP hole punching, PersistentKeepalive, CGNAT workarounds, STUN/ICE mechanics, and enterprise relay strategies.",
    datePublished: "2026-08-21",
    readMinutes:   25,
    category:      "engineering guide",
  },
  {
    slug:          "manage-multiple-wireguard-tunnels-mesh-vpn-2026",
    title:         "How to Manage Multiple WireGuard Tunnels and Build a WireGuard Mesh VPN",
    description:   "Master WireGuard mesh networking and multi-tunnel management in 2026. Learn architecture, full-mesh topologies, automated configs, BGP routing, and scaling strategies.",
    datePublished: "2026-08-20",
    readMinutes:   25,
    category:      "engineering guide",
  },
  {
    slug:          "mesh-vpn-vs-ipsec-vs-sdwan-2026",
    title:         "Mesh VPN vs IPsec vs SD-WAN: choosing the right private network for your business in 2026",
    description:   "A strategist's guide to the three private-network categories shaping multi-site business today. Compare mesh VPN, IPsec, and SD-WAN by what each delivers.",
    datePublished: "2026-05-16",
    readMinutes:   17,
    category:      "strategy guide",
  },
  {
    slug:          "branch-office-vpn-smb-rollout-playbook-2026",
    title:         "Branch office VPN for SMBs in 2026: a 5-phase rollout playbook",
    description:   "Five-phase playbook for rolling out a branch-office VPN across 5 to 50 sites without an SDWAN appliance budget. Real numbers from retail, clinic, and distributor deployments.",
    datePublished: "2026-05-16",
    readMinutes:   17,
    category:      "rollout playbook",
  },
  {
    slug:          "sd-wan-alternatives-2026",
    title:         "SD-WAN alternatives in 2026: seven modern options for connecting branch offices",
    description:   "Honest comparison of seven modern alternatives to box-based SD-WAN — from BYO-router mesh VPN to ZTNA platforms. For SMB and mid-market teams who want branch connectivity without the appliance refresh cycle.",
    datePublished: "2026-05-16",
    readMinutes:   17,
    category:      "buyer's guide",
  },
  {
    slug:          "wireguard-site-to-site-vpn-how-it-works-2026",
    title:         "WireGuard for site-to-site VPN: how it actually works in 2026",
    description:   "How WireGuard site-to-site works at the protocol level — with multi-site mesh, CGNAT scenarios, and when a cloud control plane beats hand-rolled per-peer configs.",
    datePublished: "2026-05-16",
    readMinutes:   18,
    category:      "protocol deep-dive",
  },
  {
    slug:          "tp-link-site-to-site-vpn-wireguard-2026",
    title:         "TP-Link site-to-site VPN with WireGuard: a 2026 guide for branch offices",
    description:   "Connect two, three, or thirty TP-Link branches with WireGuard site-to-site VPN. No static public IPs needed, no firmware changes, no IPsec gymnastics.",
    datePublished: "2026-05-16",
    readMinutes:   16,
    category:      "branch networking",
  },
];

const fmtDate = (iso: string) => {
  const d = new Date(iso + "T00:00:00Z");
  return d.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
};

const title = "Blog — MeshWG";
const description = "Founder-written notes on branch networking, WireGuard, mesh VPN, and connecting the routers you already own.";

// Partition logic for 3-column layout
const featuredPost = posts[0];
const gridPosts = posts.slice(1, 5);
const leftSidebarPosts = posts.slice(5, 7);
const rightSidebarPosts = posts.slice(7, 9);
---

<Base title={title} description={description}>
  <Nav />

  <section class="mag-section">
    <div class="wrap mag-wrap">
      
      <!-- LEFT SIDEBAR -->
      <aside class="mag-sidebar mag-left">
        <div class="mag-pill pill-orange">FOUNDER SPECIAL</div>
        <ul class="mag-list">
          {leftSidebarPosts.map((p) => (
            <li>
              <a href={`/blog/${p.slug}/`} class="mag-list-link">{p.title}</a>
            </li>
          ))}
        </ul>
      </aside>

      <!-- CENTER MAIN -->
      <main class="mag-center">
        <div class="mag-header">
          <h1 class="mag-h1">Networking, Cloud Security & Cybersecurity Blog</h1>
          <p class="mag-desc">Expert articles on cloud security, AI/ML, networking certifications & IT careers</p>
        </div>
        
        <div class="mag-pill-row">
          <div class="mag-pill pill-orange pill-with-icon">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M11.64 5.23a.75.75 0 011.08-.18c2.95 2.25 4.78 6.01 4.78 9.95 0 3.03-2.45 5.5-5.5 5.5S6.5 18.03 6.5 15c0-3.94 1.83-7.7 4.78-9.95a.75.75 0 01.36-.18zM12 7.72c-2.2 1.83-3.5 4.8-3.5 7.28 0 1.93 1.57 3.5 3.5 3.5s3.5-1.57 3.5-3.5c0-2.48-1.3-5.45-3.5-7.28z"/><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/></svg>
            NEWEST ARTICLES
          </div>
          <span class="mag-subtext">Latest from our experts</span>
        </div>

        <!-- Featured Post -->
        <a href={`/blog/${featuredPost.slug}/`} class="mag-featured">
          <div class="feat-img">
            <div class="mesh-bg"></div>
          </div>
          <div class="feat-content">
            <div class="mag-pill-row featured-pill-row">
              <div class="mag-pill pill-orange-dark">AI Coding</div>
              <div class="mag-pill pill-orange pill-new">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/></svg>
                NEW
              </div>
            </div>
            <h2 class="feat-t">{featuredPost.title}</h2>
            <p class="feat-d">{featuredPost.description}</p>
            <div class="feat-meta">
              <span>{featuredPost.readMinutes} min read</span>
              <span class="dot">•</span>
              <span class="read-link">Read article &rarr;</span>
            </div>
          </div>
        </a>

        <!-- Grid Posts -->
        <div class="mag-grid">
          {gridPosts.map((p) => (
            <a href={`/blog/${p.slug}/`} class="mag-card">
              <div class="mag-pill pill-orange-dark">{p.category.split(' ')[0]}</div>
              <h3 class="card-t">{p.title}</h3>
              <p class="card-d">{p.description}</p>
            </a>
          ))}
        </div>
      </main>

      <!-- RIGHT SIDEBAR -->
      <aside class="mag-sidebar mag-right">
        <div class="mag-pill pill-purple">AI SPECIAL</div>
        <ul class="mag-list">
          {rightSidebarPosts.map((p) => (
            <li>
              <a href={`/blog/${p.slug}/`} class="mag-list-link">{p.title}</a>
            </li>
          ))}
        </ul>
      </aside>

    </div>
  </section>

  <!-- HIGH-VOLUME SEO: Blog Breadcrumbs & ItemList -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://meshwg.com/" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://meshwg.com/blog/" },
    ],
  })}></script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Blog",
    "@id": "https://meshwg.com/blog/#blog",
    "name": "MeshWG Blog",
    "description": description,
    "url": "https://meshwg.com/blog/",
    "publisher": {
      "@type": "Organization",
      "@id": "https://meshwg.com/#organization",
      "name": "MeshWG",
      "url": "https://meshwg.com",
    },
    "blogPost": posts.map((p) => ({
      "@type": "BlogPosting",
      "headline": p.title,
      "description": p.description,
      "url": `https://meshwg.com/blog/${p.slug}/`,
      "datePublished": p.datePublished,
    })),
  })}></script>

  <Footer />
</Base>

<style>
  .mag-section { 
    padding: 40px 0 96px; 
    min-height: 100vh;
    border-top: 5px solid #DA291C; /* The prominent red border */
  }

  .mag-wrap {
    display: grid;
    grid-template-columns: 240px 1fr 240px;
    gap: 40px;
    align-items: start;
    max-width: 1400px;
  }

  /* Pilly Buttons */
  .mag-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border-radius: 6px; /* Networkers home uses slightly rounded rects, not full pills */
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.2;
  }
  .pill-orange { background: #FF8A00; color: #fff; }
  .pill-orange-dark { background: #E67700; color: #fff; }
  .pill-purple { background: #8B5CF6; color: #fff; }
  .pill-with-icon { padding: 6px 12px; font-size: 12px; border-radius: 20px; }
  
  /* Sidebars */
  .mag-sidebar {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .mag-list {
    list-style: none;
    padding: 0; margin: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .mag-list-link {
    display: block;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-3);
    font-weight: 400;
    transition: color 0.15s ease;
  }
  .mag-list-link:hover {
    color: var(--text);
  }

  /* Center Main */
  .mag-center {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .mag-header {
    margin-bottom: 4px;
  }
  .mag-h1 {
    font-family: var(--font-sans);
    font-size: 24px;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 8px;
    letter-spacing: -0.01em;
  }
  .mag-desc {
    color: var(--text-3);
    font-size: 14px;
    margin: 0;
  }

  .mag-pill-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .mag-subtext {
    font-size: 13px;
    color: var(--text-4);
  }

  /* Featured Article */
  .mag-featured {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--surface);
    border: 2px solid #F59E0B; /* Thick orange-yellow border */
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    min-height: 320px;
  }
  .feat-img {
    background: var(--bg-2);
    position: relative;
    overflow: hidden;
  }
  .mesh-bg {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(circle at 0% 0%, rgba(22, 119, 255, 0.2) 0%, transparent 60%),
                radial-gradient(circle at 100% 100%, rgba(249, 115, 22, 0.15) 0%, transparent 60%);
    background-color: var(--bg-3);
  }
  .feat-content {
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 16px;
  }
  .featured-pill-row {
    justify-content: space-between;
    margin-bottom: 4px;
  }
  .pill-new {
    background: #F59E0B;
  }
  
  .feat-t {
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 700;
    color: var(--text);
    margin: 0;
    line-height: 1.3;
  }
  .feat-d {
    color: var(--text-3);
    font-size: 14px;
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .feat-meta {
    margin-top: 8px;
    font-size: 12px;
    color: var(--text-4);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .read-link {
    color: #F97316;
    font-weight: 600;
  }

  /* Grid Posts */
  .mag-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .mag-card {
    border: 2px solid #F59E0B; /* Same thick orange border */
    border-radius: 12px;
    background: var(--surface);
    padding: 20px;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .card-t {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 700;
    color: var(--text);
    margin: 0;
    line-height: 1.3;
  }
  .card-d {
    color: var(--text-4);
    font-size: 13px;
    line-height: 1.4;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 1200px) {
    .mag-wrap { grid-template-columns: 200px 1fr 200px; gap: 24px; }
  }

  @media (max-width: 980px) {
    .mag-wrap { grid-template-columns: 1fr; gap: 48px; }
    .mag-featured { grid-template-columns: 1fr; }
    .feat-img { height: 200px; }
    .mag-sidebar { order: 2; }
    .mag-center { order: 1; }
  }

  @media (max-width: 640px) {
    .mag-grid { grid-template-columns: 1fr; }
  }
</style>
