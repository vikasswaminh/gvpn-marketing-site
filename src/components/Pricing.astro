---
import { site } from "../site";

const plans = [
  {
    key: "free",
    name: "Free",
    price: "₹0",
    unit: "forever",
    description: "Start meshing today. Free for as long as you stay small.",
    bullets: [
      "2 machines",
      "Hosted by us — nothing to install",
      "Google or email sign-in",
      "All access-control features",
    ],
    ctaLabel: "Sign up free",
    ctaHref: site.signupFree,
    ctaExternal: true,
    accent: false,
  },
  {
    key: "cloud",
    name: "Cloud",
    price: "₹349",
    unit: "/ machine / month, billed annually",
    sub: "or ₹499 / machine / month, billed monthly",
    description: "For growing meshes. Same hosted product, no machine limit.",
    bullets: [
      "Unlimited machines",
      "Audit log",
      "Email support",
      "Cancel anytime",
    ],
    ctaLabel: "Sign up free",
    ctaHref: site.signupFree,
    ctaExternal: true,
    accent: true,
  },
  {
    key: "pro",
    name: "Pro",
    price: "Custom",
    unit: "talk to us",
    description: "Bigger fleets, dedicated infrastructure, custom needs.",
    bullets: [
      "Dedicated infrastructure",
      "Custom domain (acme.meshwg.com)",
      "Priority support",
      "SLA on request",
    ],
    ctaLabel: "Talk to us",
    ctaHref: site.proContact,
    ctaExternal: false,
    accent: false,
  },
];
---

<section id="pricing">
  <div class="wrap">
    <div class="sec-eyebrow">/ pricing</div>
    <h2 class="sec-h">Simple pricing. Per machine. No surprises.</h2>
    <p class="sec-lede">
      A "machine" is anything in your mesh — a router, a laptop, a phone,
      or a server. Two free forever; <span class="mono-inline">₹349/each</span>
      after that on annual billing.
    </p>

    <div class="price-grid">
      {plans.map((p) => (
        <article class={`plan${p.accent ? " plan-accent" : ""}`}>
          <header>
            <div class="plan-name">{p.name}</div>
            <div class="plan-price">
              <span class="num">{p.price}</span>
              <span class="unit">{p.unit}</span>
            </div>
            {p.sub && <div class="plan-sub">{p.sub}</div>}
          </header>

          <p class="plan-desc">{p.description}</p>

          <ul class="plan-list">
            {p.bullets.map((b) => (
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
                {b}
              </li>
            ))}
          </ul>

          <a
            class={`btn ${p.accent ? "btn-primary" : "btn-line"} plan-cta`}
            href={p.ctaHref}
            target={p.ctaExternal ? "_blank" : undefined}
            rel={p.ctaExternal ? "noopener" : undefined}>
            {p.ctaLabel}
          </a>
        </article>
      ))}
    </div>

    <p class="price-foot">
      <strong>No credit card to start.</strong> Two machines stay free as long
      as you want — add a third only when you're ready to grow.
    </p>

    <div class="price-detail-link">
      <a class="btn" href="/pricing">See full pricing, calculator, and billing FAQ →</a>
    </div>
  </div>
</section>

<style>
  .mono-inline {
    font-family: var(--font-mono);
    font-size: .95em;
    color: var(--text);
  }

  .price-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 64px;
  }

  .plan {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 32px 28px;
    display: flex; flex-direction: column;
    gap: 20px;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .plan:hover { border-color: var(--border-strong); }
  .plan-accent {
    border-color: var(--accent-soft);
    background: linear-gradient(180deg, var(--accent-soft), var(--surface) 40%);
    box-shadow: 0 0 0 1px var(--accent-soft);
  }
  .plan-accent::before {
    content: "Most popular";
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin-bottom: -8px;
  }

  .plan-name {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-3);
    margin-bottom: 12px;
  }

  .plan-price {
    display: flex; align-items: baseline; gap: 10px;
    flex-wrap: wrap;
  }
  .plan-price .num {
    font-family: var(--font-serif);
    font-size: 56px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }
  .plan-accent .plan-price .num { color: var(--accent); font-style: normal; }
  .plan-price .unit {
    font-size: 12.5px;
    color: var(--text-3);
    line-height: 1.4;
  }
  .plan-sub {
    margin-top: 4px;
    font-size: 12px;
    color: var(--text-4);
    font-family: var(--font-mono);
  }

  .plan-desc {
    color: var(--text-2);
    font-size: 13.5px;
    line-height: 1.55;
    margin: 0;
  }

  .plan-list {
    list-style: none;
    padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 10px;
    flex: 1;
  }
  .plan-list li {
    display: flex; align-items: flex-start; gap: 8px;
    color: var(--text-2);
    font-size: 13px;
    line-height: 1.5;
  }
  .plan-list :global(svg) {
    color: var(--ok);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .plan-cta {
    justify-content: center;
    width: 100%;
    height: 40px;
  }

  .price-foot {
    margin: 40px 0 0;
    font-size: 13px;
    color: var(--text-3);
    text-align: center;
    line-height: 1.6;
  }
  .price-foot strong { color: var(--text); font-weight: 500; }

  .price-detail-link {
    margin: 24px 0 0;
    display: flex;
    justify-content: center;
  }

  @media (max-width: 980px) {
    .price-grid { grid-template-columns: 1fr; }
  }
</style>
