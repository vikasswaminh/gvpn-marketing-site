---
import { site } from "../site";
---

<section class="cta-section">
  <div class="wrap">
    <div class="cta">
      <div class="cta-inner">
        <div class="cta-eyebrow">/ get started</div>
        <h2 class="cta-h">Connect your business. <span>Your home. Or both.</span></h2>
        <p class="cta-p">
          Sign up free in under a minute. Two machines free, forever. No
          card, no agent install, no waiting on hardware.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary btn-lg" href={site.signupFree} target="_blank" rel="noopener">
            Sign up free
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a class="btn btn-lg" href={site.proContact}>
            Talk to us
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: 0 0 128px;
  }

  .cta {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 80px 64px;
  }
  .cta-inner { max-width: 720px; }

  .cta-eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .04em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .cta-h {
    font-size: 40px;
    line-height: 1.1;
    letter-spacing: -.02em;
    margin: 0 0 16px;
    font-weight: 500;
    color: var(--text);
  }
  .cta-h span { color: var(--text-3); }
  .cta-p {
    color: var(--text-2);
    font-size: 16px;
    margin: 0 0 28px;
    line-height: 1.6;
  }
  .cta-row {
    display: flex; gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }

  @media (max-width: 980px) {
    .cta-section { padding: 0 0 64px; }
    .cta { padding: 48px 28px; }
    .cta-h { font-size: 28px; }
  }
</style>
