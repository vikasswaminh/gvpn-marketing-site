---
import { site } from "../site";

// Hero content is preserved verbatim from the prior version — only the
// visual presentation changes here.
const heroChecks = [
  "2 machines free, forever",
  "Setup in under 2 minutes",
  "Works with any WireGuard router",
  "No new hardware to buy",
];

// Vendor nodes orbit the acid hub in the right-column mesh diagram.
// Order influences orbital position (top-clockwise from 12 o'clock).
const meshNodes = [
  { tag: "TP", label: "TP-Link"  },
  { tag: "MT", label: "MikroTik" },
  { tag: "OW", label: "OpenWrt"  },
  { tag: "UB", label: "Ubiquiti" },
  { tag: "OP", label: "OPNsense" },
];
---

<section class="hero">
  <div class="wrap hero-inner">

    <!-- ── Left column: editorial headline + CTAs + meta ───────── -->
    <div class="hero-left">
      <span class="eyebrow">
        <span class="pill">live</span>
        <span class="eyebrow-text">one platform · mesh vpn + zero trust access</span>
      </span>

      <h1 class="h1">
        Turn the routers <em class="it">you already own</em>
        into a secure mesh network.
      </h1>

      <p class="lede">
        Connect your branches, your home, and your team —
        without buying <span class="em-red">₹2 lakh SDWAN boxes</span>. MeshWG is a hosted
        mesh service that works with the TP-Link, MikroTik, OpenWrt,
        and Ubiquiti hardware already in your rack.
      </p>

      <div class="hero-cta">
        <a class="btn btn-cream btn-lg" href={site.signupFree}>
          Sign up free
          <svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <a class="btn btn-line btn-lg" href={site.proContact}>
          Talk to us — Pro
        </a>
      </div>
      <p class="hero-micro">
        ₹0 forever for 2 machines. ₹349/machine/month after that. <a href="/pricing">See full pricing →</a>
      </p>

      <div class="hero-meta">
        {heroChecks.map((label) => (
          <span>
            <span class="tick">
              <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
            </span>
            {label}
          </span>
        ))}
      </div>
    </div>

    <!-- ── Right column: animated mesh diagram ─────────────────── -->
    <div class="hero-right" aria-hidden="true">
      <div class="mesh-stage">

        <!-- HUD: top edge labels -->
        <div class="mesh-hud">
          <span>mesh · live</span>
          <span class="live">5 peers up</span>
        </div>

        <!-- Connection lines + animated flow paths (SVG layer) -->
        <svg class="mesh-svg" viewBox="0 0 500 500" preserveAspectRatio="xMidYMid meet">
          <defs>
            <linearGradient id="hub-glow" cx="50%" cy="50%" r="50%">
              <stop offset="0%"  stop-color="#0066ff" stop-opacity="0.4"/>
              <stop offset="60%" stop-color="#0066ff" stop-opacity="0"/>
            </linearGradient>
          </defs>
          <!-- Static connection backbone (5 spokes hub→node) -->
          <line class="mesh-line" x1="250" y1="250" x2="250" y2="90"/>
          <line class="mesh-line" x1="250" y1="250" x2="402" y2="174"/>
          <line class="mesh-line" x1="250" y1="250" x2="346" y2="402"/>
          <line class="mesh-line" x1="250" y1="250" x2="154" y2="402"/>
          <line class="mesh-line" x1="250" y1="250" x2="98" y2="174"/>
          <!-- Animated dashed flow paths (3 spokes carry traffic on different timings) -->
          <line class="mesh-flow a" x1="250" y1="250" x2="250" y2="90"/>
          <line class="mesh-flow b" x1="250" y1="250" x2="346" y2="402"/>
          <line class="mesh-flow c" x1="250" y1="250" x2="98"  y2="174"/>
        </svg>

        <!-- Hub node (acid, pulsing rings) -->
        <div class="mesh-node hub" style="left:50%; top:50%;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="6" r="1.8"/>
            <circle cx="6"  cy="14" r="1.8"/>
            <circle cx="18" cy="14" r="1.8"/>
            <circle cx="12" cy="20" r="1.5"/>
            <path d="M12 8 L6 14 M12 8 L18 14 M6 14 L12 20 M18 14 L12 20 M6 14 L18 14"/>
          </svg>
        </div>

        <!-- 5 vendor nodes around the hub -->
        {meshNodes.map((n, i) => {
          // 5 positions on a circle of radius 32% from center, starting at top
          const positions = [
            { left: "50%",   top: "18%"  },
            { left: "80.4%", top: "34.8%" },
            { left: "69.2%", top: "80.4%" },
            { left: "30.8%", top: "80.4%" },
            { left: "19.6%", top: "34.8%" },
          ];
          const p = positions[i];
          return (
            <div class="mesh-node" style={`left:${p.left}; top:${p.top};`}>
              <span class="vtag">{n.tag}</span>
              <span class="vname">{n.label}</span>
            </div>
          );
        })}

        <!-- Foot: 3 stat cells -->
        <div class="mesh-foot">
          <div>
            <div class="lbl">latency</div>
            <div class="val">12 ms</div>
          </div>
          <div>
            <div class="lbl">tunnels</div>
            <div class="val">5 / 5</div>
          </div>
          <div>
            <div class="lbl">status</div>
            <div class="val ok">online</div>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  /* ── Hero canvas ─────────────────────────────────────────────── */
  .hero {
    padding: 100px 0 56px;
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  /* very-subtle accent wash top-right only */
  .hero::before {
    content: "";
    position: absolute;
    top: -200px; right: -200px;
    width: 900px; height: 900px;
    z-index: -1;
    background: radial-gradient(circle, var(--accent-soft) 0%, transparent 60%);
    pointer-events: none;
    opacity: .8;
  }
  .hero::after {
    content: "";
    position: absolute;
    bottom: -200px; left: -200px;
    width: 700px; height: 700px;
    z-index: -1;
    background: radial-gradient(circle, var(--brand-red-soft) 0%, transparent 60%);
    pointer-events: none;
    opacity: .65;
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }
  .hero-left { position: relative; z-index: 2; }

  /* ── Eyebrow pill (mono uppercase + live indicator) ──────────── */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 12px 7px 8px;
    border-radius: var(--radius-pill);
    background: var(--bg);
    border: 1px solid var(--border);
    margin-bottom: 16px;
  }
  .eyebrow .pill {
    background: var(--accent);
    color: #ffffff;
    padding: 3px 7px;
    border-radius: var(--radius-pill);
    font: 600 10px/1 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .eyebrow-text {
    font: 500 11.5px/1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-3);
  }

  /* ── Display H1 ─────────────── */
  .h1 {
    font-family: var(--font-sans);
    font-size: clamp(32px, 4.5vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 700;
    margin: 0 0 16px;
    text-wrap: balance;
    color: var(--text);
  }
  .h1 .it {
    font-style: normal;
    color: var(--brand-red);
  }

  /* ── Lede ─────────────────────────────────────────────────────── */
  .lede {
    font-size: 16px;
    color: var(--text-3);
    max-width: 600px;
    line-height: 1.6;
    text-wrap: pretty;
    font-weight: 400;
    margin: 0;
  }
  .lede b { color: var(--text); font-weight: 600; }
  .lede .em-red { color: var(--brand-red); font-weight: 600; }

  /* ── CTAs row ────────────────────────────────────────────────── */
  .hero-cta {
    display: flex;
    gap: 8px;
    margin-top: 24px;
    align-items: center;
    flex-wrap: wrap;
  }
  /* Primary CTA — clean ink button, no glow. Hover: tiny lift + subtle
     shadow. Restraint > pulsing animations. */
  .hero-cta .btn-cream {
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .hero-cta .btn-cream:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 18px rgba(10, 10, 10, 0.22);
  }
  .hero-micro {
    margin: 14px 0 0;
    font-size: 13px;
    color: var(--text-3);
    font-weight: 400;
  }
  .hero-micro a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--border-strong);
    transition: text-decoration-color 0.15s ease;
  }
  .hero-micro a:hover { text-decoration-color: var(--text); }

  /* ── Hero meta row (mono uppercase + acid ticks) ─────────────── */
  .hero-meta {
    display: flex;
    gap: 20px;
    margin-top: 32px;
    font: 500 11px/1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.10em;
    color: var(--text-3);
    flex-wrap: wrap;
  }
  .hero-meta span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hero-meta .tick {
    width: 14px; height: 14px;
    border-radius: 50%;
    background: var(--accent);
    color: #ffffff;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  /* ── Right column: animated mesh stage ───────────────────────── */
  .hero-right {
    position: relative;
    aspect-ratio: 1 / 1;
    max-width: 580px;
    justify-self: end;
    width: 100%;
  }
  .mesh-stage {
    position: relative;
    width: 100%; height: 100%;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border);
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 50%, var(--accent-soft), transparent 65%),
      linear-gradient(180deg, var(--bg), var(--bg-2));
  }
  /* subtle grid lines (dark-on-light), masked to a soft circle in the middle */
  .mesh-stage::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(10, 10, 10, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(10, 10, 10, 0.04) 1px, transparent 1px);
    background-size: 40px 40px;
    -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 50%, transparent 75%);
            mask-image: radial-gradient(circle at 50% 50%, #000 50%, transparent 75%);
  }

  .mesh-hud {
    position: absolute;
    left: 18px; right: 18px;
    top: 18px;
    display: flex;
    justify-content: space-between;
    font: 500 10.5px/1 var(--font-mono);
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    z-index: 2;
  }
  .mesh-hud .live {
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .mesh-hud .live::before {
    content: "";
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* SVG layer (lines + animated dashed flow) */
  .mesh-svg {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
  }
  .mesh-line {
    stroke: var(--border-strong);
    stroke-width: 1;
    opacity: 0.8;
    fill: none;
  }
  .mesh-flow {
    stroke: var(--accent);
    stroke-width: 1.4;
    fill: none;
    stroke-dasharray: 4 6;
  }
  /* Static dashed flow paths — no animation. Modern minimal feel. */
  .mesh-flow.a { opacity: 0.6; }
  .mesh-flow.b { opacity: 0.45; }
  .mesh-flow.c { opacity: 0.55; }

  /* Nodes */
  .mesh-node {
    position: absolute;
    width: 56px; height: 56px;
    border-radius: 12px;
    background: var(--bg-2);
    border: 1px solid var(--border-strong);
    display: grid;
    place-items: center;
    color: var(--text);
    box-shadow: var(--shadow-card);
    transform: translate(-50%, -50%);
    z-index: 3;
  }
  .mesh-node .vtag {
    font: 600 12px/1 var(--font-mono);
    color: var(--text);
    letter-spacing: 0.02em;
  }
  .mesh-node .vname {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 8px;
    font: 500 10.5px/1 var(--font-mono);
    color: var(--text-2);
    white-space: nowrap;
  }
  .mesh-node.hub {
    width: 72px; height: 72px;
    background: var(--accent);
    color: #ffffff;
    border-color: var(--accent);
    box-shadow:
      0 0 0 6px var(--accent-soft),
      0 12px 30px color-mix(in oklab, var(--accent) 30%, transparent);
    z-index: 4;
  }
  /* Static ring around the hub — no pulse */
  .mesh-node.hub::before {
    content: "";
    position: absolute;
    inset: -8px;
    border-radius: 18px;
    border: 1px solid var(--accent);
    opacity: 0.3;
  }

  /* Foot: stat cells */
  .mesh-foot {
    position: absolute;
    left: 18px; right: 18px;
    bottom: 18px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    z-index: 2;
  }
  .mesh-foot > div {
    background: var(--bg);
    padding: 10px 12px;
  }
  .mesh-foot .lbl {
    font: 500 9.5px/1 var(--font-mono);
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 6px;
  }
  .mesh-foot .val {
    font: 500 14px/1 var(--font-mono);
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .mesh-foot .val.ok { color: var(--ok); }

  /* ── Responsive ──────────────────────────────────────────────── */
  @media (max-width: 980px) {
    .hero { padding: 110px 0 64px; }
    .hero-inner { grid-template-columns: 1fr; gap: 24px; }
    .hero-right { justify-self: stretch; max-width: 100%; }
    .h1 { font-size: clamp(22px, 6vw, 32px); }
    .lede { font-size: 16px; }
    .hero-meta { gap: 14px 22px; margin-top: 40px; font-size: 10.5px; }
  }
</style>
