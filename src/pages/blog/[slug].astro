---
import { getCollection } from 'astro:content';
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/meshwg-blog.css";
import { strategyPosts, engineeringPosts } from "../../utils/posts";

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const title = post.data.title;
const description = post.data.description;
const pubDate = new Date(post.data.pubDate);
const minutes = Math.ceil((post.body ? post.body.split(/\s+/).length : 5000) / 200);
const tags = post.data.tags || [];
const author = post.data.author || 'MeshWG editorial team';

const hasStrategy = tags && tags.some(tag => tag.toLowerCase() === 'strategy guide' || tag.toLowerCase() === 'protocol deep-dive');
const pillText = hasStrategy ? 'STRATEGY & ARCHITECTURE' : 'ENGINEERING GUIDE';
const pillClass = hasStrategy ? 'nh-sidebar-pill pill-purple' : 'nh-sidebar-pill pill-orange';
---

<Base title={title} description={description}>
  <Nav />
  
  <div id="progress-container">
    <div id="progress-bar"></div>
  </div>
  
  <main class="post-layout" style="padding: 120px 0 48px 0;">
    <div class="wrap post-body-grid">
      
      <!-- LEFT SIDEBAR -->
      <aside class="nh-sidebar" aria-label="Strategy & Architecture">
        <div>
          <span class="nh-sidebar-pill pill-purple">STRATEGY & ARCHITECTURE</span>
          <nav class="nh-sidebar-nav">
            {[...strategyPosts].reverse().map(p => (
              <a href={`/blog/${p.slug}/`} class="nh-sidebar-link">{p.title}</a>
            ))}
          </nav>
        </div>
      </aside>

      <!-- MAIN CONTENT -->
      <article class="post-content">
        <nav aria-label="Breadcrumb" class="breadcrumbs" style="font-size: 13px; color: #475569; margin-bottom: 24px;">
          <a href="/" style="color: #475569; text-decoration: none;">Home</a> <span style="margin: 0 8px;">/</span>
          <a href="/blog/" style="color: #475569; text-decoration: none;">Blog</a> <span style="margin: 0 8px;">/</span>
          <span style="color: #0f172a; font-weight: 500;">{title}</span>
        </nav>
        <header class="post-header">
          <div class="post-meta-top">
            {tags && tags.length > 0 && (
              <>
                <span class={pillClass} style="font-size: 11px; padding: 4px 12px; border-radius: 100px; font-weight: 700; text-transform: uppercase;">{pillText}</span>
                <span class="meta-dot">•</span>
              </>
            )}
            <span class="meta-date">{pubDate.toISOString().split('T')[0]}</span>
            <span class="meta-dot">•</span>
            <span class="meta-read">{minutes} MIN READ</span>
          </div>
          <h1 class="post-h1">{title}</h1>
          {description && <p class="post-desc">{description}</p>}
        </header>
        
        <div class="post-author-row">
          <div class="author-block">
            <div class="author-avatar" style="background: #FFF7ED; color: #c2410c;" aria-hidden="true">⚡</div>
            <div class="author-info">
              <div class="author-name">{author}</div>
              <div class="author-role">Network Architecture</div>
            </div>
          </div>
          
          {tags && tags.length > 0 && (
            <div class="post-tags">
              {tags.map(tag => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
          )}
        </div>

        <div class="prose">
          <Content />
        </div>
        
        <!-- E-E-A-T Author Box -->
        <div class="author-bio-box">
          <div class="author-bio-avatar" aria-hidden="true">ME</div>
          <div class="author-bio-content">
            <div class="author-bio-title">Written by <strong>{author}</strong></div>
            <p class="author-bio-desc">Our core networking team specializes in zero-trust architecture, multi-cloud SD-WANs, and high-performance kernel VPNs. We build <a href="https://meshwg.com">MeshWG</a> to simplify enterprise WireGuard orchestration.</p>
          </div>
        </div>
      </article>

      <!-- RIGHT SIDEBAR -->
      <aside class="nh-sidebar nh-sidebar-right" aria-label="Engineering Guides">
        <div>
          <span class="nh-sidebar-pill pill-orange">ENGINEERING GUIDES</span>
          <nav class="nh-sidebar-nav">
            {engineeringPosts.map(p => (
              <a href={`/blog/${p.slug}/`} class="nh-sidebar-link">{p.title}</a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </main>
  
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Reading Progress Bar
      const progressBar = document.getElementById('progress-bar');
      const updateProgress = () => {
        if (!progressBar) return;
        const scrollTotal = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrollPos = document.documentElement.scrollTop;
        if (scrollTotal > 0) {
          const percent = (scrollPos / scrollTotal) * 100;
          progressBar.style.width = percent + '%';
        }
      };
      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    });
  </script>

  <style is:global>
    #progress-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 4px;
      background: transparent;
      z-index: 9999;
    }
    #progress-bar {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #38BDF8, #a855f7);
      transition: width 0.1s ease-out;
    }
  </style>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://meshwg.com/" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://meshwg.com/blog/" },
      { "@type": "ListItem", "position": 3, "name": title, "item": `https://meshwg.com/blog/${post.slug}/` }
    ]
  })}></script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "datePublished": pubDate.toISOString(),
    "author": {
      "@type": "Person",
      "name": author
    },
    "url": `https://meshwg.com/blog/${post.slug}/`
  })}></script>

  <Footer />
</Base>
