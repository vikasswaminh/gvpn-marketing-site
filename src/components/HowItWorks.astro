---
const steps = [
  {
    num: "01",
    title: "Sign up",
    body: "Create your account with Google or email. No credit card. You're in the dashboard in under a minute.",
  },
  {
    num: "02",
    title: "Add your devices",
    body: "Click Add machine, give it a name, and paste the WireGuard config we generate into your router or laptop. The tunnel comes up immediately.",
  },
  {
    num: "03",
    title: "Set who reaches what",
    body: "Allow or deny traffic between any two machines in one click — site-to-site, user-to-server, by app or by port. Changes apply in real time.",
  },
];
---

<section id="how">
  <div class="wrap">
    <div class="sec-eyebrow">/ how it works</div>
    <h2 class="sec-h">From unboxed to fully meshed in 2 minutes.</h2>
    <p class="sec-lede">
      No firmware changes. No agent install on every device. No
      certificates to manage. The hardware you have is the hardware
      you use.
    </p>

    <div class="how-grid">
      {steps.map((s) => (
        <article class="step">
          <header class="step-head">
            <span class="step-num">{s.num}</span>
            <h3 class="step-title">{s.title}</h3>
          </header>
          <p class="step-body">{s.body}</p>
        </article>
      ))}
    </div>

    <div class="how-cta">
      <a class="btn" href="/quickstart">Full setup guide — with vendor-specific steps →</a>
    </div>
  </div>
</section>

<style>
  /* Editorial row of three steps: serif italic numerals as the
     dominant visual, sans titles, light body copy. */
  .how-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin-top: 56px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }
  .step {
    padding: 32px 32px 40px;
    border-right: 1px solid var(--border);
    position: relative;
    transition: background 0.25s ease;
  }
  .step:last-child { border-right: 0; }
  .step:hover { background: var(--bg); }

  .step-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 14px;
  }
  /* Oversized italic acid numeral — the editorial signature */
  .step-num {
    font-family: var(--font-serif);
    font-size: 56px;
    line-height: 1;
    font-weight: 400;
    font-style: normal;
    color: var(--accent);
    letter-spacing: -0.02em;
  }
  .step-title {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 400;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--text);
    line-height: 1.1;
  }
  .step-body {
    color: var(--text-2);
    font-size: 14.5px;
    line-height: 1.6;
    margin: 0;
    font-weight: 300;
    max-width: 320px;
  }

  .how-cta {
    margin-top: 48px;
    display: flex;
    justify-content: center;
  }
  .how-cta .btn {
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .how-cta .btn:hover { color: var(--accent); }

  @media (max-width: 980px) {
    .how-grid { grid-template-columns: 1fr; }
  }
</style>
