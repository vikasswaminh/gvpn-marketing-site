<style>
  .legal { padding: 64px 0 128px; }
  .legal article { margin-bottom: 56px; max-width: 760px; }
  .legal article:last-child { margin-bottom: 0; }
  .legal h2 {
    font-family: var(--font-serif);
    font-size: 30px;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 0 0 20px;
    color: var(--text);
    text-wrap: balance;
  }
  .legal h3 {
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 400;
    margin: 28px 0 10px;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .legal p {
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.7;
    margin: 0 0 14px;
    font-weight: 300;
  }
  .legal p:last-child { margin-bottom: 0; }
  .legal strong { color: var(--text); font-weight: 500; }
  .legal a { color: var(--accent); }
  .legal a:hover { color: var(--accent-strong); }
  .legal code {
    font-family: var(--font-mono);
    font-size: .92em;
    background: var(--bg-2);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
  }
  .bullets {
    list-style: none;
    padding: 0; margin: 0 0 14px;
    display: flex; flex-direction: column; gap: 10px;
  }
  .bullets li {
    color: var(--text-2);
    font-size: 15px; line-height: 1.65;
    padding-left: 22px;
    position: relative;
  }
  .bullets li::before {
    content: "—";
    position: absolute; left: 0; top: 0;
    color: var(--text-4);
    font-family: var(--font-mono);
  }
  .contact-block {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 20px 24px;
    margin: 14px 0;
  }
  .contact-block p {
    margin: 0 0 6px;
    font-size: 14.5px;
  }
  .contact-block p:last-child { margin-bottom: 0; }

  @media (max-width: 980px) {
    .legal { padding: 32px 0 64px; }
    .legal article { margin-bottom: 36px; }
  }
</style>
