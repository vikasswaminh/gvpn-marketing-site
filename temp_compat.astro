 Officer","email":"amit@meshwg.com","areaServed":"IN"},{"@type":"ContactPoint","contactType":"HR","email":"careers@meshwg.com","areaServed":"IN"}]}</script><style data-vite-dev-id="C:/Users/DELL 3511 (243597)/Downloads/gvpn-marketing-site/src/styles/tokens.css">/* MeshWG marketing — design tokens
 *
 * Light minimal canvas (crawlcrawl-inspired):
 *   • Near-white surfaces, near-black ink
 *   • Bright blue accent (#0066ff) for CTAs + emphasis
 *   • Brand red (#DA291C) for announcement bar / strong emphasis
 *   • Geist + Geist Mono — modern SaaS premium feel
 *   • Tight radii (4–12 px), super-subtle shadows
 *   • No film grain, no italics
 *
 * Legacy variable names from the prior dark-theme version are kept as
 * aliases so existing components continue to work unchanged.
 */

:root {
  /* ── Surfaces ─────────────────────────────────────────────────────── */
  --bg:             #ffffff;
  --bg-2:           #fafafa;
  --bg-3:           #f4f4f5;
  --bg-deep:        #ebebed;
  --surface:        #fafafa;
  --surface-2:      #f4f4f5;

  /* ── Ink + muted ──────────────────────────────────────────────────── */
  --text:           #0a0a0a;
  --text-2:         #18181b;
  --text-3:         #52525b;
  --text-4:         #8a8a93;
  --ink:            #0a0a0a;
  --ink-2:          #18181b;
  --muted:          #52525b;
  --muted-2:        #8a8a93;
  --muted-3:        #b4b4ba;

  /* ── Lines (super subtle on light) ────────────────────────────────── */
  --border-faint:   #f0f0f1;
  --border:         #e5e5e7;
  --border-strong:  #ddddde;
  --line:           #e5e5e7;
  --line-2:         #ddddde;
  --line-3:         #f0f0f1;

  /* ── Accent: bright blue ──────────────────────────────────────────── */
  --accent:         #0066ff;
  --accent-strong:  #0052cc;
  --accent-soft:    #e7efff;
  --accent-glow:    rgba(0, 102, 255, .18);
  --accent-ink:     #ffffff;

  /* ── Brand red (announcement bar + emphasis) ──────────────────────── */
  --brand-red:      #DA291C;
  --brand-red-2:    #b3211a;
  --brand-red-soft: #fde8e6;

  /* ── Status ───────────────────────────────────────────────────────── */
  --ok:             #16a34a;
  --warn:           #facc15;
  --err:            #dc2626;
  --info:           #0066ff;
  --ember:          #DA291C;

  /* ── Code surfaces (dark blocks on a light page) ──────────────────── */
  --code-bg:        #0a0a0a;
  --code-bg-2:      #141414;
  --code-fg:        #e6e6e9;
  --code-com:       #6b7280;
  --code-pun:       #a1a1aa;
  --code-key:       #93c5fd;
  --code-str:       #86efac;
  --code-num:       #fcd34d;
  --code-fn:        #fda4af;
  --code-cmd:       #ffffff;
  --code-prompt:    #93c5fd;
  --code-ok:        #86efac;

  /* ── Typography ───────────────────────────────────────────────────── */
  --font-sans:      "Geist", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, system-ui, sans-serif;
  --font-mono:      "Geist Mono", ui-monospace, "SF Mono", Menlo, monospace;

  /* ── Radii (tight — crawlcrawl-style) ─────────────────────────────── */
  --radius-sm:      4px;
  --radius:         6px;
  --radius-lg:      8px;
  --radius-xl:      12px;
  --radius-pill:    999px;
  --r-sm:           4px;
  --r-md:           6px;
  --r-lg:           8px;
  --r-xl:           12px;

  /* ── Layout ───────────────────────────────────────────────────────── */
  --wrap-max:       1180px;
  --wrap-pad-x:     clamp(16px, 4vw, 24px);
  --maxw-narrow:    880px;
  --maxw:           1180px;
  --maxw-wide:      1260px;
  --container:      1180px;

  /* ── Shadows (super subtle for light theme) ───────────────────────── */
  --shadow-card:    0 1px 0 rgba(10, 10, 10, 0.04);
  --shadow-deep:    0 24px 48px -16px rgba(10, 10, 10, 0.18);
  --shadow-code:    0 24px 48px -16px rgba(10, 10, 10, 0.18);
}

/* Reset + base */
*, *::before, *::after { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }

html {
  background: var(--bg);
  scroll-behavior: smooth;
}

body {
  font-family: var(--font-sans);
  color: var(--text);
  background-color: var(--bg);
  background-image: 
    linear-gradient(to right, rgba(0, 0, 0, 0.04) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(0, 0, 0, 0.04) 1px, transparent 1px);
  background-size: 80px 80px;
  background-attachment: local;
  line-height: 1.6;
  font-size: 15px;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  overflow-x: hidden;
}

a { color: inherit; text-decoration: none; }
::selection { background: var(--accent); color: #ffffff; }

/* Layout container */
.wrap {
  max-width: var(--wrap-max);
  margin: 0 auto;
  padding: 0 var(--wrap-pad-x);
}

/* ── Mono label primitive ───────────────────────────────────────────
   Section eyebrow / metadata signature. Tight letter-spacing, uppercase. */
.ml {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-3);
}
.ml .num { color: var(--accent); margin-right: 8px; }

/* ── Buttons ────────────────────────────────────────────────────────
   Tight radius (6 px), blue primary, neutral secondary. */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  height: 36px;
  padding: 0 14px;
  border-radius: var(--radius);
  font-size: 13.5px;
  font-weight: 600;
  font-family: inherit;
  border: 1px solid transparent;
  background: transparent;
  color: var(--text);
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  will-change: transform, box-shadow;
}
.btn:hover {
  transform: translateY(-2px);
}
.btn .arrow { transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1); }
.btn:hover .arrow { transform: translateX(4px); }

/* PRIMARY = solid ink (black). Timeless, premium, matches crawlcrawl.
   This is the default CTA used by Nav, Pricing card, and inline copy. */
.btn-primary,
.btn-cream {
  background: var(--ink);
  color: #ffffff;
  border-color: var(--ink);
}
.btn-primary:hover,
.btn-cream:hover {
  background: var(--text-2);
  border-color: var(--text-2);
  box-shadow: 0 8px 24px -8px rgba(10, 10, 10, 0.25);
}

/* ACID = bright-blue accent. Use only when a moment needs to pop
   beyond the standard ink primary (rare). Same shape, different color. */
.btn-acid {
  background: var(--accent);
  color: #ffffff;
  border-color: var(--accent);
}
.btn-acid:hover {
  background: var(--accent-strong);
  border-color: var(--accent-strong);
  box-shadow: 0 8px 24px -8px var(--accent-glow);
}

/* Outline */
.btn-line {
  border-color: var(--border-strong);
  color: var(--text);
  background: var(--bg);
}
.btn-line:hover {
  background: var(--bg-2);
  border-color: var(--text-4);
}

/* Ghost / tertiary */
.btn-ghost {
  color: var(--text-3);
  background: transparent;
  border-color: transparent;
}
.btn-ghost:hover {
  color: var(--text);
  background: var(--bg-2);
}

.btn-lg {
  height: 44px;
  padding: 0 18px;
  font-size: 14.5px;
}

/* ── Section primitives ───────────────────────────────────────────── */
section { padding: 16px 0; position: relative; }
section + section { border-top: 1px solid var(--border); }

.sec-eyebrow {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-3);
  margin-bottom: 12px;
}
.sec-eyebrow .num { color: var(--accent); margin-right: 8px; }

.sec-h {
  font-family: var(--font-sans);
  font-size: clamp(24px, 3vw, 40px);
  line-height: 1.1;
  letter-spacing: -0.02em;
  font-weight: 700;
  margin: 0 0 12px;
  max-width: 880px;
  text-wrap: balance;
  color: var(--text);
}
.sec-h .it { font-style: normal; }
.sec-h .acid { color: var(--accent); font-style: normal; }

/* Global italic suppression — no italic anywhere on the marketing site */
em, i, cite, dfn, address, var { font-style: normal; }

.sec-lede {
  color: var(--text-3);
  font-size: 16px;
  max-width: 640px;
  line-height: 1.6;
  margin: 0;
  text-wrap: pretty;
  font-weight: 400;
}
.sec-lede b { color: var(--text); font-weight: 600; }

/* ── Responsive ───────────────────────────────────────────────────── */
@media (max-width: 980px) {
  :root { --wrap-pad-x: 16px; }
  section { padding: 12px 0; }
  .sec-h { font-size: 32px; }
}

/* ── Scroll-reveal (preserved from prior visual pass) ─────────────── */
.js-reveal section:not(.hero) {
  opacity: 0;
  transform: translateY(16px);
  transition: opacity 0.65s cubic-bezier(0.22, 0.61, 0.36, 1),
              transform 0.65s cubic-bezier(0.22, 0.61, 0.36, 1);
  will-change: opacity, transform;
}
.js-reveal section.in-view { opacity: 1; transform: none; }
@media (prefers-reduced-motion: reduce) {
  .js-reveal section:not(.hero) {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
  }
}

/* ── Scrollbar (light canvas tuned) ───────────────────────────────── */
@supports (scrollbar-width: thin) {
  html {
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong) transparent;
  }
}
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb {
  background: var(--border-strong);
  border-radius: 999px;
  border: 2px solid var(--bg);
}
::-webkit-scrollbar-thumb:hover { background: var(--text-4); }

/* ── Hover Card Dynamics ──────────────────────────────────────────── */
.hover-card {
  transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  will-change: transform, box-shadow, border-color;
}
.hover-card:hover {
  transform: translateY(-4px) scale(1.005);
  box-shadow: var(--shadow-deep);
  border-color: var(--border-strong);
}
</style>
