---
import Base       from "../layouts/Base.astro";
import Nav        from "../components/Nav.astro";
import PageHero   from "../components/PageHero.astro";
import Footer     from "../components/Footer.astro";

const title = "Contact MeshWG — 24/7 support, direct lines, and our Bangalore campus";
const description = "MeshWG runs 24/7 human support — round-the-clock incident response for paid and free tiers alike. Direct line: +91-9611027980. Sales / billing / careers: Mon–Sat 10:00 AM – 6:00 PM IST. Campus: L-149, Sector 6, HSR Layout, Bengaluru 560102.";

// Structured data for AEO. ContactPage explicitly declares this is the
// canonical contact entry-point for the Organization defined in Base.astro;
// the BreadcrumbList helps Google / Bing render the URL with a hierarchy.
const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": "https://meshwg.com/contact#contactpage",
  "url": "https://meshwg.com/contact",
  "name": title,
  "description": description,
  "inLanguage": "en",
  "isPartOf": { "@id": "https://meshwg.com/#organization" },
  "mainEntity": { "@id": "https://meshwg.com/#organization" }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://meshwg.com/" },
    { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://meshwg.com/contact" }
  ]
};
---

<Base title={title} description={description}>
  <Nav />
  <PageHero
    eyebrow="/ contact us"
    title="Talk to a human, not a ticket queue."
    lede="Technical support runs 24/7 — there is always a human on call when a tunnel goes down. Sales, billing, and careers run Mon–Sat 10:00 AM – 6:00 PM IST. Pick the line that fits."
  />

  <section class="contact">
    <div class="wrap">

      {/* ── Top: the two ways people actually reach us ───────────────── */}
      <div class="lead-grid">

        <div class="lead-card">
          <div class="lead-eyebrow">🛟 24/7 support</div>
          <a class="lead-h" href="mailto:support@meshwg.com">support@meshwg.com</a>
          <div class="lead-meta">
            <strong>Always on</strong> · acknowledgement within 30 minutes, any hour
          </div>
          <p class="lead-body">
            Best for: tunnel down, handshake failure, branch can't reach HQ —
            anything stopping your business right now. A human responds 24/7.
          </p>
        </div>

        <div class="lead-card">
          <div class="lead-eyebrow">📞 Sales &amp; billing</div>
          <a class="lead-h" href="tel:+919611027980">+91-9611027980</a>
          <div class="lead-meta">
            <strong>Mon–Sat</strong>, 10:00 AM – 6:00 PM IST
          </div>
          <p class="lead-body">
            Best for: sales conversations, pricing questions for &gt; 50 machines,
            partner inquiries, billing questions. Also reachable at
            <a href="mailto:hello@meshwg.com">hello@meshwg.com</a>.
          </p>
        </div>

      </div>

      {/* ── Routing: where to send what ───────────────────────────────── */}
      <article>
        <h2>Where to send what</h2>
        <p class="article-lede">
          We try not to have a forms maze. These four addresses route faster than
          a generic inbox, so use whichever fits.
        </p>

        <div class="routing-grid">
          <div class="route">
            <div class="route-h">Sales &amp; pricing</div>
            <a href="mailto:hello@meshwg.com?subject=Sales%20inquiry">hello@meshwg.com</a>
            <p>Custom pricing above 50 machines, annual deals, MSA / DPA review,
              evaluation calls with your network team.</p>
          </div>

          <div class="route">
            <div class="route-h">Customer support · 24/7</div>
            <a href="mailto:support@meshwg.com">support@meshwg.com</a>
            <p>Router configs, mesh connectivity issues, tunnel down — anything
              stopping your business. <strong>Round-the-clock human response</strong>;
              free and paid tiers alike. Include your tenant email so we find your
              account immediately.</p>
          </div>

          <div class="route">
            <div class="route-h">Security &amp; abuse</div>
            <a href="mailto:security@meshwg.com">security@meshwg.com</a>
            <p>Vulnerability disclosures, suspected account compromise, takedown
              requests. We prefer responsible disclosure; see also
              <a href="/.well-known/security.txt">security.txt</a>.</p>
          </div>

          <div class="route">
            <div class="route-h">Legal &amp; Grievance Officer</div>
            <a href="mailto:amit@meshwg.com">amit@meshwg.com</a>
            <p>DPDP Act 2023 requests, data-subject access requests, lawful access
              requests, anything addressed to the Grievance Officer named in our
              <a href="/privacy">Privacy Policy</a>.</p>
          </div>
        </div>
      </article>

      {/* ── Campus block ──────────────────────────────────────────────── */}
      <article>
        <h2>Our campus</h2>
        <p class="article-lede">
          We're a Bangalore-built, Bangalore-run team. Visits are by appointment —
          please call ahead so the right person is at the desk when you arrive.
        </p>

        <div class="contact-block">
          <p><strong>📍 Address:</strong> L-149, Sector 6, HSR Layout, Bengaluru 560102, India</p>
          <p><strong>📞 Phone:</strong> <a href="tel:+919611027980">+91-9611027980</a></p>
          <p><strong>🕘 Campus hours (sales, billing, careers):</strong> Mon–Sat, 10:00 AM – 6:00 PM IST</p>
          <p><strong>🛟 Technical support:</strong> 24/7, <a href="mailto:support@meshwg.com">support@meshwg.com</a></p>
          <p><strong>✉ Reception:</strong> <a href="mailto:hello@meshwg.com">hello@meshwg.com</a></p>
        </div>

        <p class="muted">
          <strong>Campus visits:</strong> by appointment, during campus hours.
          <strong>Technical support never closes</strong> — an on-call engineer
          is reachable at <a href="mailto:support@meshwg.com">support@meshwg.com</a> any
          hour, including Sundays and gazetted holidays.
        </p>
      </article>

      {/* ── Response expectations ─────────────────────────────────────── */}
      <article>
        <h2>What to expect from us</h2>
        <ul class="bullets">
          <li><strong>Technical support</strong> — 24/7. Acknowledgement within <strong>30 minutes</strong> any hour, resolution typically same day for routine issues, escalation path documented for outages.</li>
          <li><strong>Sales / billing</strong> — acknowledgement within 2 business hours during campus hours (Mon–Sat 10:00–18:00 IST). Sales follow-up same business day for inquiries above 10 machines.</li>
          <li><strong>Security disclosures</strong> — initial response within 24 hours, fix-or-mitigate plan within 5 business days. See <a href="/.well-known/security.txt">our security policy</a>.</li>
          <li><strong>Refund requests</strong> — see our <a href="/refund">cancellation and refund policy</a> for the exact timeline.</li>
          <li><strong>Free tier vs paid tier</strong> — 24/7 support is identical for both. We don't gatekeep operational help behind a paywall.</li>
        </ul>
      </article>

    </div>
  </section>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Base>

<style>
  .contact { padding: 24px 0 48px; }
  .contact article { margin-bottom: 64px; max-width: 760px; }
  .contact article:last-child { margin-bottom: 0; }

  /* ── Hero-of-the-page: two flagship contact cards side by side ── */
  .lead-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 72px;
  }
  .lead-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 28px 28px 24px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .lead-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-card);
  }
  .lead-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-3);
    margin-bottom: 14px;
  }
  .lead-h {
    display: block;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0 0 8px;
    transition: color 0.15s ease;
  }
  .lead-h:hover { color: var(--accent); }
  .lead-meta {
    color: var(--text-3);
    font-size: 13.5px;
    margin-bottom: 14px;
    font-family: var(--font-mono);
  }
  .lead-meta strong { color: var(--text-2); font-weight: 500; }
  .lead-body {
    color: var(--text-2);
    font-size: 14.5px;
    line-height: 1.6;
    margin: 0;
  }

  /* ── Section headings ─────────────────────────────────────────── */
  .contact h2 {
    font-family: var(--font-serif);
    font-size: 30px;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 0 0 14px;
    color: var(--text);
    text-wrap: balance;
  }
  .contact .article-lede {
    color: var(--text-3);
    font-size: 16px;
    line-height: 1.6;
    margin: 0 0 28px;
    max-width: 640px;
  }

  /* ── Routing grid ─────────────────────────────────────────────── */
  .routing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .route {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 22px 22px 20px;
    transition: border-color 0.15s ease;
  }
  .route:hover { border-color: var(--border-strong); }
  .route-h {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-3);
    margin-bottom: 8px;
  }
  .route a {
    color: var(--accent);
    font-weight: 500;
    font-size: 15px;
  }
  .route a:hover { color: var(--accent-strong); }
  .route p {
    color: var(--text-3);
    font-size: 14px;
    line-height: 1.6;
    margin: 8px 0 0;
  }
  .route p a { font-size: inherit; font-weight: 400; }

  /* ── Reused legal-style typography for body articles ──────────── */
  .contact p {
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.7;
    margin: 0 0 14px;
  }
  .contact p.muted {
    color: var(--text-3);
    font-size: 14px;
  }
  .contact strong { color: var(--text); font-weight: 500; }
  .contact a { color: var(--accent); }
  .contact a:hover { color: var(--accent-strong); }

  .bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .bullets li {
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.65;
    padding-left: 28px;
    position: relative;
  }
  .bullets li::before {
    content: "—";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--text-4);
    font-family: var(--font-mono);
  }
  .bullets a { color: var(--accent); }

  .contact-block {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 20px 24px;
    margin: 14px 0;
  }
  .contact-block p {
    margin: 0 0 6px;
    font-size: 14.5px;
  }
  .contact-block p:last-child { margin-bottom: 0; }

  @media (max-width: 820px) {
    .contact { padding: 32px 0 64px; }
    .contact article { margin-bottom: 20px; }
    .lead-grid { grid-template-columns: 1fr; gap: 16px; margin-bottom: 20px; }
    .lead-h { font-size: 22px; }
    .routing-grid { grid-template-columns: 1fr; gap: 14px; }
    .contact h2 { font-size: 24px; }
  }
</style>
