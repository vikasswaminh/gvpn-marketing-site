---
const faqs = [
  [
    {
      q: "How is this different from Tailscale?",
      a: "Tailscale needs its software on every device. We work with whatever WireGuard is already on your router — so you can mesh in branch routers, home routers, and even older hardware without installing anything. We also charge per machine, not per user, which is closer to how you'd actually count.",
      open: true,
    },
    {
      q: "Do I need to install software or replace anything?",
      a: "No. If your router supports WireGuard (most modern routers do), you paste the config we generate. The router does the rest. No firmware changes, no agent install.",
    },
    {
      q: "Is the encryption strong?",
      a: "Yes — it's standard WireGuard, the same protocol used by every major VPN service today. Your private keys never leave your device.",
    },
  ],
  [
    {
      q: "What happens if MeshWG goes down?",
      a: "Your tunnels keep working. WireGuard lives on your devices, not on our servers, so an outage on our side doesn't disconnect your branches.",
    },
    {
      q: "Can I self-host?",
      a: "Yes — the whole thing is open source under MIT. Run it on a $5/month VM and pay us nothing. Or use our hosted version and skip the setup entirely.",
    },
    {
      q: "Is this for businesses or homes?",
      a: "Both. A homelabber meshing their VPS, home network, and remote cabin uses it the same way a 20-branch retailer does. The product doesn't care what you call yourself.",
    },
  ],
];
---

<section id="faq" style="background: var(--bg-2);">
  <div class="wrap">
    <div class="sec-eyebrow">/ faq</div>
    <h2 class="sec-h">Straight answers.</h2>

    <div class="faq-grid">
      {faqs.map((col) => (
        <div>
          {col.map((f) => (
            <details open={f.open}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 56px;
    margin-top: 64px;
  }

  details {
    border-top: 1px solid var(--border);
    padding: 22px 0;
  }
  details:last-child {
    border-bottom: 1px solid var(--border);
  }

  summary {
    cursor: pointer;
    list-style: none;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -.005em;
    color: var(--text);
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: "+";
    font-family: var(--font-mono);
    font-size: 18px;
    color: var(--text-4);
    font-weight: 300;
    line-height: 1;
    transition: transform .2s ease;
  }
  details[open] summary::after { content: "−"; }
  details p {
    margin: 14px 0 0;
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.65;
  }

  @media (max-width: 980px) {
    .faq-grid { grid-template-columns: 1fr; gap: 0; }
  }
</style>
