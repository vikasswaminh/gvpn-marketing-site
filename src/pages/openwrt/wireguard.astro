<style>
  .guide { padding: 64px 0 128px; }
  .guide .wrap { display: grid; grid-template-columns: 220px 1fr; gap: 56px; align-items: start; }

  /* Sticky table of contents — helps both the reader and structured-data
     value because each H2 has an anchor target. */
  .toc {
    position: sticky;
    top: 100px;
    font-size: 13.5px;
  }
  .toc-h {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-3);
    margin-bottom: 14px;
  }
  .toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: tocnum;
  }
  .toc li {
    counter-increment: tocnum;
    padding: 8px 0 8px 26px;
    position: relative;
    border-bottom: 1px solid var(--border-faint);
    line-height: 1.45;
  }
  .toc li::before {
    content: counter(tocnum, decimal-leading-zero);
    position: absolute; left: 0; top: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-4);
  }
  .toc a { color: var(--text-2); transition: color 0.15s ease; }
  .toc a:hover { color: var(--accent); }

  /* Article body */
  article { max-width: 780px; }

  .guide h2 {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 56px 0 16px;
    color: var(--text);
    text-wrap: balance;
    scroll-margin-top: 100px;
  }
  .guide h2:first-child { margin-top: 0; }
  .guide h3 {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 24px 0 8px;
    color: var(--text);
  }
  .guide p {
    color: var(--text-2);
    font-size: 15.5px;
    line-height: 1.7;
    margin: 0 0 16px;
  }
  .guide strong { color: var(--text); font-weight: 600; }
  .guide a { color: var(--accent); }
  .guide a:hover { color: var(--accent-strong); }
  .guide code {
    font-family: var(--font-mono);
    font-size: .9em;
    background: var(--bg-2);
    padding: 1.5px 6px;
    border-radius: var(--radius-sm);
    color: var(--text);
  }
  .guide pre {
    background: var(--code-bg);
    color: var(--code-fg);
    padding: 18px 22px;
    border-radius: var(--radius-lg);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    margin: 20px 0;
  }
  .guide pre code { background: transparent; padding: 0; color: inherit; }

  .bullets, .numbered {
    list-style: none;
    padding: 0;
    margin: 16px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .bullets li, .numbered li {
    color: var(--text-2);
    font-size: 15.5px;
    line-height: 1.65;
    padding-left: 28px;
    position: relative;
    counter-increment: num;
  }
  .bullets li::before {
    content: "—";
    position: absolute; left: 0; top: 0;
    color: var(--text-4); font-family: var(--font-mono);
  }
  .numbered { counter-reset: num; }
  .numbered li::before {
    content: counter(num) ".";
    position: absolute; left: 0; top: 0;
    color: var(--text-4); font-family: var(--font-mono);
  }

  table.perf {
    width: 100%;
    border-collapse: collapse;
    margin: 18px 0 8px;
    font-size: 14px;
  }
  table.perf th, table.perf td {
    text-align: left;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  table.perf th {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-3);
    font-weight: 500;
    border-bottom: 1px solid var(--border-strong);
    background: var(--surface);
  }

  .faq-item { margin: 32px 0; }
  .faq-item h3 {
    font-size: 17px;
    margin-bottom: 10px;
  }

  .next {
    margin-top: 64px;
