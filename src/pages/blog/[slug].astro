---
import { getCollection } from 'astro:content';
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import BlogLayout from "../../layouts/BlogLayout.astro";
import "../../styles/meshwg-blog.css";

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const title = post.data.title;
const description = post.data.description;
const pubDate = new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const readMinutes = Math.ceil((post.body ? post.body.split(/\s+/).length : 5000) / 200);
---

<Base title={title} description={description}>
  <Nav />
  
  <BlogLayout isHomepage={false}>
    <article class="blog-article">
        <nav aria-label="Breadcrumb" class="breadcrumbs" style="font-size: 13px; color: #475569; margin-bottom: 24px;">
          <a href="/" style="color: #475569; text-decoration: none;">Home</a> <span style="margin: 0 8px;">/</span>
          <a href="/blog/" style="color: #475569; text-decoration: none;">Blog</a> <span style="margin: 0 8px;">/</span>
          <span style="color: #0f172a; font-weight: 500;">{title}</span>
        </nav>
        <header class="post-header">
          <div class="post-meta-top">
            {post.data.tags && post.data.tags.length > 0 && (
              <>
                <span class={post.data.tags.includes('strategy guide') ? 'mag-pill pill-purple' : 'mag-pill pill-orange'} style="font-size: 11px; padding: 4px 12px; border-radius: 100px; font-weight: 700; text-transform: uppercase;">
                  {post.data.tags.includes('strategy guide') ? 'STRATEGY & ARCHITECTURE' : 'ENGINEERING GUIDE'}
                </span>
                <span class="meta-dot">•</span>
              </>
            )}
            <span class="meta-date">{post.data.pubDate.toISOString().split('T')[0]}</span>
            <span class="meta-dot">•</span>
            <span class="meta-read">{readMinutes} MIN READ</span>
          </div>
          <h1 class="post-h1">{title}</h1>
          {description && <p class="post-desc">{description}</p>}
        </header>
        
        <div class="post-author-row">
          <div class="author-block">
            <div class="author-avatar" style="background: #FFF7ED; color: #c2410c;" aria-hidden="true">⚡</div>
            <div class="author-info">
              <div class="author-name">{post.data.author || 'MeshWG Technical Architecture Group'}</div>
              <div class="author-role">Network Architecture</div>
            </div>
          </div>
          
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="post-tags">
              {post.data.tags.map(tag => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
          )}
        </div>
      
        <div class="prose">
          <Content />
        </div>
        
        <div class="author-bio-box">
          <div class="author-bio-avatar" aria-hidden="true">ME</div>
          <div class="author-bio-content">
            <div class="author-bio-title">Written by <strong>{post.data.author || 'MeshWG Technical Architecture Group'}</strong></div>
            <p class="author-bio-desc">Our core networking team specializes in zero-trust architecture, multi-cloud SD-WANs, and high-performance kernel VPNs. We build <a href="https://meshwg.com">MeshWG</a> to simplify enterprise WireGuard orchestration.</p>
          </div>
        </div>
    </article>
  </BlogLayout>

  <Footer />
</Base>

<style is:global>
  .mag-pill-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .mag-pill {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 99px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 1;
    white-space: nowrap;
    width: max-content;
  }
  .pill-orange { background: #F97316; color: #fff; }
  .pill-purple { background: #8B5CF6; color: #fff; }
  .mag-h1 {
    font-family: var(--font-heading);
    color: var(--text);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .mag-desc {
    font-family: var(--font-body);
  }

  .blog-article {
    max-width: 900px;
    width: 100%;
    min-width: 0;
    margin: 0 auto;
    overflow-wrap: break-word;
    word-break: break-word;
  }
</style>
