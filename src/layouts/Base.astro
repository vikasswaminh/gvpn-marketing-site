---
import "../styles/tokens.css";

interface Props {
  title: string;
  description?: string;
  /** Override the auto-derived canonical URL. Use for paginated views,
   *  alternate-language variants, or pages canonicalising to another. */
  canonical?: string;
  /** OG type: "website" for landing pages, "article" for pillar/blog content. */
  ogType?: "website" | "article";
  /** OG image URL (absolute). Defaults to the favicon as a graceful fallback;
   *  individual pages should override with a per-page social card when one exists. */
  ogImage?: string;
  /** Article-only: ISO date the page was first published. */
  publishedTime?: string;
  /** Article-only: ISO date the page was last meaningfully edited. */
  modifiedTime?: string;
}

const {
  title,
  description = "Hosted SDWAN + ZTNA on standard WireGuard. Mesh the routers, laptops, and servers you already own — two machines free, forever.",
  canonical,
  ogType = "website",
  ogImage = "https://meshwg.com/favicon.svg",
  publishedTime,
  modifiedTime,
} = Astro.props;

import { ViewTransitions } from "astro:transitions";

// Astro.site is set in astro.config.mjs to https://meshwg.com so this
// always produces an absolute canonical even for nested routes.
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site ?? "https://meshwg.com/").href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <ViewTransitions />

  {/* Canonical — every page declares its own absolute URL so duplicate
       parameter variants (e.g. utm_*) consolidate ranking signals. */}
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content="index, follow, max-image-preview:large" />

  {/* Open Graph (honest defaults) */}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="MeshWG" />
  <meta property="og:locale" content="en_US" />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

  {/* Twitter — Summary Large Image is the right card for pillar content;
       the description re-uses the meta description. */}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Fonts: Lato + Geist Mono.
       Lato for everything (body + display + UI); Geist Mono for code,
       eyebrows, and any tabular data where proportional rendering breaks
       alignment. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Lato:wght@300;400;700;900&display=swap" rel="stylesheet" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <script
    defer
    data-domain="meshwg.com"
    data-api="/p/event"
    src="/p/script.js"
  ></script>

  {/* Canonical Organization schema. Every page's @id references this via
     https://meshwg.com/#organization — declared here once so the link
     actually resolves for crawlers and AEO. Includes the address +
     phone line so direct knowledge-graph queries ("MeshWG phone number")
     return real data instead of being inferred from the page. */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://meshwg.com/#organization",
    "name": "MeshWG",
    "url": "https://meshwg.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://meshwg.com/favicon.svg"
    },
    "description": "Hosted mesh VPN + zero-trust network access service built on standard WireGuard. Turns the routers, laptops, and servers an SMB already owns into a single private network — no SDWAN appliance needed.",
    "telephone": "+91-9611027980",
    "email": "hello@meshwg.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "L-149, Sector 6, HSR Layout",
      "addressLocality": "Bengaluru",
      "addressRegion": "Karnataka",
      "postalCode": "560102",
      "addressCountry": "IN"
    },
    "contactPoint": [
      {
        "@type": "ContactPoint",
        "contactType": "customer support",
        "email": "support@meshwg.com",
        "areaServed": "Worldwide",
        "availableLanguage": ["en", "hi"],
        "hoursAvailable": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "opens": "00:00",
          "closes": "23:59"
        }
      },
      {
        "@type": "ContactPoint",
        "telephone": "+91-9611027980",
        "contactType": "sales",
        "email": "hello@meshwg.com",
        "areaServed": "IN",
        "availableLanguage": ["en", "hi"],
        "hoursAvailable": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
          "opens": "10:00",
          "closes": "18:00"
        }
      },
      {
        "@type": "ContactPoint",
        "contactType": "technical support",
        "email": "security@meshwg.com",
        "url": "https://meshwg.com/.well-known/security.txt",
        "areaServed": "Worldwide"
      },
      {
        "@type": "ContactPoint",
        "contactType": "Grievance Officer",
        "email": "amit@meshwg.com",
        "areaServed": "IN"
      },
      {
        "@type": "ContactPoint",
        "contactType": "HR",
        "email": "careers@meshwg.com",
        "areaServed": "IN"
      }
    ]
  })} />
  <style is:inline>
    [data-reveal-delay="400"] { transition-delay: 400ms; }
    [data-reveal-delay="500"] { transition-delay: 500ms; }

    /* 3D Tilt Base Styles */
    [data-tilt] {
      transform: perspective(1200px) rotateX(var(--rotateX, 0deg)) rotateY(var(--rotateY, 0deg)) translateY(var(--tilt-y, 0)) scale(var(--tilt-scale, 1));
      transform-style: preserve-3d;
      will-change: transform;
    }
    [data-tilt]:not(:hover) {
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.5s ease;
    }
    [data-tilt]:hover {
      transition: transform 0.1s ease-out, box-shadow 0.1s ease-out, border-color 0.1s ease;
      --tilt-y: -4px;
      --tilt-scale: 1.01;
      z-index: 10;
    }
    [data-tilt]:active {
      --tilt-y: -1px;
      --tilt-scale: 1;
    }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal] {
        transition: none !important;
        opacity: 1 !important;
        transform: none !important;
      }
      [data-tilt] {
        transform: none !important;
        transition: none !important;
      }
    }
  </style>
</head>
<body>
  <slot />

  <!-- ── Ambient motion: scroll-reveal sections + frosted-nav-on-scroll
       Tiny vanilla JS, no framework. Both effects respect
       prefers-reduced-motion via the CSS in tokens.css and Nav.astro.
       Set `js-reveal` on <html> only after this script runs so users
       without JS see fully-visible sections immediately. -->
  <script is:inline>
    document.addEventListener('astro:page-load', function () {
      try {
        document.documentElement.classList.add('js-reveal');

        // Scroll-reveal sections
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add('in-view');
                io.unobserve(e.target);
              }
            });
          }, { threshold: 0.08, rootMargin: '0px 0px -8% 0px' });
          document.querySelectorAll('section').forEach(function (s) { io.observe(s); });
          document.querySelectorAll('[data-reveal]').forEach((el) => {
            io.observe(el);
          });
        } else {
          // No IO: reveal everything immediately as a graceful fallback.
          document.querySelectorAll('section').forEach(function (s) { s.classList.add('in-view'); });
        }

        // 3D Tilt Animation Logic
        document.querySelectorAll('[data-tilt]').forEach(el => {
          el.addEventListener('mousemove', (e) => {
            const rect = el.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            
            // Max tilt angle: 6 degrees for a subtle, premium feel
            const rotateX = ((y - centerY) / centerY) * -6; 
            const rotateY = ((x - centerX) / centerX) * 6;
            
            el.style.setProperty('--rotateX', `${rotateX}deg`);
            el.style.setProperty('--rotateY', `${rotateY}deg`);
          });
          
          el.addEventListener('mouseleave', () => {
            el.style.setProperty('--rotateX', '0deg');
            el.style.setProperty('--rotateY', '0deg');
          });
        });

        // Frosted-nav-on-scroll
        var nav = document.querySelector('.nav');
        if (nav) {
          var onScroll = function () {
            if (window.scrollY > 60) nav.classList.add('nav--scrolled');
            else nav.classList.remove('nav--scrolled');
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        }
      } catch (_) { /* fail open — better visible than broken */ }
    });
  </script>
</body>
</html>
