---
const steps = [
  {
    num: "01",
    title: "Sign up",
    body: "Create your account with Google or email. No credit card. You're in the dashboard in under a minute.",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    num: "02",
    title: "Add your devices",
    body: "Click Add machine, give it a name, and paste the WireGuard config we generate into your router or laptop. The tunnel comes up immediately.",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/><line x1="7" y1="8" x2="17" y2="8"/><line x1="7" y1="12" x2="13" y2="12"/></svg>`,
  },
  {
    num: "03",
    title: "Set who reaches what",
    body: "Allow or deny traffic between any two machines in one click — site-to-site, user-to-server, by app or by port. Changes apply in real time.",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>`,
  },
];
---

<section id="how">
  <div class="how-grid-bg"></div>
  <div class="wrap">
    <div class="sec-eyebrow">/ how it works</div>
    <h2 class="sec-h">From unboxed to fully meshed in <span class="blue">2 minutes.</span></h2>
    <p class="sec-lede">
      No firmware changes. No agent install on every device. No
      certificates to manage. The hardware you have is the hardware
      you use.
    </p>

    <div class="how-steps">
      {steps.map((s, i) => (
        <>
          <article class="step-card">
            <div class="step-head">
              <div class="step-icon" set:html={s.icon} />
              <span class="step-num">{s.num}</span>
            </div>
            <h3 class="step-title">{s.title}</h3>
            <p class="step-body">{s.body}</p>
          </article>
          {i < steps.length - 1 && (
            <div class="step-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </div>
          )}
        </>
      ))}
    </div>

    <div class="how-cta">
      <a class="btn" href="/quickstart">Full setup guide — with vendor-specific steps →</a>
    </div>
  </div>
</section>

<style>
  #how {
    padding: 64px 0 16px;
    position: relative;
    overflow: hidden;
  }
  .how-grid-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(rgba(37, 99, 235, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(37, 99, 235, 0.06) 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: center top;
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 30%, transparent 100%);
            mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 30%, transparent 100%);
  }
  #how .sec-h, #how .sec-lede {
    text-wrap: unset;
    max-width: none;
  }
  #how .sec-h .blue {
    color: #2563EB;
  }

  /* ── Step cards row ──────────────────────────────── */
  .how-steps {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: stretch;
    gap: 0;
    margin-top: 48px;
  }

  .step-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: #ffffff;
    border: 2px solid #1a1a1a;
    border-radius: 12px;
    padding: 32px 28px 36px;
    position: relative;
    box-shadow: 6px 6px 0px #1a1a1a;
    transition: all 0.2s ease;
  }
  .step-card:hover {
    background: #ffffff;
    border-color: #1a1a1a;
    box-shadow: 8px 8px 0px #1a1a1a;
    transform: translate(-2px, -2px);
  }

  .step-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .step-icon {
    width: 48px;
    height: 48px;
    background: #1a1a1a;
    border-radius: 12px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .step-icon :global(svg) {
    stroke: #ffffff !important;
  }

  .step-num {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: #2563EB;
    background: #EFF6FF;
    padding: 2px 10px;
    border-radius: 20px;
    letter-spacing: 0.05em;
  }

  .step-title {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 12px;
    color: var(--text);
    line-height: 1.2;
  }

  .step-body {
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.65;
    margin: 0;
    font-weight: 400;
  }

  /* ── Arrow connector between cards ───────────────── */
  .step-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    flex-shrink: 0;
  }
  .step-arrow svg {
    background: #EFF6FF;
    border-radius: 50%;
    padding: 6px;
    width: 32px;
    height: 32px;
  }

  .how-cta {
    margin-top: 48px;
    display: flex;
    justify-content: center;
  }
  .how-cta .btn {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .how-cta .btn:hover { color: var(--accent-strong); }

  @media (max-width: 980px) {
    .how-steps {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .step-arrow {
      transform: rotate(90deg);
      justify-self: center;
    }
  }
</style>
