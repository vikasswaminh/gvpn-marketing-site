---
import { site } from "../site";

// Hero content is preserved verbatim from the prior version — only the
// visual presentation changes here.
const heroChecks = [
  "2 machines free, forever",
  "Setup in under 2 minutes",
  "Works with any WireGuard router",
  "No new hardware to buy",
];

// Vendor nodes orbit the acid hub in the right-column mesh diagram.
// Order influences orbital position (top-clockwise from 12 o'clock).
const meshNodes = [
  { tag: "TP", label: "TP-Link"  },
  { tag: "MT", label: "MikroTik" },
  { tag: "OW", label: "OpenWrt"  },
  { tag: "UB", label: "Ubiquiti" },
  { tag: "OP", label: "OPNsense" },
];
---

<section class="hero">
  <div class="wrap hero-inner">

    <!-- ── Left column: editorial headline + CTAs + meta ───────── -->
    <div class="hero-left">
      <span class="eyebrow">
        <span class="pill">live</span>
        <span class="eyebrow-text">one platform · mesh vpn + zero trust access</span>
      </span>

      <h1 class="h1">
        Turn the routers <em class="it">you already own</em>
        into a secure mesh network.
      </h1>

      <p class="lede">
        Connect your branches, your home, and your team —
        without buying <b>₹2 lakh SDWAN boxes</b>. MeshWG is a hosted
        mesh service that works with the TP-Link, MikroTik, OpenWrt,
        and Ubiquiti hardware already in your rack.
      </p>

      <div class="hero-cta">
        <a class="btn btn-acid btn-lg" href={site.signupFree}>
          Sign up free
          <svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <a class="btn btn-line btn-lg" href={site.proContact}>
          Talk to us — Pro
        </a>
      </div>

      <div class="hero-meta">
        {heroChecks.map((label) => (
          <span>
            <span class="tick">
              <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
            </span>
            {label}
          </span>
        ))}
      </div>
    </div>

    <!-- ── Right column: animated mesh diagram ─────────────────── -->
    <div class="hero-right" aria-hidden="true">
      <div class="mesh-stage">

        <!-- HUD: top edge labels -->
        <div class="mesh-hud">
          <span>mesh · live</span>
          <span class="live">5 peers up</span>
        </div>

        <!-- Connection lines + animated flow paths (SVG layer) -->
        <svg class="mesh-svg" viewBox="0 0 500 500" preserveAspectRatio="xMidYMid meet">
          <defs>
            <linearGradient id="hub-glow" cx="50%" cy="50%" r="50%">
              <stop offset="0%"  stop-color="#c5f23a" stop-opacity="0.4"/>
              <stop offset="60%" stop-color="#c5f23a" stop-opacity="0"/>
            </linearGradient>
          </defs>
          <!-- Static connection backbone (5 spokes hub→node) -->
          <line class="mesh-line" x1="250" y1="250" x2="250" y2="90"/>
          <line class="mesh-line" x1="250" y1="250" x2="402" y2="174"/>
          <line class="mesh-line" x1="250" y1="250" x2="346" y2="402"/>
          <line class="mesh-line" x1="250" y1="250" x2="154" y2="402"/>
          <line class="mesh-line" x1="250" y1="250" x2="98" y2="174"/>
          <!-- Animated dashed flow paths (3 spokes carry traffic on different timings) -->
          <line class="mesh-flow a" x1="250" y1="250" x2="250" y2="90"/>
          <line class="mesh-flow b" x1="250" y1="250" x2="346" y2="402"/>
          <line class="mesh-flow c" x1="250" y1="250" x2="98"  y2="174"/>
        </svg>

        <!-- Hub node (acid, pulsing rings) -->
        <div class="mesh-node hub" style="left:50%; top:50%;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="6" r="1.8"/>
            <circle cx="6"  cy="14" r="1.8"/>
            <circle cx="18" cy="14" r="1.8"/>
            <circle cx="12" cy="20" r="1.5"/>
            <path d="M12 8 L6 14 M12 8 L18 14 M6 14 L12 20 M18 14 L12 20 M6 14 L18 14"/>
          </svg>
        </div>

        <!-- 5 vendor nodes around the hub -->
        {meshNodes.map((n, i) => {
          // 5 positions on a circle of radius 32% from center, starting at top
          const positions = [
            { left: "50%",   top: "18%"  },
            { left: "80.4%", top: "34.8%" },
            { left: "69.2%", top: "80.4%" },
            { left: "30.8%", top: "80.4%" },
            { left: "19.6%", top: "34.8%" },
          ];
          const p = positions[i];
          return (
            <div class="mesh-node" style={`left:${p.left}; top:${p.top};`}>
              <span class="vtag">{n.tag}</span>
              <span class="vname">{n.label}</span>
            </div>
          );
        })}

        <!-- Foot: 3 stat cells -->
        <div class="mesh-foot">
          <div>
            <div class="lbl">latency</div>
            <div class="val">12 ms</div>
          </div>
          <div>
            <div class="lbl">tunnels</div>
            <div class="val">5 / 5</div>
          </div>
          <div>
            <div class="lbl">status</div>
            <div class="val ok">online</div>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  /* ── Hero canvas ─────────────────────────────────────────────── */
  .hero {
    padding: 168px 0 96px;
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  /* Acid glow top-right and ember glow bottom-left — two large
     radial-gradients giving the dark canvas its editorial atmosphere. */
  .hero::before {
    content: "";
    position: absolute;
    top: -100px; right: -200px;
    width: 900px; height: 900px;
    z-index: -1;
    background: radial-gradient(circle, var(--accent-soft) 0%, transparent 55%);
    pointer-events: none;
  }
  .hero::after {
    content: "";
    position: absolute;
    bottom: -200px; left: -200px;
    width: 700px; height: 700px;
    z-index: -1;
    background: radial-gradient(circle, rgba(255, 122, 69, 0.08) 0%, transparent 55%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
  }
  .hero-left { position: relative; z-index: 2; }

  /* ── Eyebrow pill (mono uppercase + live indicator) ──────────── */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 12px 7px 8px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    margin-bottom: 32px;
  }
  .eyebrow .pill {
    background: var(--accent);
    color: var(--bg);
    padding: 3px 7px;
    border-radius: var(--radius-pill);
    font: 600 10px/1 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .eyebrow-text {
    font: 500 11.5px/1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-2);
  }

  /* ── Editorial H1 ─────────────────────────────────────────────
     Instrument Serif, very large, italic emphasis on the
     'you already own' span. The rest of the headline stays in the
     cream foreground. */
  .h1 {
    font-family: var(--font-serif);
    font-size: clamp(56px, 7.4vw, 108px);
    line-height: 0.96;
    letter-spacing: -0.025em;
    font-weight: 400;
    margin: 0 0 28px;
    text-wrap: balance;
    color: var(--text);
  }
  .h1 .it {
    font-style: italic;
    color: var(--accent);
  }

  /* ── Lede ─────────────────────────────────────────────────────── */
  .lede {
    font-size: 18px;
    color: var(--text-2);
    max-width: 520px;
    line-height: 1.55;
    text-wrap: pretty;
    font-weight: 300;
    margin: 0;
  }
  .lede b { color: var(--text); font-weight: 500; }

  /* ── CTAs row ────────────────────────────────────────────────── */
  .hero-cta {
    display: flex;
    gap: 8px;
    margin-top: 36px;
    align-items: center;
    flex-wrap: wrap;
  }
  /* Acid CTA gets a soft halo + 3.6s pulse (matches the prior pass) */
  .hero-cta .btn-acid {
    position: relative;
    box-shadow:
      0 0 0 4px color-mix(in oklab, var(--accent) 8%, transparent),
      0 0 24px color-mix(in oklab, var(--accent) 30%, transparent),
      0 6px 18px color-mix(in oklab, var(--accent) 22%, transparent);
    transition: box-shadow 0.25s ease, transform 0.15s ease;
    animation: hero-cta-pulse 3.6s ease-in-out infinite;
  }
  .hero-cta .btn-acid:hover {
    transform: translateY(-1px);
    box-shadow:
      0 0 0 5px color-mix(in oklab, var(--accent) 12%, transparent),
      0 0 36px color-mix(in oklab, var(--accent) 45%, transparent),
      0 10px 28px color-mix(in oklab, var(--accent) 30%, transparent);
  }
  @keyframes hero-cta-pulse {
    0%, 100% { box-shadow:
      0 0 0 4px color-mix(in oklab, var(--accent) 8%, transparent),
      0 0 24px color-mix(in oklab, var(--accent) 30%, transparent),
      0 6px 18px color-mix(in oklab, var(--accent) 22%, transparent); }
    50% { box-shadow:
      0 0 0 4px color-mix(in oklab, var(--accent) 12%, transparent),
      0 0 32px color-mix(in oklab, var(--accent) 40%, transparent),
      0 6px 18px color-mix(in oklab, var(--accent) 26%, transparent); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-cta .btn-acid { animation: none; }
  }

  /* ── Hero meta row (mono uppercase + acid ticks) ─────────────── */
  .hero-meta {
    display: flex;
    gap: 28px;
    margin-top: 56px;
    font: 500 11.5px/1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-3);
    flex-wrap: wrap;
  }
  .hero-meta span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hero-meta .tick {
    width: 14px; height: 14px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--bg);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  /* ── Right column: animated mesh stage ───────────────────────── */
  .hero-right {
    position: relative;
    aspect-ratio: 1 / 1;
    max-width: 580px;
    justify-self: end;
    width: 100%;
  }
  .mesh-stage {
    position: relative;
    width: 100%; height: 100%;
    border-radius: 24px;
    border: 1px solid var(--border);
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 50%, rgba(197, 242, 58, 0.06), transparent 65%),
      linear-gradient(180deg, var(--bg-2), var(--bg));
  }
  /* subtle grid lines, masked to a soft circle in the middle */
  .mesh-stage::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 40px 40px;
    -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 50%, transparent 75%);
            mask-image: radial-gradient(circle at 50% 50%, #000 50%, transparent 75%);
  }

  .mesh-hud {
    position: absolute;
    left: 18px; right: 18px;
    top: 18px;
    display: flex;
    justify-content: space-between;
    font: 500 10.5px/1 var(--font-mono);
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    z-index: 2;
  }
  .mesh-hud .live {
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .mesh-hud .live::before {
    content: "";
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: mesh-blink 1.4s ease-in-out infinite;
  }
  @keyframes mesh-blink { 50% { opacity: 0.25; } }

  /* SVG layer (lines + animated dashed flow) */
  .mesh-svg {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
  }
  .mesh-line {
    stroke: var(--text-4);
    stroke-width: 1;
    opacity: 0.35;
    fill: none;
  }
  .mesh-flow {
    stroke: var(--accent);
    stroke-width: 1.4;
    fill: none;
    stroke-dasharray: 4 6;
  }
  @keyframes mesh-flow-dash { to { stroke-dashoffset: -200; } }
  .mesh-flow.a { animation: mesh-flow-dash 2.4s linear infinite; }
  .mesh-flow.b { animation: mesh-flow-dash 3.2s linear infinite; opacity: 0.7; }
  .mesh-flow.c { animation: mesh-flow-dash 2.8s linear infinite reverse; opacity: 0.85; }
  @media (prefers-reduced-motion: reduce) {
    .mesh-flow { animation: none !important; }
  }

  /* Nodes */
  .mesh-node {
    position: absolute;
    width: 56px; height: 56px;
    border-radius: 12px;
    background: var(--bg-2);
    border: 1px solid var(--border-strong);
    display: grid;
    place-items: center;
    color: var(--text);
    box-shadow: var(--shadow-card);
    transform: translate(-50%, -50%);
    z-index: 3;
  }
  .mesh-node .vtag {
    font: 600 12px/1 var(--font-mono);
    color: var(--text);
    letter-spacing: 0.02em;
  }
  .mesh-node .vname {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 8px;
    font: 500 10.5px/1 var(--font-mono);
    color: var(--text-2);
    white-space: nowrap;
  }
  .mesh-node.hub {
    width: 72px; height: 72px;
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
    box-shadow:
      0 0 0 6px rgba(197, 242, 58, 0.12),
      0 0 60px var(--accent-glow);
    z-index: 4;
  }
  /* Pulsing ring around the hub */
  .mesh-node.hub::before {
    content: "";
    position: absolute;
    inset: -10px;
    border-radius: 18px;
    border: 1px solid var(--accent);
    opacity: 0.4;
    animation: mesh-hub-pulse 2.6s ease-out infinite;
  }
  @keyframes mesh-hub-pulse {
    0%   { transform: scale(0.9); opacity: 0.6; }
    100% { transform: scale(1.6); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mesh-node.hub::before { animation: none; }
  }

  /* Foot: stat cells */
  .mesh-foot {
    position: absolute;
    left: 18px; right: 18px;
    bottom: 18px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    z-index: 2;
  }
  .mesh-foot > div {
    background: rgba(11, 11, 12, 0.92);
    padding: 10px 12px;
  }
  .mesh-foot .lbl {
    font: 500 9.5px/1 var(--font-mono);
    color: var(--text-4);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 6px;
  }
  .mesh-foot .val {
    font: 500 14px/1 var(--font-mono);
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .mesh-foot .val.ok { color: var(--accent); }

  /* ── Responsive ──────────────────────────────────────────────── */
  @media (max-width: 980px) {
    .hero { padding: 110px 0 64px; }
    .hero-inner { grid-template-columns: 1fr; gap: 64px; }
    .hero-right { justify-self: stretch; max-width: 100%; }
    .h1 { font-size: clamp(44px, 12vw, 64px); }
    .lede { font-size: 16px; }
    .hero-meta { gap: 14px 22px; margin-top: 40px; font-size: 10.5px; }
  }
</style>
