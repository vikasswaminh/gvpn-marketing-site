---
import BrandMark from "./BrandMark.astro";
import { site } from "../site";

const currentPath = Astro.url.pathname;
---
<header class="site-header">
  <div class="announcement" role="region" aria-label="Announcement">
    <div class="wrap announcement-inner">
      <span class="announcement-text">
        <span class="badge">NEW</span>
        Self-serve signup is live. Free for 2 machines, forever. ₹349/machine/month after.
      </span>
      <a href="/pricing" class="announcement-link" aria-label="See pricing details">See pricing &rarr;</a>
    </div>
  </div>

  <nav class="nav" aria-label="Main Navigation">
    <div class="wrap nav-inner">
      <a class="brand" href="/" aria-label="MeshWG Home">
        <BrandMark />
        <span class="brand-name">{site.productName}</span>
      </a>
      <div class="nav-links">
        <a href="/quickstart" class={currentPath.startsWith('/quickstart') ? 'active' : ''}>Quickstart</a>
        <a href="/docs" class={currentPath.startsWith('/docs') ? 'active' : ''}>Docs</a>
        <a href="/compatibility" class={currentPath.startsWith('/compatibility') ? 'active' : ''}>Compatibility</a>
        <a href="/blog" class={currentPath.startsWith('/blog') ? 'active' : ''}>Blog</a>
        <a href="/pricing" class={currentPath.startsWith('/pricing') ? 'active' : ''}>Pricing</a>
      </div>
      <div class="nav-spacer"></div>
      <div class="nav-cta">
        <a class="btn btn-ghost" href={site.signIn}>Sign in</a>
        <a class="btn btn-primary" href={site.signupFree}>Sign up free</a>
      </div>
      <button class="mobile-menu-btn" aria-label="Toggle mobile menu" aria-expanded="false" id="mobile-menu-btn">
        <svg class="icon-menu" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
  </nav>

  <div class="mobile-nav" id="mobile-nav">
    <div class="mobile-nav-inner">
      <a href="/quickstart" class={currentPath.startsWith('/quickstart') ? 'active' : ''}>Quickstart</a>
      <a href="/docs" class={currentPath.startsWith('/docs') ? 'active' : ''}>Docs</a>
      <a href="/compatibility" class={currentPath.startsWith('/compatibility') ? 'active' : ''}>Compatibility</a>
      <a href="/blog" class={currentPath.startsWith('/blog') ? 'active' : ''}>Blog</a>
      <a href="/pricing" class={currentPath.startsWith('/pricing') ? 'active' : ''}>Pricing</a>
      <div class="mobile-nav-divider"></div>
      <a href={site.signIn}>Sign in</a>
      <a href={site.signupFree} class="mobile-nav-primary">Sign up free</a>
    </div>
  </div>
</header>

<style>
  .announcement {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 101;
    background: var(--brand-red-2); /* Improved contrast */
    color: #ffffff;
    height: 40px;
  }
  .announcement-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 15px; /* Increased for better visibility */
    font-weight: 500;
  }
  .announcement-text {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .announcement .badge {
    background: #ffffff;
    color: var(--brand-red-2); /* Matching improved contrast */
    font: 700 10.5px/1 var(--font-sans);
    padding: 3px 6px;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .announcement-link {
    color: #ffffff;
    font-weight: 700; /* Made slightly bolder to stand out */
    font-size: 16px; /* Increased size as requested */
    transition: opacity 0.15s ease;
  }
  .announcement-link:hover {
    opacity: 0.8;
  }
  @media (max-width: 980px) {
    .announcement { display: none; }
  }

  /* Fixed nav. Top-of-page: nearly transparent; on scroll past 60 px the
     IntersectionObserver in Base.astro adds .nav--scrolled and the bar
     becomes frosted white with a subtle hairline border. */
  .nav {
    position: fixed;
    top: 40px; left: 0; right: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.6);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
            backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-bottom-color 0.25s ease, background 0.25s ease;
  }
  @media (max-width: 980px) {
    .nav { top: 0; }
  }
  
  .nav--scrolled {
    background: rgba(255, 255, 255, 0.6);
    -webkit-backdrop-filter: saturate(180%) blur(24px);
            backdrop-filter: saturate(180%) blur(24px);
    border-bottom-color: rgba(0, 0, 0, 0.04);
    box-shadow: var(--shadow-soft);
  }

  .nav-inner {
    height: 64px;
    display: flex;
    align-items: center;
    gap: 36px;
  }

  .brand {
    display: flex; align-items: center; gap: 10px;
    font-weight: 600; /* Made slightly bolder */
    letter-spacing: -0.01em;
    font-size: 18px; /* Increased from 15px */
    color: var(--text);
  }
  .brand-name { color: var(--text); }

  .nav-links {
    display: flex;
    gap: 26px;
    font-size: 15px; /* Increased from 13px */
    color: #000000; /* Made purely black */
  }
  .nav-links a {
    position: relative;
    padding: 4px 0;
    color: #000000; /* Ensure links are black */
    transition: color 0.15s ease;
  }
  .nav-links a::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s cubic-bezier(0.6, 0.05, 0.2, 1);
  }
  .nav-links a:hover { color: var(--text); }
  .nav-links a:hover::after { transform: scaleX(1); }
  .nav-links a.active { color: var(--text); font-weight: 500; }
  .nav-links a.active::after { transform: scaleX(1); }

  .nav-spacer { flex: 1; }
  .nav-cta { display: flex; gap: 6px; align-items: center; }
  
  .nav-cta .btn {
    font-size: 15px; /* Increased to match nav links */
  }
  
  /* Make Sign in button a darker black color */
  .nav-cta .btn-ghost {
    color: #000000;
    font-weight: 600;
  }
  .nav-cta .btn-ghost:hover {
    color: #2563EB; /* MeshWG blue on hover for better UX */
  }

  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text);
    padding: 8px;
    margin-right: -8px;
  }
  
  .mobile-nav {
    display: none;
  }

  @media (max-width: 980px) {
    .nav-links { display: none; }
    .nav-inner { gap: 16px; justify-content: space-between; }
    .nav-cta { display: none; }
    .nav-spacer { display: none; }
    
    .mobile-menu-btn {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .mobile-nav {
      display: block;
      position: fixed;
      top: 64px; /* below nav */
      left: 0; right: 0; height: calc(100vh - 64px);
      background: #ffffff;
      z-index: 99;
      transform: translateY(-100%);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.3s ease, opacity 0.3s ease;
      overflow-y: auto;
    }
    
    .mobile-nav.is-open {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }
    
    .mobile-nav-inner {
      display: flex;
      flex-direction: column;
      padding: 32px 24px;
      gap: 24px;
    }
    
    .mobile-nav-inner a {
      font-size: 18px;
      font-weight: 500;
      color: var(--text);
      text-decoration: none;
    }
    
    .mobile-nav-inner a.active {
      color: var(--accent);
    }
    
    .mobile-nav-divider {
      height: 1px;
      background: #eaeaea;
      margin: 8px 0;
    }
    
    .mobile-nav-primary {
      color: #2563EB !important;
      font-weight: 600 !important;
    }
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const nav = document.getElementById('mobile-nav');
  const iconMenu = btn?.querySelector('.icon-menu') as HTMLElement;
  const iconClose = btn?.querySelector('.icon-close') as HTMLElement;
  
  if (btn && nav) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
      nav.classList.toggle('is-open');
      
      if (iconMenu && iconClose) {
        if (!isExpanded) {
          iconMenu.style.display = 'none';
          iconClose.style.display = 'block';
        } else {
          iconMenu.style.display = 'block';
          iconClose.style.display = 'none';
        }
      }
    });
  }
</script>
