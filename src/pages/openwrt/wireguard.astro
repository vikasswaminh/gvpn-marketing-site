  "publisher": { "@type": "Organization", "@id": "https://meshwg.com/#organization" },
  "image": "https://meshwg.com/favicon.svg",
  "keywords": [
    "OpenWrt WireGuard", "openwrt wireguard", "wireguard openwrt",
    "openwrt wireguard luci", "openwrt wireguard setup",
    "openwrt site to site vpn", "openwrt mesh vpn"
  ],
  "isAccessibleForFree": true,
  "inLanguage": "en"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question", "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "Set up WireGuard on OpenWrt with LuCI",
  "totalTime": "PT10M",
  "estimatedCost": { "@type": "MonetaryAmount", "currency": "USD", "value": "0" },
  "tool": [{ "@type": "HowToTool", "name": "OpenWrt 19.07 or later router" }],
  "step": [
    { "@type": "HowToStep", "name": "SSH to the router", "text": "Connect to your OpenWrt router by SSH on its LAN address (typically root@192.168.1.1)." },
    { "@type": "HowToStep", "name": "Install the WireGuard packages", "text": "Run `opkg update && opkg install wireguard-tools luci-app-wireguard kmod-wireguard`. On most modern OpenWrt builds the kernel module is already present." },
    { "@type": "HowToStep", "name": "Generate keys", "text": "Run `wg genkey | tee privatekey | wg pubkey > publickey` to create the local keypair. Repeat on the peer device." },
    { "@type": "HowToStep", "name": "Add the WireGuard interface in LuCI", "text": "In Network → Interfaces → Add new interface, name the interface wg0, choose 'WireGuard VPN' as protocol, paste in the private key, set listen-port and IP address." },
    { "@type": "HowToStep", "name": "Add the peer", "text": "Under the new wg0 interface, Peers tab → Add Peer. Paste the remote public key, set Allowed IPs to the remote subnet and the remote overlay /32, and set Endpoint Host and Port to the remote router's public address." },
    { "@type": "HowToStep", "name": "Open the firewall", "text": "Under Network → Firewall → Zones, attach wg0 to the lan zone (or a dedicated vpn zone) and ensure the input and forward policies match your intent." },
    { "@type": "HowToStep", "name": "Restart networking", "text": "Run `/etc/init.d/network restart` and confirm with `wg show` that a handshake has completed." }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home",     "item": "https://meshwg.com/" },
    { "@type": "ListItem", "position": 2, "name": "OpenWrt",  "item": "https://meshwg.com/openwrt/" },
    { "@type": "ListItem", "position": 3, "name": "WireGuard","item": canonical }
  ]
};
