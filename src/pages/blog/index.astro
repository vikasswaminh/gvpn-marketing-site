---
import Base       from "../../layouts/Base.astro";
import Nav        from "../../components/Nav.astro";
import PageHero   from "../../components/PageHero.astro";
import Footer     from "../../components/Footer.astro";

// Blog post index. Hardcoded list — matches the pattern used elsewhere in
// the site (quickstart.astro's vendorGuides, docs.astro's archPoints). When a
// new post ships, prepend its entry to this array; the index page rebuilds
// automatically. Newest first.
//
// Keep `slug` matching the .astro filename in this directory. Keep `category`
// short enough to fit on one line at narrow widths.

interface PostMeta {
  slug:        string;
  title:       string;
  description: string;
  datePublished: string;   // ISO date
  readMinutes: number;
  category:    string;
}

const posts: PostMeta[] = [
  {
    slug:          "wireguard-nat-traversal-cgnat-firewalls-2026",
    title:         "WireGuard NAT Traversal: Connecting Peers Behind CGNAT & Firewalls (2026)",
    description:   "Complete 2026 engineering guide to WireGuard NAT Traversal. Learn UDP hole punching, PersistentKeepalive, CGNAT workarounds, STUN/ICE mechanics, and enterprise relay strategies.",
    datePublished: "2026-08-21",
    readMinutes:   25,
    category:      "engineering guide",
  },
  {
    slug:          "manage-multiple-wireguard-tunnels-mesh-vpn-2026",
    title:         "How to Manage Multiple WireGuard Tunnels and Build a WireGuard Mesh VPN",
    description:   "Master WireGuard mesh networking and multi-tunnel management in 2026. Learn architecture, full-mesh topologies, automated configs, BGP routing, and scaling strategies.",
    datePublished: "2026-08-20",
    readMinutes:   25,
    category:      "engineering guide",
  },
  {
    slug:          "mesh-vpn-vs-ipsec-vs-sdwan-2026",
    title:         "Mesh VPN vs IPsec vs SD-WAN: choosing the right private network for your business in 2026",
    description:   "A strategist's guide to the three private-network categories shaping multi-site business today. Compare mesh VPN, IPsec, and SD-WAN by what each delivers.",
    datePublished: "2026-05-16",
    readMinutes:   17,
    category:      "strategy guide",
  },
  {
    slug:          "branch-office-vpn-smb-rollout-playbook-2026",
    title:         "Branch office VPN for SMBs in 2026: a 5-phase rollout playbook",
    description:   "Five-phase playbook for rolling out a branch-office VPN across 5 to 50 sites without an SDWAN appliance budget. Real numbers from retail, clinic, and distributor deployments.",
    datePublished: "2026-05-16",
    readMinutes:   17,
    category:      "rollout playbook",
  },
  {
    slug:          "sd-wan-alternatives-2026",
    title:         "SD-WAN alternatives in 2026: seven modern options for connecting branch offices",
    description:   "Honest comparison of seven modern alternatives to box-based SD-WAN — from BYO-router mesh VPN to ZTNA platforms. For SMB and mid-market teams who want branch connectivity without the appliance refresh cycle.",
    datePublished: "2026-05-16",
    readMinutes:   17,
    category:      "buyer's guide",
  },
  {
    slug:          "wireguard-site-to-site-vpn-how-it-works-2026",
    title:         "WireGuard for site-to-site VPN: how it actually works in 2026",
    description:   "How WireGuard site-to-site works at the protocol level — with multi-site mesh, CGNAT scenarios, and when a cloud control plane beats hand-rolled per-peer configs.",
    datePublished: "2026-05-16",
    readMinutes:   18,
    category:      "protocol deep-dive",
  },
  {
    slug:          "tp-link-site-to-site-vpn-wireguard-2026",
    title:         "TP-Link site-to-site VPN with WireGuard: a 2026 guide for branch offices",
    description:   "Connect two, three, or thirty TP-Link branches with WireGuard site-to-site VPN. No static public IPs needed, no firmware changes, no IPsec gymnastics.",
    datePublished: "2026-05-16",
    readMinutes:   16,
    category:      "branch networking",
  },
];

// Human-readable date formatter.
const fmtDate = (iso: string) => {
  const d = new Date(iso + "T00:00:00Z");
  return d.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
};

const title = "Blog — MeshWG";
const description = "Founder-written notes on branch networking, WireGuard, mesh VPN, and connecting the routers you already own. Long-form guides for the practical work of running a private network across multiple sites.";
---

<Base title={title} description={description}>
  <Nav />

  <PageHero
    eyebrow="/ blog"
    title="Practical notes on mesh VPN, WireGuard, and branch networking."
    lede="Long-form, founder-written guides. The kind of detail we'd send to a friend setting up their first multi-branch deployment."
  />

  <section class="blog-index">
    <div class="wrap">

      <ol class="post-list">
        {posts.map((p) => (
          <li class="post-item">
            <a class="post-link hover-card" href={`/blog/${p.slug}/`}>
              <div class="meta">
                <span class="cat">/ {p.category}</span>
                <span class="dot">·</span>
                <span class="date">{fmtDate(p.datePublished)}</span>
                <span class="dot">·</span>
                <span class="rt">{p.readMinutes} min read</span>
              </div>
              <h2 class="t">{p.title}</h2>
              <div class="tldr">
                <span class="tldr-label">TL;DR</span>
                <p class="d">{p.description}</p>
              </div>
              <span class="arrow" aria-hidden="true">Read →</span>
            </a>
          </li>
        ))}
      </ol>

      <aside class="rss-strip">
        <p>
          More posts coming soon — branch VPN economics, WireGuard
          site-to-site under various ISP conditions, mesh-VPN vs IPsec
          vs SDWAN. If you'd like an email when the next one lands,
          drop a line to <a href="mailto:hello@meshwg.com?subject=MeshWG%20blog%20updates">hello@meshwg.com</a>.
        </p>
      </aside>

    </div>
  </section>

  <!-- ── Blog-index Breadcrumb + ItemList JSON-LD ─────────────────
       ItemList lets Google understand this is a list of articles and
       can surface "Blog" sitelinks once the section has a few posts.
       Breadcrumb improves the rendered SERP appearance for this URL.
       ──────────────────────────────────────────────────────────── -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://meshwg.com/" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://meshwg.com/blog/" },
    ],
  })}></script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Blog",
    "@id": "https://meshwg.com/blog/#blog",
    "name": "MeshWG Blog",
    "description": description,
    "url": "https://meshwg.com/blog/",
    "publisher": {
      "@type": "Organization",
      "@id": "https://meshwg.com/#organization",
      "name": "MeshWG",
      "url": "https://meshwg.com",
    },
    "blogPost": posts.map((p) => ({
      "@type": "BlogPosting",
      "headline": p.title,
      "description": p.description,
      "url": `https://meshwg.com/blog/${p.slug}/`,
      "datePublished": p.datePublished,
    })),
  })}></script>

  <Footer />
</Base>

<style>
  .blog-index { padding: 56px 0 96px; }

  .post-list {
    list-style: none;
    padding: 0; margin: 0;
    display: flex; flex-direction: column;
    gap: 14px;
  }

  .post-item {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    transition: border-color .15s ease, transform .15s ease;
  }
  .post-item:hover {
    border-color: color-mix(in oklab, var(--accent) 35%, var(--border));
    transform: translateY(-1px);
  }

  .post-link {
    display: block;
    padding: 20px 24px;
    color: inherit;
    text-decoration: none;
  }

  .meta {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: 0 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: 16px;
  }
  .meta .cat { color: var(--accent); }
  .meta .dot { color: var(--text-4); }
  .meta .date, .meta .rt { color: var(--text-3); }

  /* Editorial serif title — italic accents reserve for hover acid wash */
  .t {
    font-family: var(--font-serif);
    font-size: 30px;
    font-weight: 400;
    letter-spacing: -0.018em;
    margin: 0 0 12px;
    text-wrap: balance;
    line-height: 1.08;
    color: var(--text);
    transition: color 0.15s ease;
  }
  .post-link:hover .t { color: var(--accent); }

  .tldr {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0 0 20px;
    padding: 14px 18px;
    background: var(--bg-2);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .tldr-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .d {
    margin: 0;
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.65;
    max-width: 680px;
    font-weight: 400;
  }

  .arrow {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .post-link:hover .arrow { color: var(--accent-strong); }

  /* RSS-coming strip */
  .rss-strip {
    margin-top: 48px;
    padding: 24px 28px;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .rss-strip p {
    margin: 0;
    color: var(--text-2);
    font-size: 14.5px;
    line-height: 1.65;
  }
  .rss-strip a {
    color: var(--accent);
  }
  .rss-strip a:hover { color: var(--accent-strong); }

  @media (max-width: 980px) {
    .blog-index { padding: 32px 0 64px; }
    .post-link { padding: 18px 20px; }
    .t { font-size: 19px; }
  }
</style>
