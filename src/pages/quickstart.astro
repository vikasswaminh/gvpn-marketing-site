---
import Base       from "../layouts/Base.astro";
import Nav        from "../components/Nav.astro";
import PageHero   from "../components/PageHero.astro";
import Footer     from "../components/Footer.astro";
import { site } from "../site";

// Vendor-specific quick paths. Each row is a real product family with a
// real WireGuard configuration path. Steps are kept generic on purpose —
// each vendor's UI shifts between firmware versions, so we point at the
// vendor's own current docs for the menu specifics.
const vendorGuides = [
  {
    name: "TP-Link",
    color: "#4ACBD6",
    categories: ["Home routers"],
    blurb: "Archer · Deco · ER series with WireGuard support.",
    steps: [
      "Open the router's admin UI (typically http://192.168.0.1)",
      "Go to Advanced → VPN Server → WireGuard",
      "Click Add, paste the [Interface] + [Peer] config from your MeshWG dashboard",
      "Save & Enable",
    ],
    docs: "https://www.tp-link.com/support/faq/",
  },
  {
    name: "MikroTik",
    color: "#293239",
    categories: ["Enterprise"],
    blurb: "RouterOS 7+. WireGuard is a first-class interface type.",
    steps: [
      "Open WinBox or the WebFig admin",
      "Go to WireGuard → + (Add) and create the interface",
      "Add a Peer with the public key, endpoint, and allowed-IPs from MeshWG",
      "Add an IP address on the WireGuard interface (your machine's overlay IP)",
    ],
    docs: "https://help.mikrotik.com/docs/spaces/ROS/pages/69370121/WireGuard",
  },
  {
    name: "OpenWrt",
    color: "#F08000",
    categories: ["Home routers", "Enterprise"],
    blurb: "19.07+ via LuCI or /etc/config/network. Wraps wg-quick.",
    steps: [
      "Install: opkg update && opkg install wireguard-tools luci-app-wireguard luci-proto-wireguard",
      "LuCI → Network → Interfaces → Add new interface (Protocol: WireGuard VPN)",
      "Paste the keys, endpoint, and allowed-IPs from MeshWG",
      "Save & Apply",
    ],
    docs: "https://openwrt.org/docs/guide-user/services/vpn/wireguard/start",
  },
  {
    name: "Ubiquiti",
    color: "#0559C9",
    categories: ["Enterprise"],
    blurb: "UDM (firmware 3.x+) and EdgeRouter with the wireguard package.",
    steps: [
      "UDM: Settings → Teleport & VPN → VPN Client → WireGuard, import the config",
      "EdgeRouter: install the wireguard .deb, configure via `configure` mode",
      "Reference the public key, endpoint, and allowed-IPs from MeshWG",
      "Commit; save",
    ],
    docs: "https://help.ui.com/hc/en-us/categories/200320654-UniFi-Network",
  },
  {
    name: "OPNsense / pfSense",
    color: "#D94F00",
    categories: ["Firewalls", "Enterprise"],
    blurb: "OPNsense 22.1+ has WireGuard in core. pfSense 2.7+ as a package.",
    steps: [
      "VPN → WireGuard → Instances → Add",
      "Paste keys + tunnel address from MeshWG",
      "Add a Peer with public key, endpoint, allowed-IPs",
      "Enable; assign the interface; firewall rule to allow",
    ],
    docs: "https://docs.opnsense.org/manual/wireguard/",
  },
  {
    name: "Linux / Mac / Windows / mobile",
    color: "#0a0a0a",
    categories: ["Operating systems", "Mobile"],
    blurb: "Use the official WireGuard app — it imports the .conf as-is.",
    steps: [
      "Install the official WireGuard client from wireguard.com/install/",
      "Click Import tunnel(s) from file",
      "Pick the .conf file MeshWG generated for this machine",
      "Activate the tunnel",
    ],
    docs: "https://www.wireguard.com/install/",
  },
];

const title = "Quickstart — MeshWG";
const description = "Get your first machine on a MeshWG mesh in under 2 minutes. Step-by-step setup for TP-Link, MikroTik, OpenWrt, Ubiquiti, OPNsense, and the official WireGuard apps.";

const steps = [
  {
    num: "01",
    time: "~ 30 seconds",
    title: "Sign up",
    body: "Create your account with Google or email. No credit card. You'll land in the dashboard in under a minute.",
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
    btnText: "Sign up free &rarr;",
    btnUrl: "/signup",
    btnPrimary: true
  },
  {
    num: "02",
    time: "~ 1 minute",
    title: "Add a machine",
    body: "Click Add machine, give it a name (e.g. \"branch-mumbai\" or \"office-router\"), and we generate a WireGuard config tied to that machine.",
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="8" rx="2"/><circle cx="7" cy="15" r="1.5" fill="#2563EB" stroke="none"/><line x1="10" y1="15" x2="17" y2="15"/><line x1="14" y1="3" x2="14" y2="8"/><line x1="11.5" y1="5.5" x2="16.5" y2="5.5"/></svg>`,
    btnText: "Add machine &rarr;",
    btnUrl: "/dashboard",
    btnPrimary: false
  },
  {
    num: "03",
    time: "~ 30 seconds",
    title: "Paste the config into your device",
    body: "Open the WireGuard section of your router or the official WireGuard app on your laptop / phone. Paste the config. The tunnel comes up within seconds.",
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>`,
    btnText: "View device guides &rarr;",
    btnUrl: "#vendor-guides",
    btnPrimary: false
  }
];
---

<Base title={title} description={description}>
  <Nav />
  <div class="how-bg"></div>
  <div class="wrap">
    <div class="how-header">
      <div class="how-header-main">
        <div class="sec-eyebrow">/ QUICKSTART</div>
        <h2 class="sec-h">Get your first machine online in <span class="blue">2 minutes.</span></h2>
        <p class="sec-lede">Three simple steps to create the mesh, plus vendor-specific instructions for whatever hardware you have.</p>
        
        <div class="how-features">
          <div class="h-feature">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            No credit card
          </div>
          <div class="h-feature">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Under 2 minutes
          </div>
          <div class="h-feature">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
            Works with your hardware
          </div>
        </div>
      </div>

      <div class="how-header-aside">
        <div class="callout-box">
          <div class="callout-inner">
            <h3>A private network,<br/>ready in minutes.</h3>
            <p>Connect your devices securely<br/>and start building your mesh.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="how-steps">
      {steps.map((s, i) => (
        <>
          <article class="step-card">
            <div class="sc-top">
              <span class="sc-num">{s.num}</span>
              <span class="sc-time">{s.time}</span>
            </div>
            
            <div class="sc-icon-wrap">
              <div class="sc-icon" set:html={s.icon} />
            </div>
            
            <h3 class="sc-title">{s.title}</h3>
            <p class="sc-body">{s.body}</p>
            
            <div class="sc-bot">
              <a href={s.btnUrl} class={`sc-btn ${s.btnPrimary ? 'btn-primary' : 'btn-outline'}`} set:html={s.btnText} />
            </div>
          </article>

          {i < steps.length - 1 && (
            <div class="sc-connector">
              <div class="connector-line"></div>
              <div class="connector-arrow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </div>
              <div class="connector-line"></div>
            </div>
          )}
        </>
      ))}
    </div>
      <div id="vendor-guides" style="padding-top: 64px;">
        <!-- Filter Bar -->
        <div class="vguide-filters-wrap">
          <div class="vg-filters">
            <button class="vg-filter-btn active">All devices</button>
            <button class="vg-filter-btn">Home routers</button>
            <button class="vg-filter-btn">Enterprise</button>
            <button class="vg-filter-btn">Firewalls</button>
            <button class="vg-filter-btn">Operating systems</button>
            <button class="vg-filter-btn">Mobile</button>
          </div>
          <div class="vg-sort">
            <button class="vg-sort-btn">Sort: Popular <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
          </div>
        </div>
      </div>

      <!-- ── Per-vendor guides -->
      <div class="vendor-grid" id="vendor-grid">
        {vendorGuides.map((v, idx) => (
          <article class="vguide" data-name={v.name} data-categories={v.categories ? v.categories.join(',') : ''} data-index={idx}>
            <header class="vg-head">
              <span class="vg-mark">{v.name.slice(0, 2).toUpperCase()}</span>
              <div class="vg-head-main">
                <h3 class="vg-name">{v.name}</h3>
                <p class="vg-blurb">{v.blurb}</p>
              </div>
              <div class="vg-arrow-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </div>
            </header>
            
            <ol class="vg-steps">
              {v.steps.map((s) => <li>{s}</li>)}
            </ol>
            
            <footer class="vg-foot">
              <a class="vg-docs" href={v.docs} target="_blank" rel="noopener">Vendor docs ↗</a>
              <a class="vg-btn" href={v.docs} target="_blank" rel="noopener">View guide &rarr;</a>
            </footer>
          </article>
        ))}
      </div>

      <!-- ── Stuck? -->
      <div class="support-section">
        <div class="support-left">
          <div class="support-badges">
            <span class="badge badge-green"><span class="dot"></span> SUPPORT</span>
            <span class="badge badge-light">We typically respond within a few hours</span>
          </div>
          <h2>Email us. We answer fast.</h2>
          <p>Most setups land in under 2 minutes. If yours doesn't, send a note with your router model and we'll walk it through with you — usually same day.</p>
          <div class="support-cta">
            <a href="mailto:hello@meshwg.com" class="btn btn-primary">Email hello@meshwg.com &rarr;</a>
            <a href="/docs" class="btn btn-line">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
              Read the docs &rarr;
            </a>
          </div>
        </div>
        <div class="support-right">
          <div class="sr-header">OTHER WAYS TO GET HELP</div>
          <div class="sr-cards">
            <a href="/docs" class="sr-card hover-card">
              <div class="sr-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg></div>
              <div class="sr-text">
                <strong>Documentation</strong>
                <span>Step-by-step guides for every device.</span>
              </div>
              <div class="sr-arrow"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></div>
            </a>
            <a href="#" class="sr-card hover-card">
              <div class="sr-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></div>
              <div class="sr-text">
                <strong>Community</strong>
                <span>Get help from other users.</span>
              </div>
              <div class="sr-arrow"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></div>
            </a>
            <a href="mailto:hello@meshwg.com" class="sr-card hover-card">
              <div class="sr-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></div>
              <div class="sr-text">
                <strong>Contact support</strong>
                <span>Still stuck? Send us a message.</span>
              </div>
              <div class="sr-arrow"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></div>
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <Footer />
</Base>

<style>
  /* Background Grid */
  .how-bg {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
    z-index: 0;
    background-image: radial-gradient(#CBD5E1 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.5;
  }

  /* Header Section */
  .how-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    margin-bottom: 56px;
    margin-top: 130px; /* Offset for fixed nav and banner */
  }
  .how-header-main {
    flex: 1;
    max-width: 850px;
  }
  
  .sec-eyebrow {
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #1E3A8A; /* Deeper blue for contrast */
    margin-bottom: 12px;
  }
  .sec-h {
    font-family: var(--font-display, sans-serif);
    font-size: clamp(28px, 3.2vw, 36px);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #0F172A;
    margin: 0 0 12px;
    line-height: 1.1;
  }
  .sec-h .blue {
    color: #2563EB;
  }
  .sec-lede {
    font-size: 15.5px;
    color: #475569;
    line-height: 1.5;
    margin: 0 0 24px;
  }

  .how-features {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .h-feature {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    color: #475569;
  }

  /* Callout Box */
  .how-header-aside {
    flex-shrink: 0;
    width: 320px;
  }
  .callout-box {
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.05);
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 12px 40px rgba(37, 99, 235, 0.05);
  }
  .callout-inner {
    border-left: 3px solid #2563EB;
    padding-left: 16px;
  }
  .callout-inner h3 {
    font-family: var(--font-display, sans-serif);
    font-size: 18px;
    font-weight: 700;
    color: #0F172A;
    margin: 0 0 8px;
    line-height: 1.3;
  }
  .callout-inner p {
    font-size: 14px;
    color: #475569;
    margin: 0;
    line-height: 1.5;
  }

  /* Steps Row */
  .how-steps {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 16px;
  }

  /* Step Card */
  .step-card {
    flex: 1;
    background: #ffffff;
    border-radius: 12px;
    padding: 16px; /* Reduced from 20px */
    display: flex;
    flex-direction: column;
    border: 2px solid #2563EB;
    box-shadow: 6px 6px 0px #2563EB;
    position: relative;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .step-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0px #2563EB;
  }
  
  .sc-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px; /* Reduced from 16px */
  }
  .sc-num {
    background: #2563EB;
    color: #ffffff;
    font-size: 11px; /* Reduced from 13px */
    font-weight: 700;
    font-family: var(--font-mono, monospace);
    width: 24px; /* Reduced from 28px */
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
  }
  .sc-time {
    background: #EFF6FF;
    color: #2563EB;
    font-size: 10.5px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 999px;
  }

  .sc-icon-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 12px; /* Reduced from 16px */
  }
  .sc-icon {
    width: 44px; /* Reduced from 56px */
    height: 44px;
    background: #EFF6FF;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sc-icon svg {
    width: 22px;
    height: 22px;
  }

  .sc-title {
    text-align: center;
    font-family: var(--font-display, sans-serif);
    font-size: 16px; /* Reduced from 18px */
    font-weight: 800;
    color: #0F172A;
    margin: 0 0 6px; /* Reduced from 8px */
    letter-spacing: -0.01em;
  }
  
  .sc-body {
    text-align: center;
    font-size: 12.5px; /* Reduced from 13.5px */
    color: #475569;
    line-height: 1.5;
    margin: 0 0 16px; /* Reduced from 24px */
    flex-grow: 1;
  }

  .sc-bot {
    margin-top: auto;
  }
  
  .sc-btn {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 34px; /* Reduced from 40px */
    border-radius: 8px;
    font-size: 12.5px; /* Reduced from 13.5px */
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn-primary {
    background: #2563EB;
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
  }
  .btn-primary:hover {
    background: #1D4ED8;
  }
  .btn-outline {
    background: #ffffff;
    border: 1px solid #BFDBFE;
    color: #2563EB;
  }
  .btn-outline:hover {
    background: #EFF6FF;
    border-color: #93C5FD;
  }

  /* Connectors */
  .sc-connector {
    display: flex;
    align-items: center;
    width: 60px;
    flex-shrink: 0;
  }
  .connector-line {
    flex: 1;
    height: 2px;
    background-image: linear-gradient(to right, #BFDBFE 50%, transparent 50%);
    background-size: 8px 100%;
  }
  .connector-arrow {
    width: 28px;
    height: 28px;
    background: #ffffff;
    border: 2px solid #EFF6FF;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.05);
    margin: 0 4px;
  }


  /* Vendor Filters */
  .vguide-filters-wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 999px;
    padding: 6px;
    margin-bottom: 32px;
    gap: 16px;
    overflow-x: auto;
  }
  .vg-filters {
    display: flex;
    gap: 4px;
  }
  .vg-filter-btn {
    background: transparent;
    border: none;
    font-size: 13.5px;
    font-weight: 600;
    color: #475569;
    padding: 8px 16px;
    border-radius: 999px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .vg-filter-btn:hover {
    color: #0F172A;
  }
  .vg-filter-btn.active {
    background: #0062FF;
    color: #ffffff;
  }
  .vg-sort {
    padding-right: 8px;
  }
  .vg-sort-btn {
    background: #ffffff;
    border: 1px solid #E2E8F0;
    font-size: 13px;
    font-weight: 600;
    color: #0F172A;
    padding: 6px 14px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
  }

  /* Vendor grid */
  .vendor-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px; /* Reduced from 20px */
    margin-bottom: 0px;
  }
  .vguide {
    background: #ffffff;
    border: 2px solid #0F172A;
    border-radius: 12px;
    padding: 16px; /* Reduced from 20px */
    display: flex; 
    flex-direction: column;
    box-shadow: 6px 6px 0px #0F172A;
