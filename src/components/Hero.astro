---
import { site } from "../site";

const heroChecks = [
  "2 machines free, forever",
  "Setup in under 2 minutes",
  "Works with any WireGuard router",
  "No new hardware to buy",
];
---

<section class="hero">
  <div class="wrap hero-inner">
    <div class="eyebrow">
      <span class="dot"></span>
      <span class="eyebrow-text">one platform · mesh vpn + zero trust access</span>
    </div>

    <h1 class="h1">
      Turn the routers <em>you already own</em> into a secure mesh network.
    </h1>

    <p class="lede">
      Connect your branches, your home, and your team — without buying
      ₹2 lakh SDWAN boxes. MeshWG is a hosted mesh service that works
      with the TP-Link, MikroTik, OpenWrt, and Ubiquiti hardware already
      in your rack.
    </p>

    <div class="hero-cta">
      <a class="btn btn-primary btn-lg" href={site.signupFree}>
        Sign up free
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
      <a class="btn btn-lg" href={site.proContact}>
        Talk to us — Pro
      </a>
    </div>

    <div class="hero-meta">
      {heroChecks.map((label) => (
        <span class="meta-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
          {label}
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 96px 0 64px;
    position: relative;
    overflow: hidden;
  }
  .hero-inner { position: relative; }

  .eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 5px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
  }
  .eyebrow .dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--ok) 18%, transparent);
  }
  .eyebrow-text {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .04em;
    color: var(--text-3);
    text-transform: uppercase;
  }

  .h1 {
    font-size: 64px;
    line-height: 1.04;
    letter-spacing: -.028em;
    font-weight: 500;
    margin: 28px 0 24px;
    max-width: 960px;
    text-wrap: balance;
  }
  .h1 em {
    font-style: normal;
    color: var(--accent);
  }

  .lede {
    font-size: 18px;
    color: var(--text-2);
    max-width: 720px;
    line-height: 1.6;
    text-wrap: pretty;
    margin: 0;
  }

  .hero-cta {
    display: flex; gap: 10px; margin-top: 36px;
    align-items: center; flex-wrap: wrap;
  }

  .hero-meta {
    display: flex; gap: 24px;
    margin-top: 56px;
    flex-wrap: wrap;
  }
  .meta-item {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 13px;
    color: var(--text-3);
    font-family: var(--font-mono);
  }
  .meta-item :global(svg) { color: var(--ok); flex-shrink: 0; }

  @media (max-width: 980px) {
    .hero { padding: 56px 0 32px; }
    .h1 { font-size: 38px; }
    .lede { font-size: 16px; }
    .hero-meta { gap: 12px 20px; margin-top: 40px; }
  }
</style>
