---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  url: string;
  title: string;
  description: string;
  pubDate: Date | string;
  tags?: string[];
  minutes?: string;
  pillText?: string;
  pillColor?: 'orange' | 'red' | 'purple';
  cover?: ImageMetadata;
  coverAlt?: string;
}

const { url, title, description, pubDate, tags, minutes, cover, coverAlt } = Astro.props;

let finalPillText = 'ENGINEERING GUIDE';
let finalPillColor = 'orange';

if (tags && tags.length > 0) {
  const hasStrategy = tags.some(tag => tag.toLowerCase() === 'strategy guide' || tag.toLowerCase() === 'protocol deep-dive');
  if (hasStrategy) {
    finalPillText = 'STRATEGY & ARCHITECTURE';
    finalPillColor = 'purple';
  }
}

const formattedDate = typeof pubDate === 'string' ? pubDate : pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<a href={url} class="mag-card hover-card" data-tilt>
  {cover && (
    <div class="card-img-container">
      <Image src={cover} alt={coverAlt || title} class="card-img" width={800} height={400} widths={[360, 480, 600, 720, 800]} quality={60} format="avif" sizes="(max-width: 768px) calc(100vw - 40px), (max-width: 980px) 50vw, 400px" loading="lazy" decoding="async" />
    </div>
  )}
  <div class="card-content">
    <div class={`mag-pill pill-${finalPillColor}`}>{finalPillText}</div>
    <h3 class="card-t">{title}</h3>
    <p class="card-d">{description}</p>
    <div class="card-meta">
      <span>{formattedDate}</span>
      <span class="dot">·</span>
      {minutes && (
        <>
          <span>{minutes} min read</span>
          <span class="dot">·</span>
        </>
      )}
      <span class="read-link" aria-hidden="true">Read article &rarr;</span>
    </div>
  </div>
</a>
