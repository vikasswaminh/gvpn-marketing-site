---
// Real wg-quick config that the controller actually emits today.
---
<section style="background: var(--bg-2); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);">
  <div class="wrap">
    <div class="sec-eyebrow">/ honest engineering</div>
    <h2 class="sec-h">It's a wg-quick config. No agent. No daemon.</h2>
    <p class="sec-lede">
      The controller emits standard WireGuard. Paste it into your router,
      laptop, or server's existing WireGuard interface. The machine keeps
      doing what it does. MeshWG just brokers the tunnel.
    </p>

    <div class="config-shell">
      <aside class="config-side">
        <h3 class="cs-h">What it doesn't do</h3>
        <p class="cs-p">
          MeshWG isn't a Cisco competitor. It doesn't replace firmware,
          run an agent, or invent a new protocol.
        </p>
        <ul class="cs-list">
          <li><span class="dash">—</span>Standard WireGuard. Works on anything that supports it.</li>
          <li><span class="dash">—</span>You own the config. Export it. Audit it. Run it without MeshWG.</li>
          <li><span class="dash">—</span>Per-peer private keys are returned once and not retained.</li>
          <li><span class="dash">—</span>If the controller is down, existing tunnels keep running.</li>
        </ul>
      </aside>

      <pre class="config-pre"><span class="hdr"># wg0.conf — generated for machine "branch-mumbai"</span>
<span class="sec">[Interface]</span>
<span class="key">PrivateKey</span>          = <span class="val">&lt;generated, returned once&gt;</span>
<span class="key">Address</span>             = <span class="val">10.100.0.2/16</span>
<span class="key">MTU</span>                 = <span class="val">1420</span>

<span class="sec">[Peer]</span>
<span class="hdr"># tenant hub for "acme-networks"</span>
<span class="key">PublicKey</span>           = <span class="val">&lt;tenant hub public key&gt;</span>
<span class="key">Endpoint</span>            = <span class="val">vpn.your-domain.com:51820</span>
<span class="key">AllowedIPs</span>          = <span class="val">10.100.0.0/16</span>
<span class="key">PersistentKeepalive</span> = <span class="val">25</span></pre>
    </div>
  </div>
</section>

<style>
  .config-shell {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 48px;
    margin-top: 64px;
    align-items: start;
  }

  .cs-h {
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -.005em;
    margin: 0 0 12px;
  }
  .cs-p {
    color: var(--text-2);
    font-size: 14.5px;
    margin: 0 0 24px;
    line-height: 1.6;
  }
  .cs-list {
    list-style: none;
    padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 14px;
  }
  .cs-list li {
    display: flex; gap: 12px;
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.55;
  }
  .dash {
    color: var(--text-4);
    font-family: var(--font-mono);
    flex-shrink: 0;
  }

  .config-pre {
    background: #0a0a0a;
    color: #e5e5e5;
    border-radius: var(--radius-lg);
    padding: 24px 26px;
    font: 12.5px/1.75 var(--font-mono);
    overflow: auto;
    border: 1px solid #1a1a1a;
    margin: 0;
    white-space: pre;
  }
  .config-pre .hdr { color: #737373; }
  .config-pre .sec { color: #a5b4fc; }
  .config-pre .key { color: #fafafa; }
  .config-pre .val { color: #fbbf24; }

  @media (max-width: 980px) {
    .config-shell { grid-template-columns: 1fr; gap: 32px; }
    .config-pre { padding: 18px; font-size: 11.5px; }
  }
</style>
