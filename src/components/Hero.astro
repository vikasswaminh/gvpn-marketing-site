---
import { site } from "../site";

const heroChecks = [
  "2 machines free, forever",
  "Setup in under 2 minutes",
  "Works with any WireGuard router",
  "No new hardware to buy",
];
---

<section class="hero">
  <div class="hero-bg-glow"></div>
  <div class="hero-grid-bg"></div>
  <div class="wrap hero-inner">

    <span class="eyebrow animate-fade-up">
      <span class="eyebrow-text">★ ONE PLATFORM · MESH VPN + ZERO TRUST ACCESS</span>
    </span>

    <h1 class="h1 animate-fade-up delay-1">
      <span class="it">Turn the routers you already own</span> —
      into a secure mesh network.
    </h1>

    <h2 class="lede animate-fade-up delay-2">
      Connect your branches, your home, and your team —
      without buying <strong>₹2 lakh SDWAN boxes</strong>. <span class="hl-meshwg">MeshWG</span> is a 
      <strong>hosted mesh service</strong> that works with the TP-Link, MikroTik, OpenWrt,
      and Ubiquiti hardware already in your rack.
    </h2>

    <div class="hero-cta animate-fade-up delay-3">
      <a class="btn btn-acid btn-lg" href={site.signupFree}>
        Sign up free
      </a>
      <a class="btn btn-line btn-lg" href={site.proContact}>
        Talk to us — Pro
      </a>
    </div>

    <div class="hero-meta-bar animate-fade-up delay-3">
      <div class="hero-meta-inner">
        {heroChecks.map((label, index) => (
          <>
            <span class="meta-item">
              {label}
            </span>
            {index < heroChecks.length - 1 && <span class="meta-sep" aria-hidden="true">+</span>}
          </>
        ))}
      </div>
    </div>
  </div>


</section>

<style>
  /* ── Hero canvas ─────────────────────────────────────────────── */
  .hero {
    padding: 100px 0 60px;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: transparent;
  }
  
  .hero-bg-glow {
    display: none; /* Removed the heavy glow */
  }
  
  .hero-grid-bg {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    height: 100%;
    z-index: -3;
    background-color: #faf9f6;
    background-image:
      linear-gradient(rgba(0, 0, 0, 0.15) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.15) 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: center top;
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 80%, transparent 100%);
            mask-image: linear-gradient(to bottom, black 0%, black 80%, transparent 100%);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 1000px; 
    margin: 0 auto;
  }

  /* ── Eyebrow pill ──────────── */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 24px;
    border-radius: var(--radius-pill);
    background: transparent;
    border: 1px solid rgba(218, 165, 32, 0.6);
    margin-top: 32px;
    margin-bottom: 32px;
  }
  .eyebrow-text {
    font: 600 13px/1 var(--font-sans);
    letter-spacing: 0.15em;
    color: #8c6600; /* Darkened for better contrast */
  }

  /* ── Display H1 ────────────────────────── */
  .h1 {
    font-family: var(--font-display);
    font-size: clamp(36px, 4.5vw, 56px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 800;
    margin: 0 0 24px;
    color: var(--text);
    text-align: center;
    max-width: 950px;
  }
  .h1 .it {
    font-style: normal;
    color: #2563EB;
  }

  /* ── Lede ─────────────────────────────────────────────────────── */
  .lede {
    font-size: 19px;
    color: #4B5563;
    max-width: 800px;
    line-height: 1.6;
    text-wrap: pretty;
    font-weight: 500;
    margin: 0 0 40px;
    text-align: center;
  }
  .lede b { color: var(--text); font-weight: 700; }
  .hl-meshwg {
    color: var(--text);
    font-weight: 700;
  }

  /* ── CTAs row ────────────────────────────────────────────────── */
  .hero-cta {
    display: flex;
    gap: 16px;
    margin-bottom: 48px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Hero meta bar ─────────────── */
  .hero-meta-bar {
    width: 100%;
    max-width: 1100px;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 16px 24px;
    margin-top: 24px;
    display: flex;
    justify-content: center;
  }
  .hero-meta-inner {
    display: flex;
    align-items: center;
    gap: 12px;
    font: 500 14px/1 var(--font-sans);
    color: #334155;
    flex-wrap: wrap;
    justify-content: center;
  }
  .meta-item {
    display: inline-flex;
    align-items: center;
  }
  .meta-sep {
    color: #94a3b8;
    margin: 0 4px;
    font-weight: 400;
  }

  /* ── Topology Image ──────────────────────────────────────────── */
  .hero-topology {
    margin-top: 24px;
    width: 100%;
    display: flex;
    justify-content: center;
  }
  .hero-topology img {
    width: 100%;
    max-width: 1000px;
    height: auto;
    object-fit: contain;
    display: block;
    mix-blend-mode: darken;
  }

  /* ── Responsive ──────────────────────────────────────────────── */
  @media (max-width: 980px) {
    .hero { padding: 80px 0 40px; }
    .h1 { font-size: clamp(32px, 6vw, 44px); }
    .lede { font-size: 18px; margin-bottom: 32px; }
    .hero-meta { gap: 12px; font-size: 10.5px; }
    .hero-meta .meta-sep { display: none; }
  }
</style>
