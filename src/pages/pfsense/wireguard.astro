};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "Set up WireGuard on pfSense",
  "totalTime": "PT15M",
  "estimatedCost": { "@type": "MonetaryAmount", "currency": "USD", "value": "0" },
  "tool": [{ "@type": "HowToTool", "name": "pfSense CE 2.7.x or pfSense Plus 22.05+" }],
  "step": [
    { "@type": "HowToStep", "name": "Install the WireGuard package (pfSense CE only)", "text": "On pfSense CE, go to System → Package Manager → Available Packages, search for 'WireGuard' and install it. On pfSense Plus, skip this step — WireGuard is in the base system." },
    { "@type": "HowToStep", "name": "Open the WireGuard menu", "text": "Navigate to VPN → WireGuard. The four sub-tabs are Tunnels, Peers, Settings, and Status." },
    { "@type": "HowToStep", "name": "Create the tunnel", "text": "Tunnels → +. Generate a keypair using the dice icon. Set Listen Port (51820) and Interface Addresses (e.g. 10.100.0.2/32 for site-to-site, 10.100.0.1/24 for road-warrior server)." },
    { "@type": "HowToStep", "name": "Add the peer", "text": "Peers → +. Bind it to the tunnel you just created. Paste the remote public key, set Allowed IPs (remote tunnel /32 + remote LAN subnet), and set Endpoint if the remote has a stable public address." },
    { "@type": "HowToStep", "name": "Enable WireGuard", "text": "Settings tab → tick Enable WireGuard → Save → Apply." },
    { "@type": "HowToStep", "name": "Open the WAN firewall rule", "text": "Firewall → Rules → WAN → Add. Allow inbound UDP to the listen-port (51820)." },
    { "@type": "HowToStep", "name": "Assign the WireGuard interface", "text": "Interfaces → Assignments. The wg0 interface is now available. Add it, give it a friendly name (WG_VPN), and enable it." },
    { "@type": "HowToStep", "name": "Add interface firewall rules", "text": "Firewall → Rules → WG_VPN. Add allow rules for the traffic patterns your policy requires (source: WG net, destination: LAN net or specific hosts)." },
    { "@type": "HowToStep", "name": "Verify the handshake", "text": "Status → WireGuard or VPN → WireGuard → Status. The peer row should show a recent handshake timestamp and the byte counter should increment when traffic is generated." }
  ]
};

const breadcrumbSchema = {
