---
// Every answer reflects the actual state of the codebase as of the most
// recent commit. No "coming Q3 2026" hand-waving.
const faqs = [
  [
    {
      q: "What is MeshWG today?",
      a: "An open-source Go controller that manages WireGuard peers and L3/L4 access policies for one or more tenants. Self-hosted on a single Linux VM. No cloud relays, no agent, no SaaS — the dashboard is the whole product surface.",
      open: true,
    },
    {
      q: "Is this really SDWAN, or just WireGuard with a UI?",
      a: "It's WireGuard with a UI, plus per-tenant namespace isolation, kernel-enforced ACLs (iptables), a startup reconciler that rebuilds state from the database after a reboot, and an e2e test harness that validates every claim against real kernel oracles. If 'SDWAN' means a $1,500 box with a vendor sticker, this isn't that. If it means software-defined site-to-site networking with central policy, it is.",
    },
    {
      q: "Which routers does it work with?",
      a: "Any router that runs WireGuard. That's TP-Link Archer/Deco/ER, D-Link DIR/COVR/DSR, Ubiquiti UDM/EdgeRouter, MikroTik RouterOS 7+, OpenWrt 19.07+, OPNsense, and pfSense. The controller emits a stock wg-quick config; if your router accepts that, you're good.",
    },
    {
      q: "Where do private keys live?",
      a: "Tenant hub private keys are generated by the controller and stored encrypted at rest with AES-256-GCM (key from ENCRYPTION_KEY env). Per-peer private keys are returned exactly once when a site/user is created and not retained server-side after the .conf is shown.",
    },
  ],
  [
    {
      q: "Does the hub provide internet egress for peers?",
      a: "No. By design and verified by the e2e harness: the tenant namespace has zero MASQUERADE rules, zero SNAT rules, only wg0 + lo interfaces, and 1.1.1.1 is unreachable from inside it. The hub forwards overlay traffic between peers only. Peers reach the internet via their own local network.",
    },
    {
      q: "What happens if the controller VM goes down?",
      a: "Existing tunnels keep running — WireGuard is a kernel feature on each peer, it doesn't depend on the controller. You lose the dashboard and the ability to change policies until the controller is back. The startup reconciler rebuilds kernel state from PostgreSQL when it comes back up.",
    },
    {
      q: "How is this different from Tailscale or Twingate?",
      a: "Tailscale and Twingate are agent-based — great for laptops and servers, less ideal when you want to mesh dumb branch routers. MeshWG works with the WireGuard interface already in your AP, so you can mesh sites without touching client devices. Different problem, different shape.",
    },
    {
      q: "Is there a hosted / commercial offering?",
      a: "Not today. The project is MIT licensed and self-hosted. If managed hosting or commercial support matters to you, open an issue on the GitHub repo so we can gauge demand before building it.",
    },
  ],
];
---

<section id="faq" style="background: var(--bg-2);">
  <div class="wrap">
    <div class="sec-eyebrow">FAQ</div>
    <h2 class="sec-h">Honest answers.</h2>

    <div class="faq-grid">
      {faqs.map((col) => (
        <div>
          {col.map((f) => (
            <details open={f.open}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 28px 48px;
    margin-top: 48px;
  }
  details {
    border-top: 1px solid var(--border);
    padding: 18px 0;
  }
  details:last-child { border-bottom: 1px solid var(--border); }
  summary {
    cursor: pointer; list-style: none;
    font-size: 15.5px; font-weight: 500; letter-spacing: -.005em;
    display: flex; align-items: center; justify-content: space-between;
    color: var(--text);
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: "+"; font-size: 22px; color: var(--text-3); font-weight: 300; line-height: 1;
    transition: transform .2s ease;
  }
  details[open] summary::after { content: "−"; }
  details p { margin: 12px 0 0; color: var(--text-2); font-size: 14px; line-height: 1.6; }

  @media (max-width: 980px) {
    .faq-grid { grid-template-columns: 1fr; gap: 0; }
  }
</style>
