---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  wrapLede?: boolean;
  wrapTitle?: boolean;
}

const { eyebrow, title, lede, wrapLede = false, wrapTitle = false } = Astro.props;
---

<header class="page-hero">
  <div class="wrap">
    <div class="ph-inner">
      <div class="ph-grid">
        <div class="ph-left">
          <div class="ph-eyebrow" data-reveal>{eyebrow}</div>
          <h1 class:list={["ph-h", { "ph-h--wrap": wrapTitle }]} data-reveal data-reveal-delay="100" set:html={title} />
        </div>
        {lede && <p class:list={["ph-lede", { "ph-lede--wrap": wrapLede }]} set:html={lede} />}
      </div>
    </div>
  </div>
</header>

<style>
  /* Subpage hero — modern sans-serif headline. */
  .page-hero {
    padding: 120px 0 40px;
    position: relative;
  }
  
  .ph-inner {
    background: linear-gradient(145deg, #f4f7fb, #ffffff);
    border-radius: 24px;
    padding: 64px 56px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.02);
  }

  @keyframes gradientMesh {
    0% { transform: scale(1) translate(0, 0); opacity: 0.5; }
    33% { transform: scale(1.1) translate(30px, -20px); opacity: 0.7; }
    66% { transform: scale(0.9) translate(-20px, 30px); opacity: 0.6; }
    100% { transform: scale(1) translate(0, 0); opacity: 0.5; }
  }

  .ph-inner::before {
    content: "";
    position: absolute;
    top: -50%; right: -20%;
    width: 800px; height: 800px;
    background: radial-gradient(circle at center, rgba(37, 99, 235, 0.12) 0%, transparent 60%),
                radial-gradient(circle at 80% 20%, rgba(59, 130, 246, 0.08) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
    filter: blur(60px);
    animation: gradientMesh 20s ease-in-out infinite;
  }
  
  .ph-grid {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: start;
    max-width: 800px;
  }

  .ph-eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #2563EB;
    margin-bottom: 20px;
  }

  .ph-h {
    font-family: var(--font-display), sans-serif;
    font-size: clamp(32px, 4.5vw, 48px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 800;
    margin: 0;
    color: #111827;
  }
  .ph-h--wrap {
    white-space: normal;
  }

  .ph-lede {
    color: #4B5563;
    font-size: 17px;
    line-height: 1.6;
    margin: 0;
    font-weight: 400;
  }
  .ph-lede b { color: var(--text); font-weight: 500; }
  .ph-lede--wrap {
    white-space: normal;
    max-width: 100%;
  }

  @media (max-width: 980px) {
    .page-hero { padding: 90px 0 24px; }
    .ph-inner { padding: 40px 24px; border-radius: 16px; }
    .ph-grid { gap: 24px; }
    .ph-h { font-size: 28px; }
  }
</style>
