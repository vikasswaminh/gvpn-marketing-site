---
import Base       from "../layouts/Base.astro";
import Nav        from "../components/Nav.astro";
import PageHero   from "../components/PageHero.astro";
import Footer     from "../components/Footer.astro";

// Architecture claims are written as customer-visible promises.
// We describe what you get; we don't describe the inside of the box.
const archPoints = [
  {
    h: "One place where policy is decided",
    p: "All overlay traffic between your machines is routed through a single managed hub — the one place where access rules are applied. Your machines don't need to discover each other directly; they reach the hub, and the hub decides who reaches whom.",
  },
  {
    h: "Strict isolation between organizations",
    p: "Each organization is fully isolated from every other organization on the service. Other organizations cannot see or reach your machines, even if they happen to use overlapping private IP ranges.",
  },
  {
    h: "Policies apply before traffic reaches the destination",
    p: "When you set a policy to deny, packets are dropped before they ever reach the destination machine. There's no software agent on your devices to bypass and no race window — the rule applies the moment you save it.",
  },
  {
    h: "Server-side keys are encrypted at rest",
    p: "The keys MeshWG holds on your behalf are encrypted at rest. The service cannot start at all if the unlock secret is missing. Per-machine private keys are shown to you once at creation and never persisted server-side.",
  },
  {
    h: "No path to the public internet through MeshWG",
    p: "MeshWG forwards your overlay traffic between your own machines only. There is no internet egress path through us — your devices continue to reach the internet through their own local network.",
  },
];

const dontDoList = [
  "We don't ship firmware. The router runs whatever it normally runs.",
  "We don't install an agent on your devices. The WireGuard implementation is the one already in the device.",
  "We don't invent a new tunnel protocol. It's WireGuard, RFC-style.",
  "We don't intercept your traffic — it's WireGuard-encrypted end to end.",
  "We don't retain per-machine private keys. They're shown to you once at creation, then gone.",
];

const testCoverage = [
  { n: "Sign-in + abuse controls", what: "Login, session, CSRF, and rate-limit protections all behave as advertised" },
  { n: "Tunnel handshake",         what: "Two real machines complete a WireGuard handshake against the live service" },
  { n: "Policy enforcement",       what: "When a deny rule is set, the traffic it blocks really stops flowing" },
  { n: "Org-to-org isolation",     what: "One organization cannot observe or reach another organization's traffic" },
  { n: "Concurrent device adds",   what: "Many devices added in parallel never collide on an overlay address" },
  { n: "Policy churn soak",        what: "Dozens of allow/deny flips in a row; every transition lands correctly" },
  { n: "Self-healing",             what: "Forcefully damage internal state — connectivity recovers automatically" },
  { n: "Onboarding burst",         what: "Many organizations created at once; each gets a working mesh" },
  { n: "Live traffic during change", what: "Toggle policies while traffic flows; what is denied is dropped, what is allowed gets through" },
  { n: "No internet egress",       what: "External destinations are unreachable through MeshWG by design" },
  { n: "Edge-case names",          what: "Long names with special characters onboard cleanly with no leftover state" },
  { n: "Delete-org cleanup",       what: "Deleting an organization removes everything that belonged to it, with no orphans" },
];

const title = "Docs — MeshWG";
const description = "How MeshWG actually works: the architecture promises we make, the standard WireGuard configuration we generate, what MeshWG isn't, and the end-to-end testing that verifies every claim before each release.";
---

<Base title={title} description={description}>
  <Nav />
  <PageHero
    eyebrow="/ docs"
    title="How it actually works."
    lede="A high-level overview of the architecture, the standard WireGuard configuration MeshWG generates, and the end-to-end testing that verifies every claim on this site before each release."
    wrapTitle={true}
    wrapLede={true}
  />

  <section class="docs-section">
    <div class="wrap">

      <!-- TOC -->
      <nav class="toc">
        <span class="toc-label">On this page</span>
        <a href="#architecture">Architecture</a>
        <a href="#config">The config we generate</a>
        <a href="#doesnt-do">What it doesn't do</a>
        <a href="#verification">How we verify it works</a>
      </nav>

      <!-- ── Architecture -->
      <article id="architecture" class="doc-block">
        <header>
          <div class="db-eyebrow">/ 01 architecture</div>
          <h2>Architecture in five claims.</h2>
        </header>
        <div class="claims">
          {archPoints.map((c) => (
            <div class="claim">
              <h3>{c.h}</h3>
              <p>{c.p}</p>
            </div>
          ))}
        </div>
      </article>

      <!-- ── Config -->
      <article id="config" class="doc-block">
        <header>
          <div class="db-eyebrow">/ 02 the config we generate</div>
          <h2>Standard WireGuard. Nothing custom.</h2>
          <p class="db-lede">
            When you add a machine in the dashboard, MeshWG returns a
            wg-quick configuration that any WireGuard implementation
            accepts as-is. Below is the exact format.
          </p>
        </header>

        <pre class="config-pre"><span class="hdr"># WireGuard config for machine "branch-mumbai"</span>
<span class="sec">[Interface]</span>
<span class="key">PrivateKey</span>          = <span class="val">&lt;shown once at machine creation&gt;</span>
<span class="key">Address</span>             = <span class="val">10.100.0.2/16</span>
<span class="key">MTU</span>                 = <span class="val">1420</span>

<span class="sec">[Peer]</span>
<span class="hdr"># MeshWG hub for "acme-networks"</span>
<span class="key">PublicKey</span>           = <span class="val">&lt;your MeshWG hub public key&gt;</span>
<span class="key">Endpoint</span>            = <span class="val">vpn.meshwg.com:51820</span>
<span class="key">AllowedIPs</span>          = <span class="val">10.100.0.0/16</span>
<span class="key">PersistentKeepalive</span> = <span class="val">25</span></pre>
      </article>

      <!-- ── What it doesn't do -->
      <article id="doesnt-do" class="doc-block">
        <header>
          <div class="db-eyebrow">/ 03 what it doesn't do</div>
          <h2>The honest list of things MeshWG isn't.</h2>
        </header>
        <ul class="dont">
          {dontDoList.map((line) => (
            <li>
              <span class="dash">—</span>
              {line}
            </li>
          ))}
        </ul>
      </article>

      <!-- ── Verification -->
      <article id="verification" class="doc-block">
        <header>
          <div class="db-eyebrow">/ 04 how we verify it works</div>
          <h2>Every release is tested end-to-end against real traffic.</h2>
          <p class="db-lede">
            Before any release ships, an automated end-to-end test drives
            the live service the same way a customer would, and measures
            real packet behaviour — not just API responses. If anything
            on this page regresses, the deploy fails and the change
            doesn't go out.
          </p>
        </header>

        <div class="cov-grid">
          {testCoverage.map((t) => (
            <div class="cov">
              <div class="cov-name">{t.n}</div>
              <div class="cov-what">{t.what}</div>
            </div>
          ))}
        </div>

        <p class="cov-foot">
          Each test measures real packet behaviour and real handshakes — not
          just status codes — so the claims on this page stay true release
          after release. Want to see a recent test transcript? Email
          <a href="mailto:hello@meshwg.com">hello@meshwg.com</a> and we'll
          share the latest run.
        </p>
      </article>

    </div>
  </section>

  <Footer />
</Base>

<style>
  .docs-section { padding: 64px 0 128px; }

  /* TOC */
  .toc {
    display: flex; flex-wrap: wrap; gap: 18px 24px;
    padding: 16px 0;
    margin-bottom: 56px;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
  }
  .toc-label {
    font-family: var(--font-mono);
    color: var(--text-4);
    text-transform: uppercase;
    letter-spacing: .06em;
    font-size: 11px;
    margin-right: 8px;
  }
  .toc a {
    color: var(--text-2);
    transition: color .12s ease;
  }
  .toc a:hover { color: var(--text); }

  /* Doc blocks */
  .doc-block {
    margin-bottom: 80px;
  }
  .doc-block:last-child { margin-bottom: 0; }

  .db-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .doc-block h2 {
    font-size: 28px;
    line-height: 1.15;
    letter-spacing: -.018em;
    font-weight: 500;
    margin: 0 0 12px;
    max-width: 720px;
    text-wrap: balance;
  }
  .db-lede {
    color: var(--text-2);
    font-size: 15.5px;
    line-height: 1.65;
    margin: 0;
    max-width: none;
  }

  /* Architecture claims */
  .claims {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 32px;
  }
  .claim {
    background: var(--surface);
    border: 1px solid color-mix(in oklab, var(--accent) 30%, var(--border));
    border-radius: var(--radius-lg);
    padding: 24px;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .claim:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.04);
  }
  .claim:nth-child(-n+2) {
    grid-column: 1 / -1;
  }
  .claim h3 {
    font-size: 15px;
    font-weight: 500;
    margin: 0 0 8px;
    letter-spacing: -.005em;
  }
  .claim p {
    color: var(--text-2);
    font-size: 13.5px;
    line-height: 1.65;
    margin: 0;
  }

  /* Config pre */
  .config-pre {
    margin: 32px 0 0;
    background: var(--code-bg);
    color: var(--code-fg);
    border-radius: var(--radius-lg);
    padding: 24px 26px;
    font: 12.5px/1.75 var(--font-mono);
    overflow: auto;
    border: 1px solid var(--border-strong);
    white-space: pre;
  }
  .config-pre .hdr { color: var(--code-com); }
  .config-pre .sec { color: var(--code-key); font-weight: 600; }
  .config-pre .key { color: var(--text-2); font-weight: 500; }
  .config-pre .val { color: var(--code-num); }

  /* Don't-do list */
  .dont {
    list-style: none;
    padding: 0; margin: 32px 0 0;
    display: flex; flex-direction: column;
    gap: 12px;
  }
  .dont li {
    display: flex; gap: 14px;
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.6;
  }
  .dash {
    color: var(--text-4);
    font-family: var(--font-mono);
    flex-shrink: 0;
  }

  /* Coverage grid */
  .cov-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin-top: 32px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .cov {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 16px;
    padding: 18px 24px;
    border-bottom: 1px solid var(--border);
    border-right: 1px solid var(--border);
    background: var(--surface);
  }
  .cov:nth-child(2n) { border-right: 0; }
  .cov:nth-last-child(-n+2) { border-bottom: 0; }
  .cov-name {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--accent);
    letter-spacing: .02em;
  }
  .cov-what {
    color: var(--text-2);
    font-size: 13.5px;
    line-height: 1.5;
  }
  .cov-foot {
    margin-top: 24px;
    font-size: 13.5px;
    color: var(--text-3);
  }
  .cov-foot a {
    color: var(--accent);
  }
  .cov-foot a:hover { color: var(--accent-strong); }

  /* Install pre */
  .install-pre {
    margin: 32px 0;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 22px 24px;
    font: 12.5px/1.7 var(--font-mono);
    overflow: auto;
    color: var(--text);
    white-space: pre;
  }
  .install-pre .c { color: var(--text-3); }

  .sh-cta {
    display: flex; gap: 8px; flex-wrap: wrap;
  }

  @media (max-width: 980px) {
    .docs-section { padding: 32px 0 64px; }
    .claims { grid-template-columns: 1fr; }
    .cov-grid { grid-template-columns: 1fr; }
    .cov { grid-template-columns: 1fr; gap: 4px; padding: 16px; border-right: 0; }
    .cov:nth-child(2n) { border-right: 0; }
    .doc-block { margin-bottom: 56px; }
  }
</style>
