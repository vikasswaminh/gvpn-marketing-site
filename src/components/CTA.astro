---
import { site } from "../site";
---

<section class="cta-section">
  <div class="wrap">
    <div class="cta-box" data-reveal>
      <div class="cta-bg">
        <div class="cta-bg-shape-1"></div>
        <div class="cta-bg-shape-2"></div>
        <div class="cta-bg-dots"></div>
      </div>
      
      <div class="cta-content">
        <div class="cta-left">
          <div class="cta-eyebrow">/ GET STARTED</div>
          <h2 class="cta-h">
            Connect your business.<br />
            <span class="blue">Your home.</span> Or both.
          </h2>
          <p class="cta-p">
            Sign up free in under a minute. Two machines free, forever.<br />
            No card, no agent install, no waiting on hardware.
          </p>
          <div class="cta-actions">
            <a class="btn btn-primary btn-lg" href={site.signupFree} target="_blank" rel="noopener">
              Sign up free
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 8px;"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a class="btn btn-outline btn-lg" href={site.proContact}>
              Talk to us
            </a>
          </div>
          
          <div class="cta-features">
            <div class="cta-feat">
              <div class="cf-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
              </div>
              <div class="cf-text">
                <strong>No credit card</strong>
                <span>Get started instantly</span>
              </div>
            </div>
            <div class="cf-sep"></div>
            <div class="cta-feat">
              <div class="cf-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              </div>
              <div class="cf-text">
                <strong>2 machines free</strong>
                <span>Forever</span>
              </div>
            </div>
            <div class="cf-sep"></div>
            <div class="cta-feat">
              <div class="cf-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
              </div>
              <div class="cf-text">
                <strong>Live in minutes</strong>
                <span>Start building today</span>
              </div>
            </div>
          </div>
        </div>
        
        <div class="cta-right">
          <div class="feature-card">
            <div class="fc-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
            <div class="fc-text">
              <h4>Remote teams</h4>
              <p>Secure access from anywhere.<br/>Keep your team connected, no matter where they work.</p>
            </div>
          </div>
          
          <div class="feature-card">
            <div class="fc-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect></svg>
            </div>
            <div class="fc-text">
              <h4>Office networks</h4>
              <p>Use your existing infrastructure.<br/>Connect your offices securely without extra hardware.</p>
            </div>
          </div>
          
          <div class="feature-card">
            <div class="fc-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            </div>
            <div class="fc-text">
              <h4>Home labs</h4>
              <p>Same security, less hassle.<br/>Perfect for personal use, learning, and experimentation.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section { padding: 16px 0 32px; }

  .cta-box {
    position: relative;
    background: #ffffff;
    overflow: hidden;
    isolation: isolate;
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: #ffffff;
  }
  .cta-bg-shape-1 {
    position: absolute;
    right: -10%;
    bottom: -20%;
    width: 70%;
    height: 120%;
    background: radial-gradient(ellipse at center, #DBEAFE 0%, transparent 60%);
    border-radius: 50%;
    filter: blur(50px);
    opacity: 0.8;
  }
  .cta-bg-shape-2 {
    position: absolute;
    right: 20%;
    top: -10%;
    width: 50%;
    height: 70%;
    background: radial-gradient(ellipse at center, #EFF6FF 0%, transparent 70%);
    border-radius: 50%;
    filter: blur(40px);
  }
  .cta-bg-dots {
    position: absolute;
    top: 40px;
    right: 40px;
    width: 250px;
    height: 150px;
    background-image: radial-gradient(#94A3B8 1.5px, transparent 1.5px);
    background-size: 24px 24px;
    opacity: 0.2;
  }

  .cta-content {
    display: flex;
    padding: 16px 0;
    gap: 48px;
    align-items: center;
    justify-content: space-between;
  }

  .cta-left {
    flex: 1;
    max-width: 580px;
    z-index: 2;
  }

  .cta-eyebrow {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--text-3);
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  .cta-h {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 16px;
  }
  .cta-h .blue {
    color: #2563EB;
  }

  .cta-p {
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.5;
    margin: 0 0 24px;
  }

  .cta-actions {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-bottom: 32px;
  }

  .btn-lg {
    height: 52px;
    padding: 0 28px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn-primary {
    background: #2563EB;
    color: #ffffff;
    border: none;
    box-shadow: 0 4px 14px rgba(37,99,235,0.3);
  }
  .btn-primary:hover {
    background: #1D4ED8;
    box-shadow: 0 6px 20px rgba(37,99,235,0.4);
    transform: translateY(-1px);
  }
  .btn-outline {
    background: #ffffff;
    color: var(--text);
    border: 2px solid #1a1a1a;
  }
  .btn-outline:hover {
    background: #F8FBFF;
    border-color: #2563EB;
  }

  .cta-features {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .cf-sep {
    width: 1px;
    height: 32px;
    background: #E2E8F0;
  }
  .cta-feat {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .cf-icon {
    width: 32px;
    height: 32px;
    background: #EFF6FF;
    border-radius: 8px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .cf-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .cf-text strong {
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
  }
  .cf-text span {
    font-size: 12px;
    color: var(--text-3);
  }

  .cta-right {
    display: flex;
    flex-direction: column;
    gap: 12px;
    z-index: 2;
    flex-shrink: 0;
    width: 100%;
    max-width: 440px;
  }

  .feature-card {
    background: #ffffff;
    border: 2px solid #BFDBFE;
    border-radius: 16px;
    padding: 16px 20px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.04);
    display: flex;
    align-items: flex-start;
    gap: 16px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .feature-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.08);
  }

  .fc-icon {
    width: 48px;
    height: 48px;
    background: #EFF6FF;
    border-radius: 12px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .fc-text h4 {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    color: var(--text);
  }
  .fc-text p {
    margin: 0;
    font-size: 13px;
    color: var(--text-2);
    line-height: 1.5;
  }

  @media (max-width: 1024px) {
    .cta-content {
      flex-direction: column;
      padding: 48px 32px;
      gap: 64px;
    }
    .cta-left {
      max-width: 100%;
    }
    .cta-right {
      max-width: 100%;
    }
  }
  @media (max-width: 600px) {
    .cta-features {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .cf-sep { display: none; }
    .cta-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
