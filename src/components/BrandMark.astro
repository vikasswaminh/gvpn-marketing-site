---
// Inline SVG mark used in nav + footer. Sized via the wrapper.
---
<span class="brand-mark">
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="6" r="2"/><circle cx="6" cy="14" r="2"/><circle cx="18" cy="14" r="2"/><circle cx="12" cy="20" r="1.5"/>
    <path d="M12 8 L6 14 M12 8 L18 14 M6 14 L12 20 M18 14 L12 20 M6 14 L18 14"/>
  </svg>
</span>

<style>
  .brand-mark {
    width: 26px; height: 26px; border-radius: 7px;
    background: linear-gradient(135deg, var(--accent), color-mix(in oklab, var(--accent) 60%, #000));
    display: grid; place-items: center; color: #fff;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.18), 0 1px 2px rgba(0,0,0,.08);
    flex-shrink: 0;
  }
</style>
