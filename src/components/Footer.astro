---
import BrandMark from "./BrandMark.astro";
import { site } from "../site";

const cols = [
  {
    h: "Product",
    items: [
      { l: "Quickstart",     href: "/quickstart" },
      { l: "Docs",           href: "/docs" },
      { l: "Pricing",        href: "/pricing" },
    ],
  },
  {
    h: "Account",
    items: [
      { l: "Sign in",             href: site.signIn,     external: true },
      { l: "Sign up free",        href: site.signupFree, external: true },
    ],
  },
  {
    h: "Contact",
    items: [
      { l: "Contact us",          href: "/contact" },
      { l: "Talk to us (Pro)",    href: site.proContact, external: false },
      { l: "hello@meshwg.com",    href: "mailto:hello@meshwg.com", external: false },
    ],
  },
  {
    h: "Company",
    items: [
      { l: "Careers",             href: "/careers" },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-left">
        <div class="foot-brand">
          <BrandMark />
          <span>{site.productName}</span>
        </div>
        <p class="foot-tag">
          Hosted WireGuard mesh + zero-trust access. Strict per-org isolation,
          fast-acting policies, works with the routers you already own.
        </p>
      </div>

      <div class="foot-right">
        {cols.map((col) => (
          <div>
            <h5 class="col-h">{col.h}</h5>
            <ul class="col-list">
              {col.items.map((it) => (
                <li>
                  <a
                    href={it.href}
                    target={it.external ? "_blank" : undefined}
                    rel={it.external ? "noopener" : undefined}
                  >
                    {it.l}{it.external ? " ↗" : ""}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="foot-bot">
      <div>© {year} {site.productName}. All rights reserved.</div>
      <div class="legal-links">
        <a href="/privacy">Privacy</a>
        <span>·</span>
        <a href="/terms">Terms</a>
        <span>·</span>
        <a href="/refund">Refund &amp; Cancellation</a>
        <span>·</span>
        <a href="/.well-known/security.txt">Security</a>
      </div>
      <div>WireGuard is a registered trademark of Jason A. Donenfeld.</div>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 64px 0 48px;
    color: var(--text-3);
    font-size: 13px;
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
  }
  .foot-right {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  .foot-brand {
    display: flex; align-items: center; gap: 10px;
    font-weight: 500;
    color: var(--text);
    font-size: 15px;
    margin-bottom: 14px;
  }
  .foot-tag {
    max-width: 320px;
    margin: 0;
    color: var(--text-3);
    line-height: 1.55;
    font-size: 13px;
  }

  .col-h {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--text-3);
    font-weight: 500;
    margin: 0 0 14px;
  }
  .col-list {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 10px;
  }
  .col-list a {
    transition: color .12s ease;
  }
  .col-list a:hover { color: var(--text); }

  .foot-bot {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 12px;
    color: var(--text-4);
  }
  .legal-links {
    display: flex; align-items: center; gap: 6px;
  }
  .legal-links a {
    color: var(--text-4);
    transition: color .12s ease;
  }
  .legal-links a:hover { color: var(--text-2); }
  .legal-links span { color: var(--text-4); }

  @media (max-width: 980px) {
    .foot-grid { grid-template-columns: 1fr; gap: 48px; }
    .foot-right { grid-template-columns: 1fr 1fr; }
    .foot-bot { flex-direction: column; align-items: flex-start; gap: 12px; }
  }
</style>
