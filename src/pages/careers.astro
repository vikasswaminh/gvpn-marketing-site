---
import Base       from "../layouts/Base.astro";
import Nav        from "../components/Nav.astro";
import PageHero   from "../components/PageHero.astro";
import Footer     from "../components/Footer.astro";

const title = "Careers at MeshWG — we're hiring 33 people in Bangalore";
const description = "Open roles at MeshWG, Bengaluru. Sales executives, network support engineers, and HR executives. Full-time, in-office at HSR Layout. No remote work.";

// Role data lives at the top so it's easy to update headcount or close a
// position without hunting through the markup.
const roles = [
  {
    id: "sales-executive",
    title: "Sales Executive",
    headcount: 10,
    team: "Revenue",
    eyebrow: "Sales",
    summary:
      "Take MeshWG to Indian SMBs that need branch-office connectivity but can't justify a six-figure SD-WAN contract. You're talking to IT managers, MSPs, regional CTOs — people who actually decide.",
    doing: [
      "Run discovery calls and demos for prospects who reach inbound, plus targeted outbound into segments we choose with you.",
      "Own the deal from first call to signed agreement; pricing above 50 machines is yours to negotiate (with founder backup).",
      "Feed signal back to product — what objections recur, what features close deals, which industries pull hardest.",
      "Maintain a clean pipeline. We use a lightweight CRM, not a 14-stage forecast theatre.",
    ],
    looking: [
      "2+ years selling B2B SaaS or networking products in India. Bonus if you've sold to MSPs, hospitality chains, retail, or distributed-branch verticals.",
      "Conversational fluency in English and Hindi; another regional Indian language is a strong plus.",
      "Comfortable on a technical call — you don't need to be an engineer, but the IT manager on the other end shouldn't feel they're explaining basics.",
      "Track record of hitting quota with a stated ramp; we'll ask for references and verify.",
    ],
  },
  {
    id: "network-support-engineer",
    title: "Network Support Engineer",
    headcount: 20,
    team: "Customer Success",
    eyebrow: "Support · 24/7 shifts",
    summary:
      "Be the person customers reach when their branch can't see HQ — at 3 AM if that's when the tunnel goes down. MeshWG promises 24/7 human support to every customer, free and paid. You'll own router configs, mesh connectivity problems, ISP-side weirdness, and the kind of multi-vendor diagnostics that don't fit a script.",
    doing: [
      "Work one of our three 8-hour shifts (morning 06:00–14:00, day 14:00–22:00, night 22:00–06:00 IST) on a rotating roster — every engineer cycles through all three shifts to share the load fairly.",
      "Front-line triage for support tickets, customer phone calls, and live-chat — every channel during your shift, every hour of the week including Sundays and gazetted holidays.",
      "Walk customers through router configuration for the brands we support — TP-Link, MikroTik, OpenWrt, Asus, Ubiquiti, pfSense, OPNsense, GL.iNet — fluency in 2-3 of these on day one, the rest within the first quarter.",
      "Use our diagnostic dashboard to identify whether a problem is on the customer side (ISP / NAT / firewall) or ours; escalate to on-call engineering when the issue is on our side.",
      "Document every non-trivial fix into our runbook so the next engineer joining the team is productive on day five, not day fifty.",
    ],
    looking: [
      "CCNA-level networking fundamentals: IP, NAT, routing, subnets, DNS, common firewall behaviour. Certification not required if you can explain the concepts on a call.",
      "Hands-on with at least one consumer / SMB router brand — TP-Link Omada, MikroTik RouterOS, OpenWrt, Asus, pfSense, or UniFi. WireGuard exposure is a plus; we'll teach what you don't know.",
      "Calm communicator. Most of the job is reducing a frustrated customer's stress while you work the actual fix. The night-shift version of this is harder; calm is the qualifying trait.",
      "Comfortable on Linux command line (ssh, basic shell, reading logs). You don't need to write code; you do need to read it.",
      "Available to work the rotating shift schedule, including night shift (22:00–06:00 IST) approximately one week in three. We pay a 25% shift differential for night-shift weeks.",
    ],
  },
  {
    id: "hr-executive",
    title: "HR Executive",
    headcount: 3,
    team: "People",
    eyebrow: "People",
    summary:
      "Help us go from a small founding team to thirty-plus engineers and salespeople without losing what makes the place worth showing up to. End-to-end recruiting plus the operational HR work that keeps a growing company legal and humane.",
    doing: [
      "Run the recruiting funnel for the open roles above — sourcing, screening, scheduling, candidate experience. Initially you'll be hiring your peers on the engineering and sales teams.",
      "Onboarding: offer letters, joining formalities, documentation, first-week experience. The bar is that a new hire's first day feels organised, not improvised.",
      "Day-to-day HR ops: leave tracking, payroll inputs, compliance with Karnataka labour rules, statutory filings, vendor coordination for benefits.",
      "Help build the early culture — feedback rituals, onboarding doc, the small things that make people want to recommend us to their friends.",
    ],
    looking: [
      "2+ years in HR or recruiting at a tech / startup environment — early-stage experience preferred over corporate process roles.",
      "Confident running independent recruiting cycles from sourcing through offer; not afraid to make 30 outbound messages a day when the pipeline needs it.",
      "Practical knowledge of Indian employment law basics — PF, ESI, gratuity, leave rules, contract vs full-time. You don't have to be a lawyer; you do have to know when to call one.",
      "Comfortable in spreadsheets, basic ATS or even a well-organised Notion. Bias for clarity over ceremony.",
    ],
  },
];

const totalHeadcount = roles.reduce((sum, r) => sum + r.headcount, 0);

// ── JSON-LD for Google Jobs ──────────────────────────────────────────
// One JobPosting per role. Google's rich result requires title,
// description, hiringOrganization, jobLocation (with full PostalAddress),
// datePosted, validThrough, employmentType. Setting jobLocationType
// implicitly to physical (no TELECOMMUTE) communicates "in-office only"
// to crawlers — paired with applicantLocationRequirements=IN this is
// the structured-data equivalent of the "no remote work" line at the
// top of the page.
const datePosted = "2026-05-21";
const validThrough = "2026-08-21";  // 90-day window; refresh by re-deploying

const hiringOrg = {
  "@type": "Organization",
  "@id": "https://meshwg.com/#organization",
  "name": "MeshWG",
  "sameAs": "https://meshwg.com",
  "logo": "https://meshwg.com/favicon.svg"
};

const jobLocation = {
  "@type": "Place",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "L-149, Sector 6, HSR Layout",
    "addressLocality": "Bengaluru",
    "addressRegion": "Karnataka",
    "postalCode": "560102",
    "addressCountry": "IN"
  }
};

const jobPostings = roles.map((role) => ({
  "@context": "https://schema.org",
  "@type": "JobPosting",
  "@id": `https://meshwg.com/careers#${role.id}`,
  "title": role.title,
  "description":
    `<p>${role.summary}</p>` +
    `<h3>What you'll do</h3><ul>${role.doing.map((d) => `<li>${d}</li>`).join("")}</ul>` +
    `<h3>What we look for</h3><ul>${role.looking.map((l) => `<li>${l}</li>`).join("")}</ul>` +
    `<p>Location: ${role.headcount} open position${role.headcount > 1 ? "s" : ""}. Bengaluru, India. Full-time, in-office only — no remote, no hybrid.</p>`,
  "datePosted": datePosted,
  "validThrough": validThrough,
  "employmentType": "FULL_TIME",
  "hiringOrganization": hiringOrg,
  "jobLocation": jobLocation,
  "jobLocationType": null,  // explicit absence of TELECOMMUTE signals in-office
  "applicantLocationRequirements": {
    "@type": "Country",
    "name": "IN"
  },
  "totalJobOpenings": role.headcount,
  "industry": "Computer Software / Networking",
  "directApply": true,
  "applicationContact": {
    "@type": "ContactPoint",
    "contactType": "HR",
    "email": "careers@meshwg.com"
  },
  "url": `https://meshwg.com/careers#${role.id}`
}));

const careersBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://meshwg.com/" },
    { "@type": "ListItem", "position": 2, "name": "Careers", "item": "https://meshwg.com/careers" }
  ]
};
---

<Base title={title} description={description}>
  <Nav />
  <PageHero
    eyebrow="/ careers"
    title={`Help us build the SD-WAN that Indian SMBs can actually afford.`}
    lede={`We're hiring ${totalHeadcount} people across sales, network support, and HR. All roles are full-time at our Bangalore office. No remote work.`}
  />

  <section class="careers">
    <div class="wrap">

      {/* ── The constraints, up front and unambiguous ──────────────── */}
      <div class="terms-card">
        <div class="terms-eyebrow">/ the basics, before you scroll</div>
        <div class="terms-grid">
          <div>
            <div class="terms-h">📍 Location</div>
            <p>L-149, Sector 6, HSR Layout, Bengaluru 560102.</p>
          </div>
          <div>
            <div class="terms-h">🏢 In-office</div>
            <p>All roles work from the office. We do not offer remote, hybrid, or work-from-home.</p>
          </div>
          <div>
            <div class="terms-h">⏱ Schedule</div>
            <p>Full-time. Sales / HR: Mon–Sat 10:00–18:00 IST. Network Support: rotating 24/7 shifts (06–14, 14–22, 22–06 IST) with night-shift differential.</p>
          </div>
          <div>
            <div class="terms-h">🪪 Eligibility</div>
            <p>Indian citizen or valid Indian work authorisation. We do not sponsor visas.</p>
          </div>
        </div>
        <p class="terms-note">
          We're firm on the in-office line because we're still small and learning
          how to scale. If remote work is a hard requirement for you, MeshWG isn't
          the right fit today — and we'd rather say so on this page than after
          three rounds of interviews.
        </p>
      </div>

      {/* ── Why work here ──────────────────────────────────────────── */}
      <article class="why">
        <h2>Why MeshWG</h2>
        <p>
          We sell a real product to real Indian SMBs — branch routers, retail
          chains, distributed teams that need a network without a six-figure
          SD-WAN budget. The free tier ships with the first two machines covered
          forever; everything else is honest per-machine pricing.
        </p>
        <p>
          The team is small, the customer list is growing, and the company is
          run from one office in Bangalore. You'll see your work land in
          production within days, not quarters. You'll know every customer's
          name. You'll have a direct line to the founder and to the engineer
          who shipped the feature you're now supporting.
        </p>
        <p>
          We don't claim to be a 1000-person rocketship. We claim to be a
          serious team building software that lots of small Indian businesses
          will rely on this decade. If that matters to you, read on.
        </p>
      </article>

      {/* ── Open positions ─────────────────────────────────────────── */}
      <div class="roles-header">
        <h2>Open positions</h2>
        <div class="roles-summary">
          {roles.map((r) => (
            <a class="role-pill" href={`#${r.id}`}>
              <strong>{r.headcount}</strong> {r.title}{r.headcount > 1 ? "s" : ""}
            </a>
          ))}
        </div>
      </div>

      {roles.map((role) => (
        <article class="role" id={role.id}>
          <div class="role-head">
            <div class="role-eyebrow">/ {role.eyebrow} · {role.team}</div>
            <h3 class="role-title">
              {role.title}
              <span class="role-count">{role.headcount} open</span>
            </h3>
            <p class="role-summary">{role.summary}</p>
          </div>

          <div class="role-grid">
            <div>
              <div class="block-h">What you'll do</div>
              <ul class="bullets">
                {role.doing.map((d) => (<li>{d}</li>))}
              </ul>
            </div>
            <div>
              <div class="block-h">What we look for</div>
              <ul class="bullets">
                {role.looking.map((l) => (<li>{l}</li>))}
              </ul>
            </div>
          </div>

          <div class="role-cta">
            <a
              class="btn btn-primary"
              href={`mailto:careers@meshwg.com?subject=${encodeURIComponent(`Application — ${role.title}`)}&body=${encodeURIComponent(
                `Hi MeshWG team,\n\nI'd like to apply for the ${role.title} role.\n\n` +
                `My CV is attached. A short note on why I'm a fit:\n\n[your 3-5 lines here]\n\n` +
                `Current location: \nEarliest start date: \nExpected compensation: \n\nThanks,\n`
              )}`}
            >
              Apply for {role.title}
            </a>
            <span class="role-apply-note">
              or email <a href="mailto:careers@meshwg.com">careers@meshwg.com</a>{" "}
              with the subject <code>Application — {role.title}</code>
            </span>
          </div>
        </article>
      ))}

      {/* ── What the process looks like ────────────────────────────── */}
      <article>
        <h2>The interview process</h2>
        <p>
          We try to keep this short and predictable. For all three roles:
        </p>
        <ol class="numbered">
          <li><strong>Application review</strong> — we read every CV that comes to careers@meshwg.com. You'll hear back within 5 working days, even if it's a no.</li>
          <li><strong>15-minute screening call</strong> — quick fit check, salary expectations, location confirmation. By phone, not video.</li>
          <li><strong>Role-specific round</strong> — sales: a mock discovery call. Support: a live troubleshooting scenario on a real router. HR: a structured conversation on process and judgement calls.</li>
          <li><strong>Final round, in-office</strong> — at the HSR Layout campus. You meet the team you'd join and the founder. ~2 hours total.</li>
          <li><strong>Offer</strong> — within 3 working days of the final round if it's a yes.</li>
        </ol>
        <p>
          Total elapsed time, application to offer, is typically 2 weeks. We
          don't ghost. If we're moving slower than that, someone will tell you
          why.
        </p>
      </article>

      {/* ── Don't see your role? ───────────────────────────────────── */}
      <article>
        <h2>Don't see your role?</h2>
        <p>
          We're hiring slowly on the engineering side and will be opening roles
          for backend engineers, infrastructure, and product later this year. If
          you build infrastructure, networking, or developer-facing software,
          send a CV with subject <code>Speculative — [role you want]</code> to{" "}
          <a href="mailto:careers@meshwg.com">careers@meshwg.com</a>. We keep
          good CVs warm and reach out when the role opens.
        </p>
        <p>
          We do not currently have openings for: remote contractors,
          part-time consultants, or interns.
        </p>
      </article>

    </div>
  </section>

  <Footer />

  {/* JSON-LD: one JobPosting per role + a BreadcrumbList. Google Jobs
     indexes each posting separately, so the user with "sales executive
     jobs HSR Layout" intent sees the Sales card; the user with "network
     support engineer Bangalore" sees the NSE card. Splitting is
     required — a single posting with totalJobOpenings=33 would not be
     indexed correctly for differentiated keywords. */}
  {jobPostings.map((jp) => (
    <script type="application/ld+json" set:html={JSON.stringify(jp)} />
  ))}
  <script type="application/ld+json" set:html={JSON.stringify(careersBreadcrumb)} />
</Base>

<style>
  .careers { padding: 64px 0 128px; }
  .careers article { margin-bottom: 64px; max-width: 880px; }
  .careers article:last-child { margin-bottom: 0; }

  /* ── Top constraints card ───────────────────────────────────── */
  .terms-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 28px 32px 28px;
    margin-bottom: 72px;
  }
  .terms-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-3);
    margin-bottom: 22px;
  }
  .terms-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-bottom: 20px;
  }
  .terms-h {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 6px;
  }
  .terms-grid p {
    color: var(--text-3);
    font-size: 13.5px;
    line-height: 1.55;
    margin: 0;
  }
  .terms-note {
    color: var(--text-3);
    font-size: 13.5px;
    line-height: 1.65;
    margin: 0;
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }

  /* ── Why-MeshWG body ────────────────────────────────────────── */
  .careers h2 {
    font-family: var(--font-serif);
    font-size: 30px;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 0 0 20px;
    color: var(--text);
    text-wrap: balance;
  }
  .careers .why p,
  .careers > * > .wrap > article p {
    color: var(--text-2);
    font-size: 15.5px;
    line-height: 1.7;
    margin: 0 0 14px;
  }
  .careers p {
    color: var(--text-2);
    font-size: 15.5px;
    line-height: 1.7;
    margin: 0 0 14px;
  }
  .careers strong { color: var(--text); font-weight: 500; }
  .careers a { color: var(--accent); }
  .careers a:hover { color: var(--accent-strong); }
  .careers code {
    font-family: var(--font-mono);
    font-size: .92em;
    background: var(--bg-2);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    color: var(--text-2);
  }

  /* ── Roles header + jump pills ──────────────────────────────── */
  .roles-header {
    margin-bottom: 32px;
    max-width: 880px;
  }
  .roles-header h2 { margin-bottom: 16px; }
  .roles-summary {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .role-pill {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 8px 14px;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    font-size: 13.5px;
    color: var(--text-2);
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .role-pill:hover {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent-strong);
  }
  .role-pill strong {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--accent);
    font-size: 14px;
  }

  /* ── Individual role cards ──────────────────────────────────── */
  .role {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 36px 36px 32px;
    margin-bottom: 24px !important;
    scroll-margin-top: 100px;
  }
  .role-head { margin-bottom: 28px; }
  .role-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-3);
    margin-bottom: 10px;
  }
  .role-title {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--text);
    margin: 0 0 12px;
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }
  .role-count {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 4px 9px;
    border-radius: var(--radius-sm);
  }
  .role-summary {
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.6;
    margin: 0;
    max-width: 720px;
  }

  .role-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-bottom: 28px;
  }
  .block-h {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-3);
    margin-bottom: 14px;
  }

  /* Apply CTA + secondary note */
  .role-cta {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .role-apply-note {
    color: var(--text-3);
    font-size: 13.5px;
  }
  .role-apply-note code {
    font-size: 12.5px;
    background: var(--bg-2);
  }

  /* ── Bullets + ordered list (mono dashes / numbers) ─────────── */
  .bullets, .numbered {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .bullets li, .numbered li {
    color: var(--text-2);
    font-size: 14.5px;
    line-height: 1.65;
    padding-left: 28px;
    position: relative;
    counter-increment: num;
  }
  .bullets li::before {
    content: "—";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--text-4);
    font-family: var(--font-mono);
  }
  .numbered { counter-reset: num; }
  .numbered li::before {
    content: counter(num) ".";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--text-4);
    font-family: var(--font-mono);
  }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 980px) {
    .terms-grid { grid-template-columns: 1fr 1fr; gap: 18px; }
  }
  @media (max-width: 820px) {
    .careers { padding: 32px 0 64px; }
    .careers article { margin-bottom: 48px; }
    .terms-card { padding: 22px 22px 22px; margin-bottom: 48px; }
    .terms-grid { grid-template-columns: 1fr; gap: 14px; }
    .role { padding: 24px 22px 22px; }
    .role-title { font-size: 22px; }
    .role-grid { grid-template-columns: 1fr; gap: 24px; }
    .careers h2 { font-size: 24px; }
  }
</style>
