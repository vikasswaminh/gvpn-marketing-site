---
import { site } from "../site";

const faqs = [
  [
    {
      q: "How is this different from Tailscale?",
      a: "MeshWG runs on your own infrastructure using standard WireGuard, with no third-party control plane. You keep full control of your network, data, and infrastructure.",
    },
    {
      q: "Do I need to install software or replace anything?",
      a: "No. If your router supports WireGuard (most modern routers do), you paste the config we generate. The router does the rest. No firmware changes, no agent install.",
    },
    {
      q: "Is the encryption strong?",
      a: "Yes — it's standard WireGuard, the same protocol used by every major VPN service today. Your private keys never leave your device.",
    },
  ],
  [
    {
      q: "What happens if MeshWG goes down?",
      a: "Your tunnels keep working. WireGuard lives on your devices, not on our servers, so an outage on our side doesn't disconnect your branches.",
    },
    {
      q: "Do I have to pay a credit card up front?",
      a: "No. The first 2 machines are free forever — sign up with email or Google, mesh them, and we never ask for a card. You only enter billing when you add machine #3.",
    },
    {
      q: "Is this for businesses or homes?",
      a: "Both. A homelabber meshing their VPS, home network, and remote cabin uses it the same way a 20-branch retailer does. The product doesn't care what you call yourself.",
    },
  ],
];
---

<section id="faq">
  <div class="wrap">
    <div class="sec-eyebrow" data-reveal>/ FAQ</div>
    <h2 class="sec-h" data-reveal data-reveal-delay="100">
      Straight <span class="blue">answers.</span>
    </h2>
    <p class="sec-lede" data-reveal data-reveal-delay="200">
      Everything you need to know about MeshWG — clear, simple, and to the point.
    </p>

    <div class="faq-grid">
      {faqs.map((col, i) => (
        <div class="faq-col" data-reveal data-reveal-delay={200 + (i * 100)}>
          {col.map((f) => (
            <details open={f.open} class="faq-card">
              <summary>
                <span class="faq-q">{f.q}</span>
              </summary>
              <div class="faq-a">
                <p>{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  #faq { padding: 24px 0 16px; background: #ffffff; }
  #faq .sec-h, #faq .sec-lede {
    text-wrap: unset;
    max-width: none;
  }
  #faq .blue { color: #2563EB; }
  
  .sec-lede {
    color: var(--text-2);
    font-size: 18px;
    margin-top: 16px;
    margin-bottom: 48px;
  }

  .faq-grid {
    display: flex;
    gap: 24px;
    align-items: flex-start;
  }

  .faq-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .faq-card {
    background: #ffffff;
    border: 2px solid #1a1a1a;
    border-radius: 12px;
    padding: 24px;
    transition: all 0.2s ease;
  }

  summary {
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    display: flex; 
    align-items: center; 
    justify-content: space-between;
    gap: 16px;
    line-height: 1.4;
  }
  summary::-webkit-details-marker { display: none; }
  
  summary::after {
    content: "+";
    font-family: var(--font-mono);
    font-size: 20px;
    color: #1a1a1a;
    font-weight: 400;
    line-height: 1;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  .faq-card[open] summary::after { 
    content: "−"; 
  }

  .faq-a {
    margin-top: 16px;
  }
  
  .faq-a p {
    margin: 0;
    color: var(--text-2);
    font-size: 14.5px;
    line-height: 1.6;
  }
  
  .faq-card[open] .faq-a p {
    color: #475569;
  }


  @media (max-width: 980px) {
    .faq-grid { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  const faqs = document.querySelectorAll("#faq details");
  faqs.forEach((targetDetail) => {
    targetDetail.addEventListener("toggle", () => {
      if (targetDetail.open) {
        faqs.forEach((detail) => {
          if (detail !== targetDetail) {
            detail.removeAttribute("open");
          }
        });
      }
    });
  });
</script>
