---
// Comparison table — used on the homepage, and reusable in any blog post
// that needs to position MeshWG against alternatives.
//
// Defaults preserve the exact homepage content so this component can be
// rendered <Compare /> with no props for the index page. To customise it
// per-post (different competitors, different criteria, different headline),
// pass any of the props below.

interface Row {
  label: string;
  cells: readonly string[];   // one entry per non-MeshWG column, in column order
  us: string;                  // the MeshWG cell, always rendered as the last column
}

interface Props {
  /** Section anchor id. Used for in-page links. Defaults to "compare". */
  id?: string;
  /** Eyebrow text shown above the title. Defaults to "/ compare". */
  eyebrow?: string;
  /** Section heading. Defaults to the homepage headline. */
  title?: string;
  /** Lede paragraph under the heading. Defaults to the homepage lede. */
  lede?: string;
  /** Column headers for the non-MeshWG options (MeshWG is always the last column). */
  cols?: readonly string[];
  /** Rows of the table. Each row's `cells` array must be the same length as `cols`. */
  rows?: readonly Row[];
  /** Footer link text + href. Defaults to the homepage "How it actually works under the hood →" link. */
  footLinkText?: string;
  footLinkHref?: string;
  /** Hide the footer link entirely (useful for blog posts that have their own CTA). */
  hideFoot?: boolean;
}

const DEFAULT_COLS = ["Box-based SDWAN", "Tailscale / Netbird"] as const;

const DEFAULT_ROWS: readonly Row[] = [
  {
    label: "Hardware needed",
    cells: [
      "₹35,000–₹2,50,000 per site",
      "Existing routers, but an agent on every device",
    ],
    us: "Existing routers, nothing else",
  },
  {
    label: "Time to first tunnel",
    cells: [
      "2–8 weeks (shipping, install)",
      "Days",
    ],
    us: "2 minutes",
  },
  {
    label: "Price",
    cells: [
      "₹2,500–₹7,000 / site / month + licensing",
      "₹420–500 / user / month",
    ],
    us: "₹349 / machine / month",
  },
  {
    label: "Vendor lock-in",
    cells: [
      "Yes — hardware + license",
      "Mostly",
    ],
    us: "None — standard WireGuard, move your peers any time",
  },
  {
    label: "Works at home too",
    cells: [
      "No",
      "Limited",
    ],
    us: "Yes — same product",
  },
];

const {
  id           = "compare",
  eyebrow      = "/ compare",
  title        = "Why pay ₹25 lakhs for what your hardware already does?",
  lede         = "A typical 20-branch SDWAN deployment runs ₹30 lakhs+ in hardware plus ₹30,000/month in licensing — before anything actually works. MeshWG meshes the same 20 branches for ₹7,000 a month and starts working today.",
  cols         = DEFAULT_COLS,
  rows         = DEFAULT_ROWS,
  footLinkText = "How it actually works under the hood →",
  footLinkHref = "/docs",
  hideFoot     = false,
} = Astro.props;
---

<section id={id} class="compare-section">
  <div class="wrap">
    <div class="sec-eyebrow">{eyebrow}</div>
    <h2 class="sec-h">{title}</h2>
    <p class="sec-lede">{lede}</p>

    <div class="compare-wrap">
      <table class="compare">
        <thead>
          <tr>
            <th class="rh"></th>
            {cols.map((c) => (
              <th>{c}</th>
            ))}
            <th class="us">MeshWG</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td class="rh">{r.label}</td>
              {r.cells.map((c) => (
                <td>{c}</td>
              ))}
              <td class="us">{r.us}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {!hideFoot && (
      <div class="compare-foot">
        <a class="cf-link" href={footLinkHref}>{footLinkText}</a>
      </div>
    )}
  </div>
</section>

<style>
  .compare-section { padding: 32px 0 40px; }
  .compare-section .sec-h, .compare-section .sec-lede {
    text-wrap: unset;
    max-width: none;
  }
  /* Editorial comparison table — acid-tinted MeshWG column on a
     subtle vertical gradient, mono uppercase column headers, serif
     italic row labels would feel out of register so labels stay in
     the mono signature instead. */
  .compare-wrap {
    margin-top: 64px;
    border: 1px solid navy;
    border-radius: var(--radius-lg);
    overflow: hidden;
    overflow-x: auto;
  }
  .compare {
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
    min-width: 760px;
  }
  .compare th, .compare td {
    text-align: left;
    padding: 22px 24px;
    border-bottom: 1px solid navy;
    vertical-align: top;
    line-height: 1.5;
    color: var(--text-2);
  }
  .compare thead th {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-3);
    font-weight: 500;
    background: var(--bg-2);
    padding: 26px 24px;
  }
  .compare thead th.us {
    color: var(--accent);
    background: linear-gradient(180deg, var(--accent-soft), color-mix(in oklab, var(--accent-soft) 50%, transparent));
  }
  .compare td.rh, .compare th.rh {
    color: var(--text-3);
    width: 220px;
    background: var(--bg-2);
    font-family: var(--font-mono);
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .compare td.us {
    background: linear-gradient(180deg, color-mix(in oklab, var(--accent-soft) 70%, transparent), color-mix(in oklab, var(--accent-soft) 40%, transparent));
    border-left: 1px solid var(--accent-soft);
    color: var(--text);
    font-weight: 400;
  }
  .compare td.us strong, .compare td.us b {
    color: var(--accent);
    font-weight: 500;
  }
  .compare tbody tr:last-child td { border-bottom: 0; }
  .compare tbody tr:hover td:not(.rh):not(.us) { background: var(--bg-3); }

  .compare-foot {
    margin-top: 24px;
    text-align: center;
  }
  .cf-link {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--accent);
    transition: color .12s ease;
  }
  .cf-link:hover { color: var(--accent-strong); }

  @media (max-width: 980px) {
    .compare th, .compare td { padding: 12px 14px; font-size: 13px; }
  }
</style>
