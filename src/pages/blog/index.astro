---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { posts } from "../../utils/posts";

const title = "Blog — MeshWG";
const description = "Founder-written notes on branch networking, WireGuard, mesh VPN, and connecting the routers you already own.";

const featuredPost = posts[0];
const gridPosts = posts.slice(1); // Show all remaining posts in the grid

const formatDate = (dateStr) => {
  if (!dateStr) return "";
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
};
---

<Base title={title} description={description}>
  <Nav />
  
  <BlogLayout isHomepage={true}>
    <div class="mag-header">
      <h1 class="mag-h1">MeshWG Engineering & Strategy Blog</h1>
      <p class="mag-desc">Expert articles on mesh networks, WireGuard, routing, & IT infrastructure</p>
    </div>
    
    <div class="mag-pill-row">
      <div class="mag-pill pill-orange">NEWEST ARTICLES</div>
      <span class="mag-subtext">Latest from our experts</span>
    </div>

    <!-- Featured Post -->
    <a href={`/blog/${featuredPost.slug}/`} class="mag-featured hover-card" data-tilt>
      <div class="feat-img">
        <img src="/multi-location-routers.png" alt="Multi-Location Router Network" style="width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0;" />
        <!-- Sleek Placeholder Mesh Gradient -->
        <div class="mesh-bg" style="opacity: 0.2;"></div>
      </div>
      <div class="feat-content">
        <div class="mag-pill-row" style="margin-bottom: 8px;">
          <div class={`mag-pill ${featuredPost.category === 'STRATEGY & ARCHITECTURE' ? 'pill-purple' : 'pill-orange'}`}>{featuredPost.category}</div>
          <div class="mag-pill pill-red">NEW</div>
        </div>
        <h2 class="feat-t">{featuredPost.title}</h2>
        <p class="feat-d">{featuredPost.description}</p>
        <div class="feat-meta">
          <span>{formatDate(featuredPost.datePublished)}</span>
          <span class="dot">·</span>
          <span>{featuredPost.readMinutes} min read</span>
          <span class="dot">·</span>
          <span class="read-link">Read article &rarr;</span>
        </div>
      </div>
    </a>

    <!-- Grid Posts -->
    <div class="mag-grid">
      {gridPosts.map((p, i) => (
        <a href={`/blog/${p.slug}/`} class="mag-card hover-card" data-tilt>
          <!-- High quality tech image -->
          <div class="card-img-wrapper">
            <img src={`/images/tech_net_${(i % 3) + 1}.png`} alt="" style="width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0;" />
          </div>
          <div class="card-content">
            <div class={`mag-pill ${p.category === 'STRATEGY & ARCHITECTURE' ? 'pill-purple' : 'pill-orange'}`} style="margin-bottom: 12px;">{p.category}</div>
            <h3 class="card-t">{p.title}</h3>
            <p class="card-d">{p.description}</p>
            <div class="feat-meta" style="margin-top: auto; padding-top: 10px;">
              <span>{formatDate(p.datePublished)}</span>
              <span class="dot">·</span>
              <span>{p.readMinutes} min read</span>
              <span class="dot">·</span>
              <span class="read-link">Read article &rarr;</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- HIGH-VOLUME SEO: Blog Breadcrumbs & ItemList -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://meshwg.com/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://meshwg.com/blog/" },
      ],
    })}></script>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Blog",
      "@id": "https://meshwg.com/blog/#blog",
      "name": "MeshWG Blog",
      "description": description,
      "url": "https://meshwg.com/blog/",
      "publisher": {
        "@type": "Organization",
        "@id": "https://meshwg.com/#organization",
        "name": "MeshWG",
        "url": "https://meshwg.com",
      },
      "blogPost": posts.map((p) => ({
        "@type": "BlogPosting",
        "headline": p.title,
        "description": p.description,
        "url": `https://meshwg.com/blog/${p.slug}/`,
        "datePublished": p.datePublished,
      })),
    })}></script>
  </BlogLayout>

  <Footer />
</Base>

<style>
  .mag-pill {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 99px;
    letter-spacing: .05em;
    text-transform: uppercase;
    margin-bottom: 12px;
    width: max-content;
  }
  .pill-orange { color: #fff; background: #c2410c; }
  .pill-red { color: #fff; background: #b91c1c; }
  .pill-purple { color: #fff; background: #6d28d9; }
  .pill-blue { color: #fff; background: #1F4FD8; }

  .mag-header {
    margin-bottom: 24px;
    text-align: left;
  }
  .mag-h1 {
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: -.02em;
    margin-bottom: 8px;
    color: var(--text);
    font-family: var(--font-sans);
  }
  .mag-desc {
    font-family: var(--font-body);
    color: var(--text-3);
    font-size: 16px;
    margin: 0;
  }

  .mag-pill-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }
  .mag-subtext {
    font-size: 13px;
    color: var(--text-4);
  }

  /* Shared Mesh Background */
  .mesh-bg {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(circle at 0% 0%, rgba(22, 119, 255, 0.2) 0%, transparent 60%),
                radial-gradient(circle at 100% 100%, rgba(249, 115, 22, 0.15) 0%, transparent 60%);
    background-color: #1e293b;
  }
  .card-mesh { background-color: #0f172a; }

  /* Featured Article */
  .mag-featured {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 2px solid #1E3A8A;
    border-radius: 20px;
    overflow: hidden;
    background: #fff;
    color: inherit;
    text-decoration: none;
    min-height: 240px;
    height: auto;
    transition: all .3s ease;
    margin-bottom: 48px;
    box-shadow: 0 4px 20px #0000000d;
  }
  .feat-img {
    position: relative;
    background: var(--bg-2);
    overflow: hidden;
    height: 100%;
  }
  .feat-content {
    padding: 24px 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .feat-t {
    font-size: 1.35rem;
    margin: 0 0 8px;
    line-height: 1.25;
    letter-spacing: -.01em;
    font-weight: 800;
    color: #0f172a;
    font-family: var(--font-heading);
  }
  .feat-d {
    font-size: .95rem;
    color: #475569;
    margin: 0 0 16px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.5;
    font-family: var(--font-body);
  }
  .feat-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-4);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
  }
  .feat-meta span {
    white-space: nowrap;
  }
  .read-link {
    color: #c2410c;
    font-weight: 700;
    font-family: var(--font-body);
    font-size: 13px;
  }

  /* Grid Posts */
  .mag-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .mag-card {
    display: flex;
    flex-direction: column;
    border: 2px solid #1E3A8A;
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    box-shadow: 0 4px 20px -2px #1e3a8a0d;
    transition: all .3s cubic-bezier(.16,1,.3,1);
  }
  .mag-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px -4px #1e3a8a1a;
  }
  .card-img-wrapper {
    width: 100%;
    height: 140px;
    min-height: 140px;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    position: relative;
    flex-shrink: 0;
  }
  .card-img-wrapper img {
    transition: transform .5s ease;
  }
  .mag-card:hover .card-img-wrapper img {
    transform: scale(1.05);
  }
  .card-content {
    padding: 16px 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .card-t {
    font-size: 1rem;
    margin: 0 0 8px;
    line-height: 1.3;
    letter-spacing: -.01em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-weight: 700;
    font-family: var(--font-heading);
    color: var(--text);
  }
  .card-d {
    font-size: 13px;
    color: var(--text-3);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.5;
    font-family: var(--font-body);
  }

  @media (max-width: 768px) {
    .mag-featured { grid-template-columns: 1fr; }
    .feat-img { height: 200px; border-right: none; border-bottom: 1px solid var(--border-faint); }
    .mag-grid { grid-template-columns: 1fr; }
  }
</style>
