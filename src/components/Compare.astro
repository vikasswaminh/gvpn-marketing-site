---
// Comparison points use only verifiable claims for the MeshWG column.
// SDWAN-appliance side uses generic well-known vendor characteristics,
// not specific made-up prices.
const rows = [
  { label: "Hardware cost per site",       them: "$400 – $2,000 list",                                us: "$0 — uses the WireGuard already in your router" },
  { label: "Tunnel protocol",              them: "Vendor-proprietary IPSec / GRE",                    us: "Standard WireGuard (RFC-equivalent)" },
  { label: "Lead time to deploy",          them: "Weeks (procure, ship, install)",                    us: "Minutes (paste a wg-quick config)" },
  { label: "Lock-in",                      them: "Hardware + license + RMA dependencies",             us: "None — config + keys are yours, MIT licensed code" },
  { label: "Multi-vendor support",         them: "Single vendor",                                     us: "Anything that runs WireGuard" },
  { label: "Site-to-site policy",          them: "Yes",                                               us: "Yes — iptables-enforced, kernel-level" },
  { label: "Multi-port / port-range ACLs", them: "Varies by vendor / license tier",                   us: "Yes — `tcp 443,8000-8100` syntax" },
  { label: "Tenant isolation",             them: "VRFs or separate appliances",                       us: "Linux network namespaces — verified by tcpdump test" },
  { label: "Internet egress through hub",  them: "Configurable",                                      us: "Explicitly not provided — pure overlay relay" },
  { label: "If the vendor disappears",     them: "Box becomes a brick",                               us: "wg-quick keeps running; source is on GitHub" },
];
---

<section id="compare" style="background: var(--bg-2);">
  <div class="wrap">
    <div class="sec-eyebrow">vs. SDWAN appliances</div>
    <h2 class="sec-h">The cheapest SDWAN is the one you already deployed.</h2>
    <p class="sec-lede">
      Box-based SDWAN appliances cost hundreds to thousands of dollars per
      site plus annual licensing. For 20 branches that is real money.
      MeshWG uses the WireGuard implementation that is already in your AP.
    </p>

    <div class="compare">
      <table>
        <thead>
          <tr>
            <th></th>
            <th>
              Box-based SDWAN
              <span class="sub">Cisco Meraki MX, Fortinet, VeloCloud</span>
            </th>
            <th class="us">
              MeshWG
              <span class="sub">Open-source · self-hosted</span>
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td>{r.label}</td>
              <td>{r.them}</td>
              <td class="us">{r.us}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .compare {
    margin-top: 48px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .compare table { width: 100%; border-collapse: collapse; }
  .compare th, .compare td {
    text-align: left; padding: 16px 20px; font-size: 13.5px;
    border-bottom: 1px solid var(--border);
  }
  .compare thead th {
    font-size: 11.5px; text-transform: uppercase; letter-spacing: .1em;
    color: var(--text-3); font-weight: 500;
    background: var(--surface-2);
  }
  .compare thead th .sub {
    display: block;
    font-weight: 400; text-transform: none; letter-spacing: 0;
    color: var(--text-4);
    margin-top: 3px;
  }
  .compare thead th.us {
    color: var(--accent);
    background: color-mix(in oklab, var(--accent) 6%, var(--surface));
  }
  .compare thead th.us .sub { color: var(--accent); opacity: .7; }
  .compare td.us {
    background: color-mix(in oklab, var(--accent) 4%, var(--surface));
    font-weight: 500;
  }
  .compare tr:last-child td { border-bottom: 0; }

  @media (max-width: 980px) {
    .compare th, .compare td { padding: 12px; font-size: 12.5px; }
  }
</style>
