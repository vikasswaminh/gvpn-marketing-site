---
import BrandMark from "./BrandMark.astro";
import { site } from "../site";
---
<nav class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/">
      <BrandMark />
      <span class="brand-name">{site.productName}</span>
    </a>
    <div class="nav-links">
      <a href="/quickstart">Quickstart</a>
      <a href="/docs">Docs</a>
      <a href="/compatibility">Compatibility</a>
      <a href="/blog">Blog</a>
      <a href="/pricing">Pricing</a>
    </div>
    <div class="nav-spacer"></div>
    <div class="nav-cta">
      <a class="btn btn-ghost" href={site.signIn}>Sign in</a>
      <a class="btn btn-primary" href={site.signupFree}>Sign up free</a>
    </div>
  </div>
</nav>

<style>
  /* Fixed, transparent at top of page; on scroll past 60 px the
     IntersectionObserver script in Base.astro adds .nav--scrolled
     and the strip becomes a frosted-ink bar. */
  .nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    background: linear-gradient(
      to bottom,
      rgba(11, 11, 12, 0.92),
      rgba(11, 11, 12, 0.7) 70%,
      transparent
    );
    -webkit-backdrop-filter: saturate(160%) blur(14px);
            backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-bottom-color 0.25s ease, background 0.25s ease;
  }
  .nav--scrolled {
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    border-bottom-color: var(--border);
  }

  .nav-inner {
    height: 64px;
    display: flex;
    align-items: center;
    gap: 36px;
  }

  .brand {
    display: flex; align-items: center; gap: 10px;
    font-weight: 500;
    letter-spacing: -0.005em;
    font-size: 15px;
    color: var(--text);
  }
  .brand-name { color: var(--text); }

  .nav-links {
    display: flex;
    gap: 26px;
    font-size: 13px;
    color: var(--text-2);
  }
  .nav-links a {
    position: relative;
    padding: 4px 0;
    transition: color 0.15s ease;
  }
  .nav-links a::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s cubic-bezier(0.6, 0.05, 0.2, 1);
  }
  .nav-links a:hover { color: var(--text); }
  .nav-links a:hover::after { transform: scaleX(1); }

  .nav-spacer { flex: 1; }
  .nav-cta { display: flex; gap: 6px; align-items: center; }

  @media (max-width: 980px) {
    .nav-links { display: none; }
    .nav-inner { gap: 16px; }
    .nav-cta .btn-ghost { display: none; }
  }
</style>
