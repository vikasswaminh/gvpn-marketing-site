---
const features = [
  {
    title: "Connect any device",
    body: "Routers, laptops, phones, servers. If it speaks WireGuard, it joins your mesh in seconds.",
  },
  {
    title: "One-click access rules",
    body: "Decide who reaches what — by machine, port, or protocol. Updates apply instantly across your whole network.",
  },
  {
    title: "Built-in isolation",
    body: "Each organization lives in its own private network. Different teams or clients can't see each other, ever.",
  },
  {
    title: "Encrypted end-to-end",
    body: "Standard WireGuard. We can't read your traffic. Your ISP can't read it. No one can.",
  },
  {
    title: "Survives our outages",
    body: "If MeshWG goes offline, your tunnels keep running. WireGuard lives on your devices, not on our servers.",
  },
  {
    title: "Two machines free, forever",
    body: "Mesh your laptop and your home router at ₹0/month. No trial countdown, no card. Pay only when you add a third.",
  },
];
---

<section id="features">
  <div class="wrap">
    <div class="sec-eyebrow">/ features</div>
    <h2 class="sec-h">Everything you need. Nothing you don't.</h2>
    <p class="sec-lede">
      A small, focused product instead of an enterprise checklist with
      a hundred boxes you'll never tick.
    </p>

    <div class="feature-grid">
      {features.map((f) => (
        <article class="feature">
          <h4 class="ft-title">{f.title}</h4>
          <p class="ft-body">{f.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Editorial feature grid — hairline-divided cells on the ink canvas,
     serif italic titles, ultra-light body. Hover ramps the surface
     up a step (no shadow, just contrast). */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 64px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 0;
  }
  .feature {
    background: var(--bg);
    padding: 36px 32px 40px;
    transition: background 0.2s ease;
    position: relative;
  }
  .feature:hover { background: var(--bg-2); }

  .ft-title {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 400;
    letter-spacing: -0.01em;
    margin: 0 0 12px;
    color: var(--text);
    line-height: 1.1;
  }
  .ft-body {
    color: var(--text-2);
    font-size: 14.5px;
    line-height: 1.6;
    margin: 0;
    font-weight: 400;
  }

  @media (max-width: 980px) {
    .feature-grid { grid-template-columns: 1fr; }
    .feature {
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
    .feature:last-child { border-bottom: 0; }
    .feature:nth-child(3n) { border-right: 0; }
    .feature:nth-last-child(-n+3) { border-bottom: 1px solid var(--border); }
  }
</style>
