---
const cols = ["Box-based SDWAN", "Tailscale / Netbird"] as const;

const rows = [
  {
    label: "Hardware needed",
    cells: [
      "$400–$2,999 per site",
      "Existing routers, but an agent on every device",
    ],
    us: "Existing routers, nothing else",
  },
  {
    label: "Time to first tunnel",
    cells: [
      "2–8 weeks (shipping, install)",
      "Days",
    ],
    us: "2 minutes",
  },
  {
    label: "Price",
    cells: [
      "$30–80 / site / month + licensing",
      "$5–6 / user / month",
    ],
    us: "$1 / machine / month",
  },
  {
    label: "Vendor lock-in",
    cells: [
      "Yes — hardware + license",
      "Mostly",
    ],
    us: "None — standard WireGuard, move your peers any time",
  },
  {
    label: "Works at home too",
    cells: [
      "No",
      "Limited",
    ],
    us: "Yes — same product",
  },
];
---

<section id="compare">
  <div class="wrap">
    <div class="sec-eyebrow">/ compare</div>
    <h2 class="sec-h">Why pay $30,000 for what your hardware already does?</h2>
    <p class="sec-lede">
      A typical 20-branch SDWAN deployment runs $40,000+ in hardware plus
      $400/month in licensing — before anything actually works. MeshWG
      meshes the same 20 branches for $20 a month and starts working today.
    </p>

    <div class="compare-wrap">
      <table class="compare">
        <thead>
          <tr>
            <th class="rh"></th>
            {cols.map((c) => (
              <th>{c}</th>
            ))}
            <th class="us">MeshWG</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td class="rh">{r.label}</td>
              {r.cells.map((c) => (
                <td>{c}</td>
              ))}
              <td class="us">{r.us}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="compare-foot">
      <a class="cf-link" href="/docs">How it actually works under the hood →</a>
    </div>
  </div>
</section>

<style>
  .compare-wrap {
    margin-top: 64px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow-x: auto;
  }
  .compare {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    min-width: 760px;
  }
  .compare th, .compare td {
    text-align: left;
    padding: 16px 18px;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    line-height: 1.5;
  }
  .compare thead th {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--text-3);
    font-weight: 500;
    background: var(--bg-2);
  }
  .compare thead th.us {
    color: var(--accent);
    background: var(--accent-soft);
  }
  .compare td.rh, .compare th.rh {
    color: var(--text-3);
    width: 200px;
    background: var(--bg-2);
    font-family: var(--font-mono);
    font-size: 11.5px;
  }
  .compare td.us {
    background: color-mix(in oklab, var(--accent) 3%, var(--surface));
    color: var(--text);
    font-weight: 500;
  }
  .compare tbody tr:last-child td { border-bottom: 0; }

  .compare-foot {
    margin-top: 24px;
    text-align: center;
  }
  .cf-link {
    font-size: 13.5px;
    color: var(--accent);
    transition: color .12s ease;
  }
  .cf-link:hover { color: var(--accent-strong); }

  @media (max-width: 980px) {
    .compare th, .compare td { padding: 12px 14px; font-size: 13px; }
  }
</style>
