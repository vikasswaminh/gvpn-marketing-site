---
import Base       from "../../layouts/Base.astro";
import Nav        from "../../components/Nav.astro";
import PageHero   from "../../components/PageHero.astro";
import ValueStrip from "../../components/ValueStrip.astro";
import Footer     from "../../components/Footer.astro";

const title = "MeshWG by industry: multi-site networking for retail, healthcare, hospitality & logistics";
const description = "How multi-branch businesses connect their sites with MeshWG — retail chains, clinics and diagnostic labs, hotels and restaurants, distributors and warehouses. Per-router pricing, works with existing routers, 24/7 support.";
const canonical = "https://meshwg.com/industries/";
const publishedTime = "2026-05-22T00:00:00Z";
const modifiedTime  = "2026-05-22T00:00:00Z";

const industries = [
  { name: "Retail chains",         url: "/industries/retail/",       summary: "Connect point-of-sale, back-office, and CCTV across every store. Central inventory and reporting without an SD-WAN appliance at each location." },
  { name: "Healthcare",            url: "/industries/healthcare/",   summary: "Link clinics, diagnostic labs, and the central practice management system. Keep patient data on a private overlay, never on the open internet." },
  { name: "Hospitality",           url: "/industries/hospitality/",  summary: "Connect hotels and restaurant outlets to head office for property management, billing, and CCTV — without a network engineer on staff." },
  { name: "Logistics & distribution", url: "/industries/logistics/", summary: "Tie warehouses, branch depots, and the central ERP into one private network so stock and dispatch data move in real time." },
];

const itemListSchema = { "@context": "https://schema.org", "@type": "ItemList",
  "name": "MeshWG industry solutions", "numberOfItems": industries.length,
  "itemListElement": industries.map((g, i) => ({ "@type": "ListItem", "position": i + 1,
    "name": g.name, "url": "https://meshwg.com" + g.url })) };
const breadcrumbSchema = { "@context": "https://schema.org", "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home",       "item": "https://meshwg.com/" },
    { "@type": "ListItem", "position": 2, "name": "Industries", "item": canonical } ] };
---

<Base title={title} description={description} canonical={canonical} ogType="website">
  <Nav />
  <PageHero
    eyebrow="/ industries"
    title="Multi-site networking, by industry"
    lede="Every multi-branch business has the same core problem — connect the sites, keep the data private, don't hire a network team. Here is how MeshWG fits each industry."
  />
  <ValueStrip />

  <section class="guide">
    <div class="wrap">
      <article>
        <h2>Pick your industry</h2>
        <ul class="card-list">
          {industries.map((g) => (
            <li>
              <a class="card" href={g.url}>
                <div class="card-h">{g.name} →</div>
                <p>{g.summary}</p>
              </a>
            </li>
          ))}
        </ul>

        <h2>The pattern every multi-branch business shares</h2>
        <p>A retail chain, a chain of diagnostic labs, a group of hotels, a distributor with regional warehouses — on paper they're different businesses. On the network they have the identical problem: several physical sites, each with its own internet connection and router, that need to behave as one private network so head-office systems, point-of-sale or practice-management software, CCTV, and reporting all work across locations.</p>
        <p>The traditional answer is SD-WAN: a dedicated appliance at every site, a licensing contract, and usually a managed-service provider to run it. That works — and for a 20-branch business it runs ₹30 lakh+ in hardware plus tens of thousands per month in licensing before anything is connected.</p>
        <p>MeshWG is the alternative built for businesses that can't justify that. It runs on the routers each site already has — TP-Link, MikroTik, OpenWrt, OPNsense, pfSense, Ubiquiti, Asus, GL.iNet — turning them into one private mesh. Per-router pricing (₹349 ≈ $4.20/month, first 2 free), 2-minute onboarding per site, 24/7 human support, no appliance to buy and no network engineer to hire.</p>

        <div class="next">
          <h2>Try it free</h2>
          <p>Two routers free forever, no card. Add a third when you connect your next site.</p>
          <div class="cta-row">
            <a class="btn btn-primary btn-lg" href="https://vpn.meshwg.com/signup">Start free → 2 routers</a>
            <a class="btn btn-line btn-lg" href="/pricing">See pricing</a>
          </div>
          <p class="related">
            See also:
            <a href="/wireguard-router/">8 router families that work with MeshWG</a> ·
            <a href="/blog/branch-office-vpn-smb-rollout-playbook-2026/">Branch-office VPN rollout playbook</a>
          </p>
        </div>
      </article>
    </div>
  </section>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Base>

<style>
  .guide { padding: 64px 0 128px; }
  article { max-width: 880px; margin: 0 auto; }
  .guide h2 { font-family: var(--font-display); font-size: 28px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.15; margin: 56px 0 16px; color: var(--text); text-wrap: balance; }
  .guide h2:first-child { margin-top: 0; }
  .guide p { color: var(--text-2); font-size: 15.5px; line-height: 1.7; margin: 0 0 16px; }
  .guide strong { color: var(--text); font-weight: 600; } .guide a { color: var(--accent); } .guide a:hover { color: var(--accent-strong); }
  .card-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .card { display: block; padding: 22px 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-xl); transition: border-color 0.15s ease, box-shadow 0.15s ease; color: inherit; text-decoration: none; }
  .card:hover { border-color: var(--accent); box-shadow: var(--shadow-card); color: inherit; }
  .card-h { font-family: var(--font-display); font-size: 17px; font-weight: 600; color: var(--text); margin-bottom: 8px; }
  .card p { color: var(--text-3); font-size: 14px; line-height: 1.6; margin: 0; }
  .next { margin-top: 64px; padding: 32px 36px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-xl); }
  .next h2 { margin-top: 0; font-size: 24px; } .cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin: 18px 0; }
  .related { font-size: 14px; color: var(--text-3); margin-top: 24px; } .related a { margin: 0 4px; }
  @media (max-width: 820px) { .card-list { grid-template-columns: 1fr; } .guide { padding: 32px 0 64px; } .next { padding: 22px 22px; } }
</style>
