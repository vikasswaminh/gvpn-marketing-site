---
import { site } from "../site";

const plans = [
  {
    key: "free",
    name: "FREE",
    price: "₹0",
    unit: "forever",
    description: "Start meshing today. Free for as long as you stay small.",
    bullets: [
      "2 machines",
      "Hosted by us — nothing to install",
      "Google or email sign-in",
      "All access-control features",
    ],
    ctaLabel: "Sign up free",
    ctaHref: site.signupFree,
    ctaExternal: true,
    accent: false,
  },
  {
    key: "cloud",
    name: "CLOUD",
    price: "₹349",
    unit: "/ machine / month",
    sub: "or ₹499 / machine / month, billed monthly",
    description: "For growing meshes. Same hosted product, no machine limit.",
    bullets: [
      "Unlimited machines",
      "Audit log",
      "Email support",
      "Cancel anytime",
    ],
    ctaLabel: "Sign up free",
    ctaHref: site.signupFree,
    ctaExternal: true,
    accent: true,
  },
  {
    key: "pro",
    name: "PRO",
    price: "Custom",
    unit: "talk to us",
    description: "Bigger fleets, dedicated infrastructure, custom needs.",
    bullets: [
      "Dedicated infrastructure",
      "Custom domain (acme.meshwg.com)",
      "Priority support",
      "SLA on request",
    ],
    ctaLabel: "Talk to us",
    ctaHref: site.proContact,
    ctaExternal: false,
    accent: false,
  },
];
---

<section id="pricing">
  <div class="wrap">
    <div class="sec-eyebrow" data-reveal>/ PRICING</div>
    <h2 class="sec-h" data-reveal data-reveal-delay="100">
      Simple pricing. <span class="blue">Per machine.</span> No surprises.
    </h2>
    <p class="sec-lede" data-reveal data-reveal-delay="200">
      A "machine" is anything in your mesh — a router, a laptop, a phone,
      or a server. Two free forever; ₹349 each after that on annual billing.
    </p>

    <div class="price-grid">
      {plans.map((p, i) => (
        <article class={`plan${p.accent ? " plan-accent" : ""}`} data-tilt data-reveal data-reveal-delay={100 + (i * 100)}>
          {p.accent && <div class="badge">MOST POPULAR</div>}
          
          <header>
            <div class="plan-name">{p.name}</div>
            <div class="plan-price">
              <span class="num">{p.price}</span>
            </div>
            {p.unit && <div class="plan-unit">{p.unit}</div>}
            {p.sub && <div class="plan-sub">{p.sub}</div>}
          </header>

          <p class="plan-desc">{p.description}</p>

          <div class="plan-divider"></div>

          <ul class="plan-list">
            {p.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>

          <a
            class={`btn ${p.accent ? "btn-primary" : "btn-line"} plan-cta`}
            href={p.ctaHref}
            target={p.ctaExternal ? "_blank" : undefined}
            rel={p.ctaExternal ? "noopener" : undefined}>
            {p.ctaLabel}
          </a>
        </article>
      ))}
    </div>

    <p class="price-foot">
      <strong>No credit card to start.</strong> Two machines stay free as long as you want — add a third only when you're ready to grow.
    </p>

    <div class="price-detail-link">
      <a class="accent-link" href="/pricing">See full pricing, calculator, and billing FAQ →</a>
    </div>
  </div>
</section>

<style>
  #pricing { padding: 32px 0 16px; }
  #pricing .sec-h, #pricing .sec-lede {
    text-wrap: unset;
    max-width: none;
  }
  #pricing .blue {
    color: #2563EB;
  }

  .price-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 64px;
  }

  .plan {
    background: #ffffff;
    border: 2px solid #1a1a1a;
    border-radius: 12px;
    padding: 24px;
    display: flex; 
    flex-direction: column;
    position: relative;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1);
  }
  
  .plan-accent {
    border-color: #2563EB;
    background: #EFF6FF;
    box-shadow: 0 12px 32px rgba(37, 99, 235, 0.15);
  }
  
  .badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: #2563EB;
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 4px 16px;
    border-radius: 20px;
    white-space: nowrap;
  }

  .plan-name {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-3);
    margin-bottom: 16px;
  }

  .plan-price {
    display: flex; 
    align-items: center; 
    gap: 8px;
    margin-bottom: 4px;
  }
  
  .plan-price .num {
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--text);
  }
  
  .plan-accent .plan-price .num {
    color: #2563EB;
  }

  .plan-unit {
    font-size: 14px;
    color: var(--text-2);
    margin-bottom: 4px;
  }

  .plan-sub {
    font-size: 13px;
    color: var(--text-3);
  }
  
  /* For Cloud plan, keep unit on same line roughly if possible, but the design puts it below or beside. 
     We'll adjust to keep it close to the num */
  .plan-accent .plan-unit, .plan-accent .plan-sub {
    color: #64748B;
  }
  .plan-accent .plan-price {
    display: inline-flex;
    align-items: baseline;
  }
  .plan-accent .plan-unit {
    display: inline;
    margin-left: 8px;
  }

  .plan-desc {
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.5;
    margin: 16px 0 0;
  }

  .plan-divider {
    height: 1px;
    background: #E2E8F0;
    margin: 16px 0;
  }
  .plan-accent .plan-divider {
    background: #DBEAFE;
  }

  .plan-list {
    list-style: none;
    padding: 0; 
    margin: 0;
    display: flex; 
    flex-direction: column; 
    gap: 8px;
    flex: 1;
    margin-bottom: 24px;
  }
  
  .plan-list li {
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.5;
  }

  .plan-cta {
    justify-content: center;
    width: 100%;
    height: 48px;
    font-weight: 600;
  }

  .btn-line {
    background: #ffffff;
    border: 2px solid #1a1a1a;
    color: var(--text);
  }
  .btn-line:hover {
    border-color: #1a1a1a;
    background: #F8FBFF;
  }
  
  .btn-primary {
    background: #2563EB;
    border: none;
    color: #ffffff;
  }
  .btn-primary:hover {
    background: #1D4ED8;
  }

  .price-foot {
    margin: 48px 0 0;
    font-size: 14px;
    color: var(--text-2);
    text-align: center;
    line-height: 1.6;
  }
  .price-foot strong { 
    color: var(--text); 
    font-weight: 600; 
  }

  .price-detail-link {
    margin: 16px 0 0;
    display: flex;
    justify-content: center;
  }
  
  .accent-link {
    color: #2563EB;
    font-weight: 500;
    font-size: 14px;
    transition: color 0.15s ease;
  }
  .accent-link:hover {
    color: #1D4ED8;
  }

  @media (max-width: 980px) {
    .price-grid { grid-template-columns: 1fr; }
  }
</style>
