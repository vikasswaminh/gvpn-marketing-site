---
// Six families that ship native WireGuard. No commercial partnership
// claim — the test is simply "does this device speak wg-quick".
const vendors = [
  { tag: "TP", name: "TP-Link",   sub: "Archer · Deco · ER",      color: "#4ACBD6" },
  { tag: "MT", name: "MikroTik",  sub: "RouterOS 7+",             color: "#293239" },
  { tag: "OW", name: "OpenWrt",   sub: "19.07+",                  color: "#F08000" },
  { tag: "UI", name: "Ubiquiti",  sub: "UDM · EdgeRouter",        color: "#0559C9" },
  { tag: "OP", name: "OPNsense",  sub: "pfSense too",             color: "#D94F00" },
  { tag: "WG", name: "Linux/Mac/Win", sub: "Official WireGuard apps",  color: "#0a0a0a" },
];
---
<section class="trust-section">
  <div class="wrap">
    <div class="trust-strip">
      <div class="trust-cell">
        <span class="trust-value">99.9%</span>
        <span class="trust-label">Global Uptime</span>
      </div>
      <div class="trust-cell">
        <span class="trust-value">&lt;12ms</span>
        <span class="trust-label">Avg. Latency</span>
      </div>
      <div class="trust-cell">
        <span class="trust-value">Zero</span>
        <span class="trust-label">Config Required</span>
      </div>
      <div class="trust-cell">
        <span class="trust-value">256-bit</span>
        <span class="trust-label">Encryption</span>
      </div>
    </div>
  </div>
</section>

<section class="vendor-section">
  <div class="wrap">
    <div class="lbl-row">
      <div class="lbl">If it runs WireGuard, it works with MeshWG</div>
      <a class="see-all" href="/compatibility">View all 57 supported routers →</a>
    </div>
    <div class="marquee-container">
      <div class="vendor-row animate-marquee">
        {vendors.map((v) => (
          <div class="vendor-tile">
            <span class="vlogo" style={`background:${v.color}`}>{v.tag}</span>
            <div>
              <div class="vname">{v.name}</div>
              <div class="vsub">{v.sub}</div>
            </div>
          </div>
        ))}
        {vendors.map((v) => (
          <div class="vendor-tile" aria-hidden="true">
            <span class="vlogo" style={`background:${v.color}`}>{v.tag}</span>
            <div>
              <div class="vname">{v.name}</div>
              <div class="vsub">{v.sub}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .trust-section {
    padding: 24px 0 0;
  }
  .trust-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .trust-cell {
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    border-right: 1px solid var(--border);
  }
  .trust-cell:last-child { border-right: none; }
  .trust-value {
    font-size: 32px;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
    font-family: var(--font-display);
  }
  .trust-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: 4px;
  }
  .vendor-section {
    padding: 56px 0 96px;
  }
  .lbl-row {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }
  .lbl {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-3);
  }
  .see-all {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    transition: color 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .see-all:hover { color: var(--accent-strong); }
  .marquee-container {
    overflow: hidden;
    position: relative;
    width: 100%;
    /* Subtle fade on edges */
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }
  .vendor-row {
    display: flex;
    gap: 16px;
    width: max-content;
  }
  .animate-marquee {
    animation: marquee 20s linear infinite;
  }
  .animate-marquee:hover {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc(-50% - 8px)); }
  }
  .vendor-tile {
    display: flex; align-items: center; gap: 12px;
    padding: 16px 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .vendor-tile:hover {
    border-color: var(--border-strong);
    background: var(--surface-2);
  }

  .vlogo {
    width: 30px; height: 30px;
    border-radius: var(--radius-sm);
    display: grid; place-items: center;
    color: #fff;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 10.5px;
    letter-spacing: .04em;
    flex-shrink: 0;
  }
  .vname { font-size: 13.5px; font-weight: 500; color: var(--text); }
  .vsub  {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-3);
    margin-top: 2px;
  }

  @media (max-width: 980px) {
    .vendor-section { padding: 32px 0 56px; }
    .trust-strip { grid-template-columns: repeat(2, 1fr); }
    .trust-cell:nth-child(2) { border-right: none; }
    .trust-cell:nth-child(3), .trust-cell:nth-child(4) { border-top: 1px solid var(--border); }
  }
</style>
