---
/**
 * ValueStrip — compact horizontal positioning bar that sits below the
 * PageHero on every SEO content page (pillars, comparisons, model pages).
 *
 * The four value props are MeshWG's core market promise:
 *   1. Any vendor — works with all 8 router-firmware families we support
 *   2. 2-minute onboarding — speed-to-first-tunnel from signup
 *   3. 24/7 human support — round-the-clock incident response
 *   4. Free for 2 routers, forever — entry-tier hook
 *
 * Visual design: light surface bar, mono-font feature pills, primary CTA
 * on the right. Subtle enough not to overshadow the article hero;
 * prominent enough that every page lands the positioning above the fold.
 */
---

<aside class="value-strip" aria-label="What MeshWG offers">
  <div class="wrap value-strip-inner">
    <ul class="value-pills">
      <li>
        <span class="pill-icon" aria-hidden="true">✦</span>
        <span class="pill-text">Any vendor mesh VPN</span>
      </li>
      <li>
        <span class="pill-icon" aria-hidden="true">✦</span>
        <span class="pill-text">2-minute onboarding</span>
      </li>
      <li>
        <span class="pill-icon" aria-hidden="true">✦</span>
        <span class="pill-text">24/7 human support</span>
      </li>
      <li>
        <span class="pill-icon" aria-hidden="true">✦</span>
        <span class="pill-text">Free for 2 routers, forever</span>
      </li>
    </ul>
    <a class="value-cta" href="https://vpn.meshwg.com/signup">Start free →</a>
  </div>
</aside>

<style>
  .value-strip {
    background: linear-gradient(180deg, var(--bg-2) 0%, var(--surface) 100%);
    border-bottom: 1px solid var(--border);
    padding: 14px 0;
    font-size: 13px;
  }
  .value-strip-inner {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    justify-content: space-between;
  }
  .value-pills {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 6px 18px;
    flex-wrap: wrap;
  }
  .value-pills li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-2);
    line-height: 1.2;
    white-space: nowrap;
  }
  .pill-icon {
    color: var(--accent);
    font-size: 14px;
    line-height: 1;
  }
  .pill-text {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.01em;
    color: var(--text);
    font-weight: 500;
  }
  .value-cta {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 14px;
    background: var(--ink);
    color: #fff !important;
    border-radius: var(--radius);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    transition: background 0.15s ease;
  }
  .value-cta:hover { background: var(--text-2); }

  @media (max-width: 820px) {
    .value-strip { padding: 12px 0; }
    .value-strip-inner { gap: 12px; }
    .value-pills { gap: 6px 14px; }
    .pill-text { font-size: 11.5px; }
    .value-cta { height: 30px; padding: 0 12px; font-size: 12.5px; }
  }
</style>
