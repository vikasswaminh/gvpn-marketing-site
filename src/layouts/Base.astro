---
import "../styles/tokens.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Hosted SDWAN + ZTNA on standard WireGuard. Mesh the routers, laptops, and servers you already own — two machines free, forever." } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Open Graph (honest defaults) -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />

  <!-- Fonts: Geist (sans) + Geist Mono — same as the source design -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Plausible analytics, self-hosted at analytics.networkershome.com but
       served same-origin via Cloudflare Pages Functions to defeat adblock
       filter lists (which block analytics.* hosts by default and would
       otherwise cost us ~20% of pageview data). Privacy properties are
       unchanged: still no cookies, still no fingerprinting, still no PII.
       Function source: functions/p/script.js.js and functions/p/event.js -->
  <script
    defer
    data-domain="meshwg.com"
    data-api="/p/event"
    src="/p/script.js"
  ></script>
</head>
<body>
  <slot />
</body>
</html>
