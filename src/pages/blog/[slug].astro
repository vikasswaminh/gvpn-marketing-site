---
import { getCollection } from 'astro:content';
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import BlogLayout from "../../layouts/BlogLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const title = post.data.title;
const description = post.data.description;
const pubDate = new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const readMinutes = Math.ceil((post.body ? post.body.split(/\s+/).length : 5000) / 200);
---

<Base title={title} description={description}>
  <Nav />
  
  <BlogLayout isHomepage={false}>
    <article class="blog-article">
      <header class="mag-header" style="margin-bottom: 32px;">
        <div class="mag-pill-row" style="margin-bottom: 16px;">
          <div class="mag-pill pill-purple">
            {post.data.tags && post.data.tags.includes('strategy guide') ? 'STRATEGY & ARCHITECTURE' : 'ENGINEERING GUIDE'}
          </div>
          <span class="mag-subtext" style="font-family: var(--font-mono); font-size: 13px; color: var(--text-4);">
            {pubDate}
          </span>
          <span class="mag-subtext dot" style="color: var(--text-4);">·</span>
          <span class="mag-subtext" style="font-family: var(--font-mono); font-size: 13px; color: var(--text-4);">
            {readMinutes} MIN READ
          </span>
        </div>
        <h1 class="mag-h1" style="font-size: 3rem; line-height: 1.15; margin-bottom: 24px;">{title}</h1>
        <p class="mag-desc" style="font-size: 1.25rem; line-height: 1.6; color: var(--text-3); margin-bottom: 32px;">{description}</p>
        
        <div class="post-meta-footer" style="display: flex; gap: 24px; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-bottom: 48px;">
          <div class="author-block" style="display: flex; gap: 16px; align-items: center;">
            <div class="author-avatar" style="width: 48px; height: 48px; border-radius: 50%; background: #FFF3E0; display: flex; align-items: center; justify-content: center; color: #F97316;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <div class="author-info">
              <div class="author-name" style="font-weight: 700; color: var(--text); font-family: var(--font-heading); line-height: 1.2;">{post.data.author || 'MeshWG Technical Architecture Group'}</div>
              <div class="author-role" style="font-size: 14px; color: var(--text-3); margin-top: 4px;">Network Architecture</div>
            </div>
          </div>
          <div class="tag-pills" style="display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end;">
            {post.data.tags?.map(tag => (
              <span class="tag-pill" style="padding: 6px 16px; border: 1px solid var(--border); border-radius: 99px; font-size: 13px; color: var(--text-3); background: #fff; font-family: var(--font-mono);">#{tag}</span>
            ))}
          </div>
        </div>
      </header>
      
      <div class="post-content">
        <Content />
      </div>
    </article>
  </BlogLayout>

  <Footer />
</Base>

<style is:global>
  .mag-pill-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .mag-pill {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 99px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 1;
    white-space: nowrap;
    width: max-content;
  }
  .pill-orange { background: #F97316; color: #fff; }
  .pill-purple { background: #8B5CF6; color: #fff; }
  .mag-h1 {
    font-family: var(--font-heading);
    color: var(--text);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .mag-desc {
    font-family: var(--font-body);
  }

  /* Markdown Content Styles */
  .post-content {
    font-family: var(--font-body);
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--text);
  }
  .post-content h2 {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .post-content h3 {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--text);
  }
  .post-content p {
    margin-bottom: 1.5rem;
  }
  .post-content ul, .post-content ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .post-content li {
    margin-bottom: 0.5rem;
  }
  .post-content pre {
    padding: 1.25rem;
    border-radius: 8px;
    background: var(--bg-2);
    overflow-x: auto;
    margin: 2rem 0;
    border: 1px solid var(--border-faint);
  }
  .post-content code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--bg-2);
    padding: 0.2em 0.4em;
    border-radius: 4px;
  }
  .post-content pre code {
    background: transparent;
    padding: 0;
  }
  .post-content a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .post-content a:hover {
    color: var(--accent-hover);
  }
  .post-content blockquote {
    border-left: 4px solid #14b8a6; /* Teal border like the screenshot */
    margin: 2rem 0;
    font-style: italic;
    color: var(--text-2);
    background: #f8fafc;
    padding: 1.5rem 1.75rem;
    border-radius: 0 12px 12px 0;
    font-size: 1.125rem;
  }
  .post-content blockquote p {
    margin-bottom: 0;
  }
  .post-content blockquote a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  
  /* Tables */
  .post-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 2.5rem 0;
    font-size: 0.95rem;
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }
  .post-content th, .post-content td {
    padding: 1rem 1.25rem;
    text-align: left;
    border-bottom: 1px solid var(--border-faint);
  }
  .post-content th {
    background-color: var(--bg-2);
    font-weight: 700;
    color: var(--text);
    font-family: var(--font-heading);
  }
  .post-content tr:last-child td {
    border-bottom: none;
  }
  .post-content tr:hover td {
    background-color: #f8fafc;
  }
  
  .blog-article {
    max-width: 900px;
    width: 100%;
    min-width: 0;
    margin: 0 auto;
    overflow-wrap: break-word;
    word-break: break-word;
  }
  .post-content {
    width: 100%;
    min-width: 0;
  }
</style>
