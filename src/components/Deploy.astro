---
// Replaces the original design's pricing section. There is no commercial
// offering today — MeshWG is open source under MIT, single deployment
// model: self-hosted Go binary on a Linux VM. The five steps below are
// the exact ones in deploy/README.md in the project repo.
const steps = [
  { label: "Install deps", code: "apt install wireguard-tools iptables postgresql-16 caddy" },
  { label: "Build / fetch the controller binary", code: "go build ./cmd/quickmesh   # or download a release" },
  { label: "Set secrets in /etc/quickmesh.env", code: "ENCRYPTION_KEY, JWT_SECRET, ADMIN_PASSWORD" },
  { label: "Install the systemd unit + Caddyfile", code: "systemctl enable --now quickmesh caddy" },
  { label: "Verify with the e2e harness", code: "bash /root/e2e_run.sh   # 24 phases, ~3 min, exit 0" },
];

const repoUrl     = "https://github.com/vikasswaminh/meshwg";
const deployDocs  = "https://github.com/vikasswaminh/meshwg/tree/master/deploy";
---

<section id="deploy">
  <div class="wrap">
    <div class="sec-eyebrow">Deploy</div>
    <h2 class="sec-h">Open source. Self-hosted. No tiers.</h2>
    <p class="sec-lede">
      MeshWG is MIT licensed. The full source is on GitHub. A fresh Ubuntu
      22.04+ VM with 2 vCPU and 4 GiB RAM is enough for the controller.
      The whole install is a checklist you can read.
    </p>

    <div class="deploy-grid">
      <ol class="install">
        {steps.map((s, i) => (
          <li>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <div class="label">{s.label}</div>
              <code>{s.code}</code>
            </div>
          </li>
        ))}
      </ol>

      <aside class="aside">
        <h3>What you get</h3>
        <ul>
          <li>Full source (Go controller, HTML/CSS dashboard, e2e harness)</li>
          <li>5 schema migrations, applied on first startup</li>
          <li>Reproducible deploy artifacts under <code>deploy/</code></li>
          <li>OS + Postgres tuning configs</li>
          <li>GitHub Actions CI workflow</li>
        </ul>
        <div class="cta-row">
          <a class="btn btn-accent" href={repoUrl} target="_blank" rel="noopener">
            Get the source
          </a>
          <a class="btn" href={deployDocs} target="_blank" rel="noopener">
            Read deploy/README
          </a>
        </div>
        <p class="note">
          Commercial support and managed hosting are not offered today.
          If that matters to you, open an issue on the repo so we can
          gauge demand.
        </p>
      </aside>
    </div>
  </div>
</section>

<style>
  .deploy-grid {
    display: grid; grid-template-columns: 3fr 2fr;
    gap: 28px; margin-top: 48px; align-items: start;
  }

  .install {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 12px;
  }
  .install li {
    display: grid; grid-template-columns: 38px 1fr; gap: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 18px 20px;
    align-items: center;
  }
  .install .n {
    font: 600 13px var(--font-mono);
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: var(--radius-sm);
    padding: 4px 0;
    text-align: center;
  }
  .install .label {
    font-size: 14px; font-weight: 500; margin-bottom: 4px;
  }
  .install code {
    font: 12.5px var(--font-mono);
    color: var(--text-2);
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 4px 8px;
    display: inline-block;
  }

  .aside {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 26px;
  }
  .aside h3 { margin: 0 0 14px; font-size: 16px; font-weight: 600; }
  .aside ul {
    list-style: disc;
    padding-left: 18px;
    margin: 0 0 22px;
    color: var(--text-2);
    font-size: 13.5px;
    line-height: 1.7;
  }
  .aside ul code {
    font: 12px var(--font-mono);
    color: var(--text);
    background: var(--surface-2);
    padding: 1px 5px;
    border-radius: 4px;
  }
  .cta-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .note {
    margin: 18px 0 0;
    font-size: 12.5px; color: var(--text-3); line-height: 1.55;
  }

  @media (max-width: 980px) {
    .deploy-grid { grid-template-columns: 1fr; }
  }
</style>
