---
const steps = [
  {
    num: "01",
    title: "Sign up",
    body: "Create your account with Google or email. No credit card. You're in the dashboard in under a minute.",
  },
  {
    num: "02",
    title: "Add your devices",
    body: "Click Add machine, give it a name, and paste the WireGuard config we generate into your router or laptop. The tunnel comes up immediately.",
  },
  {
    num: "03",
    title: "Set who reaches what",
    body: "Allow or deny traffic between any two machines in one click — site-to-site, user-to-server, by app or by port. Changes apply in real time.",
  },
];
---

<section id="how">
  <div class="wrap">
    <div class="how-layout">

      <!-- LEFT: Steps -->
      <div class="how-steps-col">
        <div class="sec-eyebrow">/ how it works</div>
        <p class="how-tag">From unboxed to fully meshed in 2 minutes</p>
        <h2 class="how-h">How MeshWG works</h2>

        <div class="steps">
          {steps.map((s) => (
            <article class="step">
              <span class="step-num">{s.num}</span>
              <div class="step-content">
                <h3 class="step-title">{s.title}</h3>
                <p class="step-body">{s.body}</p>
              </div>
            </article>
          ))}
        </div>

        <a class="view-qs" href="/quickstart">View quickstart guide →</a>
      </div>

      <!-- RIGHT: Dashboard Preview -->
      <div class="dash-col" aria-hidden="true">
        <div class="dash-window">
          <!-- Sidebar -->
          <nav class="dash-sidebar">
            <span class="dash-nav active">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              Overview
            </span>
            <span class="dash-nav">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              Machines
            </span>
            <span class="dash-nav">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              Networks
            </span>
            <span class="dash-nav">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              Access
            </span>
            <span class="dash-nav">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
              Activity
            </span>
            <span class="dash-nav">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
              Settings
            </span>
          </nav>

          <!-- Main Panel -->
          <div class="dash-main">
            <div class="dash-topbar">
              <span class="dash-panel-title">Machines</span>
              <button class="dash-add-btn">Add Machine</button>
            </div>
            <table class="dash-table">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>IP Address</th>
                  <th>Network</th>
                  <th>Status</th>
                  <th>Last Seen</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Office Router</td>
                  <td class="mono">10.0.0.1</td>
                  <td>Office</td>
                  <td><span class="dot-ok"></span>Online</td>
                  <td>2m ago</td>
                </tr>
                <tr>
                  <td>Branch Office</td>
                  <td class="mono">10.0.0.2</td>
                  <td>Office</td>
                  <td><span class="dot-ok"></span>Online</td>
                  <td>5m ago</td>
                </tr>
                <tr>
                  <td>Remote User</td>
                  <td class="mono">10.0.0.3</td>
                  <td>Remote</td>
                  <td><span class="dot-ok"></span>Online</td>
                  <td>8m ago</td>
                </tr>
                <tr>
                  <td>NAS Server</td>
                  <td class="mono">10.0.0.4</td>
                  <td>Office</td>
                  <td><span class="dot-ok"></span>Online</td>
                  <td>10m ago</td>
                </tr>
                <tr>
                  <td>Home Lab</td>
                  <td class="mono">10.0.0.5</td>
                  <td>Lab</td>
                  <td><span class="dot-ok"></span>Online</td>
                  <td>12m ago</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Right mini panel -->
          <div class="dash-right">
            <div class="mini-widget">
              <div class="mini-title">Network Map</div>
              <svg class="net-map" viewBox="0 0 100 90">
                <line x1="50" y1="45" x2="20" y2="18" stroke="var(--border-strong)" stroke-width="1"/>
                <line x1="50" y1="45" x2="80" y2="18" stroke="var(--border-strong)" stroke-width="1"/>
                <line x1="50" y1="45" x2="20" y2="72" stroke="var(--border-strong)" stroke-width="1"/>
                <line x1="50" y1="45" x2="80" y2="72" stroke="var(--border-strong)" stroke-width="1"/>
                <circle cx="50" cy="45" r="9" fill="var(--accent)" opacity="0.15"/>
                <circle cx="50" cy="45" r="6" fill="var(--bg)" stroke="var(--accent)" stroke-width="1.5"/>
                <circle cx="20" cy="18" r="4" fill="var(--bg-2)" stroke="var(--border-strong)" stroke-width="1"/>
                <circle cx="80" cy="18" r="4" fill="var(--bg-2)" stroke="var(--border-strong)" stroke-width="1"/>
                <circle cx="20" cy="72" r="4" fill="var(--bg-2)" stroke="var(--border-strong)" stroke-width="1"/>
                <circle cx="80" cy="72" r="4" fill="var(--bg-2)" stroke="var(--border-strong)" stroke-width="1"/>
              </svg>
            </div>
            <div class="mini-widget">
              <div class="mini-title">Traffic (Today)</div>
              <div class="traffic-num">1.35 GB</div>
              <div class="traffic-sub">Total</div>
              <svg class="traffic-chart" viewBox="0 0 100 32" preserveAspectRatio="none">
                <polyline points="0,28 14,20 28,24 42,10 56,16 70,4 84,12 100,8" fill="none" stroke="var(--accent)" stroke-width="1.5"/>
              </svg>
              <a class="view-analytics" href="#">View analytics →</a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .how-layout {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: 40px;
    align-items: start;
  }

  .sec-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-3);
    margin-bottom: 8px;
  }

  .how-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 8px;
  }

  .how-h {
    font-family: var(--font-sans);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 24px;
    color: var(--text);
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-left: 2px solid var(--border);
  }

  .step {
    display: flex;
    gap: 16px;
    padding: 16px 0 16px 20px;
    border-bottom: 1px solid var(--border-faint);
  }
  .step:last-child { border-bottom: none; }

  .step-num {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    flex-shrink: 0;
    width: 24px;
  }

  .step-content {}

  .step-title {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    margin: 0 0 4px;
    color: var(--text);
  }

  .step-body {
    font-family: var(--font-sans);
    font-size: 13.5px;
    color: var(--text-3);
    line-height: 1.5;
    margin: 0;
  }

  .view-qs {
    display: inline-block;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .view-qs:hover { color: var(--accent-strong); }

  /* Dashboard */
  .dash-col { width: 100%; }

  .dash-window {
    width: 100%;
    display: grid;
    grid-template-columns: 110px 1fr 120px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    min-height: 320px;
  }

  .dash-sidebar {
    background: var(--bg-2);
    border-right: 1px solid var(--border);
    padding: 20px 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .dash-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    font-size: 11px;
    color: var(--text-4);
    cursor: pointer;
  }
  .dash-nav.active {
    background: var(--bg);
    color: var(--text);
    font-weight: 600;
    border-left: 2px solid var(--accent);
    padding-left: 12px;
  }
  .dash-nav svg { opacity: 0.5; }
  .dash-nav.active svg { color: var(--accent); opacity: 1; }

  .dash-main {
    padding: 20px;
    overflow: hidden;
  }

  .dash-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .dash-panel-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
  }

  .dash-add-btn {
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: var(--radius-sm);
    padding: 5px 10px;
    font-size: 10px;
    font-weight: 600;
    cursor: pointer;
  }

  .dash-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 10.5px;
  }
  .dash-table th {
    text-align: left;
    font-weight: 500;
    color: var(--text-4);
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
    padding-right: 12px;
  }
  .dash-table td {
    padding: 9px 12px 9px 0;
    color: var(--text-2);
    border-bottom: 1px solid var(--border-faint);
    white-space: nowrap;
  }
  .dash-table td.mono {
    font-family: var(--font-mono);
    font-size: 9.5px;
  }
  .dot-ok {
    display: inline-block;
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--ok);
    margin-right: 5px;
    vertical-align: middle;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 4px rgba(34, 197, 94, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
    }
  }

  .dash-right {
    background: var(--bg-2);
    border-left: 1px solid var(--border);
    padding: 16px 12px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .mini-widget {}
  .mini-title {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-3);
    margin-bottom: 10px;
  }

  .net-map {
    width: 100%;
    height: auto;
    display: block;
  }

  .traffic-num {
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    line-height: 1;
  }
  .traffic-sub {
    font-size: 9px;
    color: var(--text-4);
    margin: 2px 0 8px;
  }
  .traffic-chart {
    width: 100%;
    height: 32px;
    display: block;
    margin-bottom: 6px;
  }
  .view-analytics {
    font-size: 9.5px;
    color: var(--accent);
    text-decoration: none;
  }

  @media (max-width: 980px) {
    .how-layout { grid-template-columns: 1fr; gap: 40px; }
    .dash-window { grid-template-columns: 1fr; }
    .dash-sidebar, .dash-right { display: none; }
  }
</style>
