---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<header class="page-hero">
  <div class="wrap">
    <div class="ph-eyebrow">{eyebrow}</div>
    <h1 class="ph-h">{title}</h1>
    {lede && <p class="ph-lede">{lede}</p>}
  </div>
</header>

<style>
  /* Subpage hero — editorial serif headline + mono eyebrow.
     Sits behind the fixed nav (which is 64 px tall) so the top
     padding accounts for both the nav and the additional breathing
     room below it. */
  .page-hero {
    padding: 152px 0 64px;
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }
  /* soft acid glow top-right matches the homepage hero atmosphere */
  .page-hero::before {
    content: "";
    position: absolute;
    top: -120px; right: -180px;
    width: 600px; height: 600px;
    background: radial-gradient(circle, var(--accent-soft) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }
  .page-hero .wrap { position: relative; z-index: 1; }

  .ph-eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-3);
    margin-bottom: 24px;
  }

  .ph-h {
    font-family: var(--font-serif);
    font-size: clamp(20px, 2.8vw, 38px);
    line-height: 1;
    letter-spacing: -0.02em;
    font-weight: 400;
    margin: 0 0 24px;
    max-width: 880px;
    text-wrap: balance;
    color: var(--text);
  }

  .ph-lede {
    color: var(--text-2);
    font-size: 17px;
    max-width: 680px;
    line-height: 1.6;
    margin: 0;
    text-wrap: pretty;
    font-weight: 300;
  }
  .ph-lede b { color: var(--text); font-weight: 500; }

  @media (max-width: 980px) {
    .page-hero { padding: 110px 0 40px; }
    .ph-h { font-size: 18px; }
  }
</style>
