---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  wrapLede?: boolean;
  wrapTitle?: boolean;
}

const { eyebrow, title, lede, wrapLede = false, wrapTitle = false } = Astro.props;
---

<header class="page-hero">
  <div class="wrap">
    <div class="ph-grid">
      <div class="ph-left">
        <div class="ph-eyebrow" data-reveal>{eyebrow}</div>
        <h1 class:list={["ph-h", { "ph-h--wrap": wrapTitle }]} data-reveal data-reveal-delay="100">{title}</h1>
      </div>
      <div class="ph-right" data-reveal data-reveal-delay="200">
        {lede && <p class:list={["ph-lede", { "ph-lede--wrap": wrapLede }]} set:html={lede} />}
      </div>
    </div>
  </div>
</header>

<style>
  /* Subpage hero — editorial serif headline + mono eyebrow.
     Sits behind the fixed nav (which is 64 px tall) so the top
     padding accounts for both the nav and the additional breathing
     room below it. */
  .page-hero {
    padding: 152px 0 32px;
    border-bottom: 1px solid var(--border);
    position: relative;
  }
  @keyframes gradientMesh {
    0% { transform: scale(1) translate(0, 0); opacity: 0.8; }
    33% { transform: scale(1.1) translate(40px, -20px); opacity: 1; }
    66% { transform: scale(0.9) translate(-30px, 40px); opacity: 0.9; }
    100% { transform: scale(1) translate(0, 0); opacity: 0.8; }
  }

  .page-hero::before {
    content: "";
    position: absolute;
    top: -120px; right: -180px;
    width: 600px; height: 600px;
    background: radial-gradient(circle at center, var(--accent-glow) 0%, transparent 60%),
                radial-gradient(circle at 80% 20%, rgba(22, 119, 255, 0.1) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
    filter: blur(40px);
    animation: gradientMesh 15s ease-in-out infinite;
  }
  .page-hero .wrap { position: relative; z-index: 1; }

  .ph-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: start;
  }

  .ph-eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-3);
    margin-bottom: 8px;
  }

  .ph-h {
    font-family: var(--font-serif);
    font-size: clamp(20px, 2.8vw, 38px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 400;
    margin: 0;
    white-space: nowrap;
    color: var(--text);
  }
  .ph-h--wrap {
    white-space: normal;
  }

  .ph-lede {
    color: var(--text-2);
    font-size: 17px;
    line-height: 1.6;
    margin: 0;
    white-space: nowrap;
    font-weight: 300;
  }
  .ph-lede b { color: var(--text); font-weight: 500; }
  .ph-lede--wrap {
    white-space: normal;
    max-width: 100%;
  }

  @media (max-width: 980px) {
    .page-hero { padding: 110px 0 40px; }
    .ph-grid { grid-template-columns: 1fr; gap: 24px; }
    .ph-h { font-size: 18px; }
  }
</style>
