---
import Base       from "../layouts/Base.astro";
import Nav        from "../components/Nav.astro";
import PageHero   from "../components/PageHero.astro";
import Footer     from "../components/Footer.astro";
import { site } from "../site";

// Real prices. Free tier deducts 2 machines. Amounts in ₹ (rupees).
const FREE_MACHINES = 2;
const ANNUAL_PER_MACHINE = 349;   // ₹/machine/month when billed annually
const MONTHLY_PER_MACHINE = 499;  // ₹/machine/month when billed monthly

const pricingFaqs = [
  {
    q: "What counts as a machine?",
    short: "A machine is any device in your mesh, from laptops to servers.",
    a: "Anything in your mesh — a router, a laptop, a phone, a server, a VPS. Each peer in your WireGuard mesh counts as one machine.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`
  },
  {
    q: "Can I switch between monthly and annual?",
    short: "Yes, you can switch plans anytime.",
    a: "Yes, anytime in the dashboard. If you switch from monthly to annual mid-cycle, we credit the unused portion of the month against the annual price.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>`
  },
  {
    q: "What if I cancel mid-year on the annual plan?",
    short: "You'll continue to have access until the end of your billing period.",
    a: "Your mesh keeps running at the paid tier until the year ends. No partial refunds on annual. After the year, anything above the free 2 machines goes read-only until you re-subscribe or remove them.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`
  },
  {
    q: "Are there volume discounts?",
    short: "Yes, contact us for custom pricing for larger teams.",
    a: "Standard ₹349/machine/month annual up to 100 machines. Past 100, talk to us about Pro — we tune pricing for big fleets and offer dedicated infrastructure.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`
  },
  {
    q: "What payment methods do you accept?",
    short: "We accept major credit cards and other secure payment methods.",
    a: "Card, UPI, and net-banking via Razorpay on the Cloud tier. Bank transfer is available for annual Pro contracts. GST invoice provided automatically.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>`
  },
  {
    q: "Do free machines stack with paid ones?",
    short: "Yes, your 2 free machines stay free even when you add more.",
    a: "Yes — the first 2 machines in any paid account are always free. You only pay for machines 3 and up.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 12 12 17 22 12"/><polyline points="2 17 12 22 22 17"/></svg>`
  },
];

const title = "Pricing — MeshWG";
const description = "₹349 per machine per month, billed annually. Or ₹499 per machine per month, billed monthly. Two machines free, forever. No card to start.";
---

<Base title={title} description={description}>
  <Nav />
  <div class="pricing-hero">
    <div class="ph-bg"></div>
    <div class="wrap">
      <div class="ph-eyebrow">/ PRICING</div>
      <h1 class="ph-h1">Pay for what you <span class="text-blue">mesh.</span></h1>
      <p class="ph-lede">A machine is anything in your mesh. Two free forever. After that, ₹349 per machine per month on annual billing — or ₹499 if you'd rather pay monthly.</p>

      <!-- Controls Row: Toggle + Trust Icons -->
      <div class="pricing-controls">
        <div class="toggle-wrap" role="tablist" aria-label="Billing cycle">
          <button class="toggle-btn is-active" data-cycle="annual" type="button">
            Annual billing
            <span class="save-tag">SAVE 30%</span>
          </button>
          <button class="toggle-btn" data-cycle="monthly" type="button">
            Monthly billing
          </button>
        </div>
        
        <div class="trust-row">
          <span class="trust-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            No credit card to start
          </span>
          <span class="trust-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            Cancel anytime
          </span>
        </div>
      </div>
    </div>
  </div>

  <section class="price-section">
    <div class="wrap">

      <!-- Plans -->
      <div class="plans">
        <article class="plan hover-card">
          <div class="plan-head">
            <div class="plan-name">FREE</div>
          </div>
          <div class="plan-price">
            <span class="num">₹0</span>
            <span class="unit">forever</span>
          </div>
          <p class="plan-desc">Start meshing today. Free for as long as you stay small.</p>
          <ul class="plan-list">
            <li>2 machines</li>
            <li>Hosted by us — nothing to install</li>
            <li>Google or email sign-in</li>
            <li>All access-control features</li>
          </ul>
          <div class="plan-bot">
            <a class="btn btn-line plan-cta" href={site.signupFree} target="_blank" rel="noopener">Sign up free</a>
          </div>
        </article>

        <article class="plan plan-accent hover-card">
          <div class="plan-head">
            <div class="plan-badge">MOST POPULAR</div>
            <div class="plan-name">CLOUD</div>
          </div>
          <div class="plan-price">
            <span class="num" data-cloud-price>₹349</span>
            <span class="unit" data-cloud-unit>per machine / month<br>(billed annually)</span>
          </div>
          <p class="plan-desc">Same hosted product as Free. No machine limit.</p>
          <ul class="plan-list">
            <li>Unlimited machines</li>
            <li>Audit log</li>
            <li>Email support</li>
            <li>Cancel anytime</li>
          </ul>
          <div class="plan-bot">
            <a class="btn btn-primary plan-cta" href={site.signupFree} target="_blank" rel="noopener">Sign up free</a>
          </div>
        </article>

        <article class="plan hover-card">
          <div class="plan-head">
            <div class="plan-name">PRO</div>
          </div>
          <div class="plan-price">
            <span class="num">Custom</span>
            <span class="unit">talk to us</span>
          </div>
          <p class="plan-desc">Bigger fleets, dedicated infrastructure, custom needs.</p>
          <ul class="plan-list">
            <li>Dedicated infrastructure</li>
            <li>Custom domain (acme.meshwg.com)</li>
            <li>Priority support</li>
            <li>SLA on request</li>
          </ul>
          <div class="plan-bot">
            <a class="btn btn-line plan-cta" href={site.proContact}>Talk to us</a>
          </div>
        </article>
      </div>

      <div class="info-bar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
        <p><strong>No credit card to start.</strong> Two machines stay free as long as you want — add a third only when you're ready to grow.</p>
      </div>

      <!-- Calculator -->
      <div class="calc-section">
        <header class="calc-head">
          <div class="calc-head-left">
            <div class="calc-eyebrow">/ CALCULATOR</div>
            <h2>How much for your <span class="text-blue">mesh</span>?</h2>
            <p>Drag the slider. The number's exact.</p>
          </div>
          <div class="calc-head-right">
            <div class="calc-feature">
              <strong>Simple transparent pricing</strong>
              <span>Pay only for what you use.</span>
            </div>
            <div class="calc-feature">
              <strong>Scale at your pace</strong>
              <span>Start small, grow anytime.</span>
            </div>
            <div class="calc-feature">
              <strong>Built for modern networks</strong>
              <span>Flexible, predictable costs.</span>
            </div>
          </div>
        </header>

        <div class="calc">
          <div class="calc-inner-head">
            <div class="calc-inner-head-left">
              <div class="calc-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
                  <line x1="8" y1="6" x2="16" y2="6"></line>
                  <line x1="16" y1="14" x2="16" y2="14.01"></line>
                  <line x1="12" y1="14" x2="12" y2="14.01"></line>
                  <line x1="8" y1="14" x2="8" y2="14.01"></line>
                  <line x1="16" y1="18" x2="16" y2="18.01"></line>
                  <line x1="12" y1="18" x2="12" y2="18.01"></line>
                  <line x1="8" y1="18" x2="8" y2="18.01"></line>
                  <line x1="16" y1="10" x2="16" y2="10.01"></line>
                  <line x1="12" y1="10" x2="12" y2="10.01"></line>
                  <line x1="8" y1="10" x2="8" y2="10.01"></line>
                </svg>
              </div>
              <div class="calc-inner-text">
                <div class="calc-inner-title">MACHINES IN YOUR MESH</div>
                <div class="calc-inner-subtitle">Select how many machines you need.</div>
              </div>
            </div>
            <div class="calc-inner-head-right">
              <div class="calc-machines-box">
                <output id="machines-count" class="cm-num" data-count>10</output>
                <div class="cm-label">machines</div>
              </div>
            </div>
          </div>

          <div class="calc-body">
            <div class="slider-wrapper">
              <span class="slider-min">0</span>
              <input id="machines" type="range" min="0" max="100" value="10" step="1" data-slider />
              <span class="slider-max">100</span>
            </div>

            <div class="calc-result">
              <div class="result-card rc-annual" data-cycle-card="annual">
                <div class="rc-top-row">
                  <div class="rc-eyebrow">ANNUAL BILLING</div>
                  <div class="rc-badge"><span class="rc-badge-dot"></span>Best value</div>
                </div>
                <div class="rc-num"><span data-annual-monthly>₹2,792</span><span class="rc-unit"> / month</span></div>
                <div class="rc-sub">₹<span data-annual-total>33,504</span> billed yearly · <span data-paid-machines>8</span> paid + 2 free</div>
              </div>

              <div class="result-card rc-monthly">
                <div class="rc-top-row">
                  <div class="rc-eyebrow">MONTHLY BILLING</div>
                </div>
                <div class="rc-num"><span data-monthly-monthly>₹3,992</span><span class="rc-unit"> / month</span></div>
                <div class="rc-sub">No annual commitment · cancel anytime</div>
              </div>
            </div>

            <p class="calc-foot">
              <span data-foot-paid hidden>
                Annual saves you <strong data-savings-amount>₹14,400</strong>/year at this size.
              </span>
              <span data-foot-free>
                All your machines are free at this size.
              </span>
            </p>
          </div>
        </div>
      </div>

      <!-- FAQ -->
      <div class="pfaq-section">
        <div class="pfaq-bg"></div>
        <div class="pfaq">
          <header class="pfaq-head">
            <div class="pfaq-head-left">
              <div class="db-eyebrow">/ BILLING FAQ</div>
              <h2>Billing questions, <span class="text-blue">answered.</span></h2>
              <p>Clear answers to help you choose the right plan and manage your billing with confidence.</p>
            </div>
            <div class="pfaq-head-right">
              <div class="contact-card">
                <div class="cc-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><circle cx="12" cy="17" r="0.5" fill="currentColor"/></svg>
                </div>
                <div class="cc-text">
                  <strong>Still have questions?</strong>
                  <span>We're here to help.</span>
                </div>
                <a class="cc-btn" href="/contact">Contact us &rarr;</a>
              </div>
            </div>
          </header>
          <div class="pfaq-grid">
            <div class="pfaq-col">
              {pricingFaqs.slice(0, 3).map((f) => (
                <details class="faq-card">
                  <summary class="faq-summary">
                    <div class="faq-icon-wrap" set:html={f.icon}></div>
                    <div class="faq-content">
                      <div class="faq-q">{f.q}</div>
                      <div class="faq-short">{f.short}</div>
                    </div>
                    <div class="faq-toggle">
                      <span class="faq-plus">+</span>
                    </div>
                  </summary>
                  <div class="faq-a"><p>{f.a}</p></div>
                </details>
              ))}
            </div>
            <div class="pfaq-col">
              {pricingFaqs.slice(3).map((f) => (
                <details class="faq-card">
                  <summary class="faq-summary">
                    <div class="faq-icon-wrap" set:html={f.icon}></div>
                    <div class="faq-content">
                      <div class="faq-q">{f.q}</div>
                      <div class="faq-short">{f.short}</div>
                    </div>
                    <div class="faq-toggle">
                      <span class="faq-plus">+</span>
                    </div>
                  </summary>
                  <div class="faq-a"><p>{f.a}</p></div>
                </details>
              ))}
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": pricingFaqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a },
    })),
  })}></script>

  <Footer />
</Base>

<script define:vars={{ FREE_MACHINES, ANNUAL_PER_MACHINE, MONTHLY_PER_MACHINE }}>
  // ── Billing-cycle toggle on the plan cards ─────────────────────────
  const btns = document.querySelectorAll("[data-cycle]");
  const cloudPriceEl = document.querySelector("[data-cloud-price]");
  const cloudUnitEl  = document.querySelector("[data-cloud-unit]");

  btns.forEach((b) => {
    b.addEventListener("click", () => {
      btns.forEach((x) => x.classList.remove("is-active"));
      b.classList.add("is-active");
      const cycle = b.getAttribute("data-cycle");
      if (cycle === "annual") {
        cloudPriceEl.textContent = "₹349";
        cloudUnitEl.innerHTML  = "per machine / month<br>(billed annually)";
      } else {
        cloudPriceEl.textContent = "₹499";
        cloudUnitEl.innerHTML  = "per machine / month<br>(billed monthly)";
      }
    });
  });

  // ── Exclusive FAQ Accordion ────────────────────────────────────────
  const faqDetails = document.querySelectorAll(".pfaq-grid details");
  faqDetails.forEach((targetDetail) => {
    targetDetail.addEventListener("click", () => {
      if (!targetDetail.open) {
        faqDetails.forEach((detail) => {
          if (detail !== targetDetail) {
            detail.removeAttribute("open");
          }
        });
      }
    });
  });

  // ── Calculator ─────────────────────────────────────────────────────
  // All updates use textContent — no innerHTML. The two foot messages
  // live as separate elements; we toggle visibility instead of swapping
  // markup at runtime.
  const slider             = document.querySelector("[data-slider]");
  const countEl            = document.querySelector("[data-count]");
  const annualMonthlyEl    = document.querySelector("[data-annual-monthly]");
  const annualTotalEl      = document.querySelector("[data-annual-total]");
  const monthlyMonthlyEl   = document.querySelector("[data-monthly-monthly]");
  const paidMachinesEl     = document.querySelector("[data-paid-machines]");
  const savingsAmountEl    = document.querySelector("[data-savings-amount]");
  const footPaidEl         = document.querySelector("[data-foot-paid]");
  const footFreeEl         = document.querySelector("[data-foot-free]");

  function update() {
    const n = parseInt(slider.value, 10);
    const paid = Math.max(0, n - FREE_MACHINES);
    const annualMonthly  = paid * ANNUAL_PER_MACHINE;
    const monthlyMonthly = paid * MONTHLY_PER_MACHINE;
    const annualSavings  = (monthlyMonthly - annualMonthly) * 12;

    // Dual-tone slider track update
    const percent = (n / 100) * 100;
    slider.style.background = `linear-gradient(to right, #DBEAFE ${percent}%, #E2E8F0 ${percent}%)`;

    // Indian number formatting — 1,00,000 style commas, ₹ prefix.
    const fmt = (v) => "₹" + v.toLocaleString("en-IN");

    countEl.textContent          = String(n);
    annualMonthlyEl.textContent  = fmt(annualMonthly);
    annualTotalEl.textContent    = (annualMonthly * 12).toLocaleString("en-IN");
    monthlyMonthlyEl.textContent = fmt(monthlyMonthly);
    paidMachinesEl.textContent   = String(paid);
    savingsAmountEl.textContent  = fmt(annualSavings);

    if (paid === 0) {
      footPaidEl.hidden = true;
      footFreeEl.hidden = false;
    } else {
      footPaidEl.hidden = false;
      footFreeEl.hidden = true;
    }
  }

  slider.addEventListener("input", update);
  update();
</script>

<style>
  .pricing-hero {
    position: relative;
    padding: 104px 0 0px; /* Compress top spacing but clear navbar */
    background: #ffffff;
    overflow: hidden;
  }
  .ph-bg {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
    z-index: 0;
    /* Premium subtle grid pattern top right */
    background-image: radial-gradient(#CBD5E1 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: calc(100% - 24px) 24px;
    background-repeat: no-repeat;
  }
  .ph-bg::before {
    content: "";
    position: absolute;
    top: -300px; right: -200px;
    width: 1000px; height: 1000px;
    background: radial-gradient(50% 50% at 50% 50%, rgba(37, 99, 235, 0.08) 0%, rgba(37, 99, 235, 0) 100%);
    border-radius: 50%;
    z-index: -1;
  }
  .ph-bg::after {
    content: "";
    position: absolute;
    top: -100px; left: -100px;
    width: 800px; height: 800px;
    background: radial-gradient(50% 50% at 50% 50%, rgba(37, 99, 235, 0.04) 0%, rgba(37, 99, 235, 0) 100%);
    border-radius: 50%;
    z-index: -1;
  }
  .pricing-hero .wrap {
    position: relative;
    z-index: 1;
  }
  .ph-eyebrow {
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #2563EB;
    margin-bottom: 20px;
  }
  .ph-h1 {
    font-family: var(--font-display, sans-serif);
    font-size: clamp(40px, 5vw, 56px);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #0F172A;
    margin: 0 0 12px;
    line-height: 1.1;
  }
  .ph-h1 .text-blue {
    color: #2563EB;
  }
  .ph-lede {
    font-size: 19px;
    color: #475569;
    line-height: 1.6;
    margin: 0 0 24px;
  }

  .price-section {
    padding: 16px 0 0;
    position: relative;
    z-index: 10;
  }

  /* ── Controls Row: Toggle + Trust ─────────────────────── */
  .pricing-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px;
    margin-bottom: 24px;
  }
  .toggle-wrap {
    display: inline-flex;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 999px;
    padding: 6px;
    box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
  }
  .toggle-btn {
    appearance: none;
    background: transparent;
    border: 0;
    padding: 10px 24px;
    border-radius: 999px;
    font: 600 14px var(--font-sans, system-ui);
    color: #64748B;
    cursor: pointer;
    display: inline-flex; align-items: center; gap: 8px;
    transition: all .2s ease;
  }
  .toggle-btn.is-active {
    background: #0A2540;
    color: #fff;
    box-shadow: 0 4px 12px rgba(10, 37, 64, 0.15);
  }
  .toggle-btn:focus-visible {
    outline: 2px solid #2563EB;
    outline-offset: 2px;
  }
  .save-tag {
    font-family: var(--font-sans, system-ui);
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(37, 99, 235, 0.1);
    color: #2563EB;
    text-transform: uppercase;
    letter-spacing: .02em;
    font-weight: 700;
  }
  .toggle-btn.is-active .save-tag {
    background: #ffffff;
    color: #2563EB;
  }
  .trust-row {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: #475569;
    font-weight: 500;
  }

  /* ── Plans ───────────────────────────────────────────── */
  .plans {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-bottom: 16px;
  }
  .plan {
    background: #ffffff;
    border: 2px solid #0F172A;
    border-radius: 12px;
    padding: 24px;
    display: flex; flex-direction: column;
    box-shadow: 6px 6px 0px #0F172A;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
    height: 100%;
    position: relative;
  }
